{% comment %}
  Lux Footer
  - كل النصوص من الـ Theme Editor.
  - صورة البراند من image picker.
  - كل منيو (Catalog / About / Customers / Legal) بتتختار من Navigation بتاع شوبيفاي.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .lux-col-brand,
  #shopify-section-{{ section.id }} .lux-col-nav {
    padding-top: 0px !important;
  }
{% endstyle %}

<footer
  class="lux-footer"
  style="
    --lf-bg: {{ section.settings.footer_bg }};
    --lf-accent: {{ section.settings.accent_color }};
    --lf-btn: {{ section.settings.button_bg }};
    --lf-btn-hover: {{ section.settings.button_hover_bg }};
    --lf-banner-start: {{ section.settings.banner_bg_start }};
    --lf-banner-end: {{ section.settings.banner_bg_end }};
    --lf-max: {{ section.settings.max_width }}px;
    --lf-logo-w: {{ section.settings.logo_width }}px;
  "
>

  {%- if section.settings.show_banner -%}
  <div class="lux-banner">
    {%- if section.settings.show_petals -%}
      <canvas class="lux-petals-canvas" data-lux-petals></canvas>
    {%- endif -%}

    <div class="lux-banner-left">
      {%- if section.settings.banner_title != blank -%}
        <p class="lux-banner-title">{{ section.settings.banner_title }}</p>
      {%- endif -%}
      {%- if section.settings.banner_subtitle != blank -%}
        <p class="lux-banner-subtitle">{{ section.settings.banner_subtitle }}</p>
      {%- endif -%}

      {%- assign form_id = 'LuxNewsletterForm-' | append: section.id -%}
      {%- form 'customer', id: form_id, class: 'lux-newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.newsletter_tags | escape }}">
        <input type="hidden" name="contact[accepts_marketing]" value="true">

        <div class="lux-banner-form">
          <input
            type="email"
            name="contact[email]"
            id="LuxNewsletterEmail-{{ section.id }}"
            placeholder="{{ section.settings.banner_placeholder | escape }}"
            aria-label="{{ section.settings.banner_placeholder | escape }}"
            autocomplete="email"
            required>

          <button type="submit">{{ section.settings.banner_btn }}</button>
        </div>

        {%- if section.settings.show_consent -%}
          <label class="lux-banner-consent">
            <input type="checkbox" required>
            <span>
              {{ section.settings.banner_consent }}
              {%- if section.settings.banner_policy_url != blank -%}
                <a href="{{ section.settings.banner_policy_url }}">{{ section.settings.banner_policy_text }}</a>
              {%- endif -%}
            </span>
          </label>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <p class="lux-success-msg">✓ {{ section.settings.success_message }}</p>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="lux-error-msg">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="lux-banner-right">
      {%- if section.settings.banner_badge != blank -%}
      <div class="lux-promo-badge">
        <span>{{ section.settings.banner_badge }}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </div>
      {%- endif -%}
      {%- if section.settings.banner_image != blank -%}
      <div class="lux-banner-img">
        {{ section.settings.banner_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: section.settings.banner_image.alt }}
      </div>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}

  <div class="lux-footer-grid">

    <div class="lux-col-brand">
      <a href="{{ routes.root_url }}" class="lux-logo-wrap">
        {%- if section.settings.footer_logo != blank -%}
          {%- assign logo_alt = section.settings.logo_alt | default: shop.name -%}
          {{ section.settings.footer_logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: logo_alt, class: 'lux-logo' }}
        {%- else -%}
          <span class="lux-logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      {%- if section.settings.footer_phone != blank -%}
      <div class="lux-contact-item">
        <a href="tel:{{ section.settings.footer_phone | remove: ' ' }}" class="lux-phone">{{ section.settings.footer_phone }}</a>
        {%- if section.settings.footer_phone_label != blank -%}
          <span class="lux-label">{{ section.settings.footer_phone_label }}</span>
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- if section.settings.footer_email != blank -%}
      <div class="lux-contact-item">
        <a href="mailto:{{ section.settings.footer_email }}" class="lux-email">{{ section.settings.footer_email }}</a>
        {%- if section.settings.footer_email_label != blank -%}
          <span class="lux-label">{{ section.settings.footer_email_label }}</span>
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- if section.settings.footer_office_address != blank -%}
      <div class="lux-contact-item lux-address-item">
        {%- if section.settings.footer_office_label != blank -%}
          <div class="lux-address-title">{{ section.settings.footer_office_label }}</div>
        {%- endif -%}
        <div class="lux-address-text">{{ section.settings.footer_office_address | newline_to_br }}</div>
      </div>
      {%- endif -%}
    </div>

    {%- for i in (1..3) -%}
      {%- liquid
        assign menu_key = 'col' | append: i | append: '_menu'
        assign title_key = 'col' | append: i | append: '_title'
        assign menu = section.settings[menu_key]
        assign col_title = section.settings[title_key]
        case i
          when 1
            assign col_class = 'lux-col-catalog'
          when 2
            assign col_class = 'lux-col-about'
          else
            assign col_class = 'lux-col-customers'
        endcase
      -%}
      {%- if menu != blank and menu.links.size > 0 -%}
      <div class="lux-col-nav {{ col_class }}">
        {%- assign heading = col_title | default: menu.title -%}
        {%- if heading != blank -%}
          <span class="lux-nav-heading">{{ heading }}</span>
        {%- endif -%}
        <ul>
          {%- for link in menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
      {%- endif -%}
    {%- endfor -%}

    <div class="lux-col-social-legal">
      <div class="lux-socials">
        {%- if section.settings.social_instagram != blank -%}
        <a href="{{ section.settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_tiktok != blank -%}
        <a href="{{ section.settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_facebook != blank -%}
        <a href="{{ section.settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_youtube != blank -%}
        <a href="{{ section.settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_snapchat != blank -%}
        <a href="{{ section.settings.social_snapchat }}" aria-label="Snapchat" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M12.206.793c.99 0 4.347.276 5.93 3.821.529 1.193.403 3.219.299 4.847l-.003.06c-.012.18-.022.345-.03.51.075.045.203.09.401.09.3-.016.659-.120 1.033-.301.165-.088.344-.104.464-.104.182 0 .359.029.509.09.45.149.734.479.734.838.015.449-.39.839-1.213 1.168-.089.029-.209.075-.344.119-.45.135-1.139.36-1.333.81-.09.224-.061.524.120.868l.015.015c.060.136 1.526 3.475 4.791 4.014.255.044.435.270.420.509 0 .075-.015.149-.045.225-.240.569-1.273.988-3.146 1.271-.059.091-.120.375-.164.570-.029.179-.074.360-.134.553-.076.271-.270.405-.555.405h-.030c-.135 0-.313-.031-.538-.074-.360-.075-.765-.135-1.273-.135-.300 0-.599.015-.913.074-.600.104-1.123.464-1.723.884-.853.599-1.826 1.288-3.294 1.288-.060 0-.119-.015-.180-.015h-.149c-1.468 0-2.427-.675-3.279-1.288-.599-.420-1.107-.779-1.707-.884-.314-.045-.629-.074-.928-.074-.540 0-.958.089-1.272.149-.211.043-.391.074-.540.074-.374 0-.523-.224-.583-.420-.061-.192-.090-.389-.135-.567-.046-.181-.105-.494-.166-.570-1.918-.222-2.950-.642-3.189-1.226-.031-.063-.052-.150-.055-.225-.015-.243.165-.465.420-.509 3.264-.540 4.730-3.879 4.791-4.020l.016-.029c.180-.345.224-.645.119-.869-.195-.434-.884-.658-1.332-.809-.121-.029-.240-.074-.346-.119-1.107-.435-1.257-.930-1.197-1.273.090-.479.674-.793 1.168-.793.146 0 .270.029.383.074.420.194.789.300 1.104.300.234 0 .384-.060.465-.105l-.046-.569c-.098-1.626-.229-3.652.307-4.837C7.392 1.077 10.739.807 11.727.807l.419-.015h.060z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_whatsapp != blank -%}
        <a href="https://wa.me/{{ section.settings.social_whatsapp | remove: '+' | remove: ' ' }}" aria-label="WhatsApp" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.014 0C5.377 0 0 5.377 0 12.014c0 2.121.554 4.187 1.606 6.011L0 24l6.14-1.611a11.983 11.983 0 0 0 5.874 1.499h.005c6.637 0 12.014-5.377 12.014-12.014C24.033 5.377 18.656 0 12.014 0zm0 21.93a9.884 9.884 0 0 1-5.043-1.383l-.362-.215-3.746.983.999-3.653-.236-.375a9.888 9.888 0 0 1-1.513-5.273c0-5.469 4.451-9.92 9.921-9.92 2.65 0 5.14 1.033 7.014 2.908a9.85 9.85 0 0 1 2.906 7.017c0 5.469-4.451 9.911-9.94 9.911z"/></svg>
        </a>
        {%- endif -%}
      </div>

      <div class="lux-legal">
        {%- if section.settings.legal_menu != blank -%}
          {%- for link in section.settings.legal_menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- if shop.terms_of_service != blank -%}
            <a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>
          {%- endif -%}
          {%- if shop.privacy_policy != blank -%}
            <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>

  </div>

  <div class="lux-footer-bottom">
    <p>© {{ 'now' | date: "%Y" }} {{ shop.name }}.{% if section.settings.copyright != blank %} {{ section.settings.copyright }}{% endif %}</p>
    {%- if section.settings.show_payments -%}
    <div class="lux-footer-payments">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>

</footer>

{% stylesheet %}
.lux-banner {
  position: relative;
  background: linear-gradient(135deg, var(--lf-banner-start, #fdf9f4) 0%, var(--lf-banner-end, #f0ebe0) 100%);
  border-radius: 12px;
  padding: 40px 50px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 35px;
  overflow: hidden;
  max-width: var(--lf-max, 1600px);
  margin-left: auto;
  margin-right: auto;
  width: 100%;
}
.lux-petals-canvas {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  border-radius: 12px;
}
.lux-banner-left { position: relative; z-index: 1; flex: 1; max-width: 500px; }
.lux-banner-left .lux-banner-title {
  font-size: clamp(30px, 4vw, 46px);
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.2;
  margin: 0 0 10px;
}
.lux-banner-left .lux-banner-subtitle { font-size: 14px; color: #444; margin: 0 0 20px; }
.lux-newsletter-form * { box-sizing: border-box; }
.lux-banner-form { display: flex; align-items: stretch; max-width: 440px; }
.lux-banner-form input[type="email"] {
  flex: 1;
  height: 56px;
  min-height: 56px;
  padding: 0 22px;
  margin: 0;
  line-height: 56px;
  border: 1px solid var(--lf-accent, #f5e6c8);
  border-right: none;
  border-radius: 6px 0 0 6px;
  font-size: 16px;
  background: #fff;
  outline: none;
  color: #333;
  appearance: none;
  -webkit-appearance: none;
}
.lux-banner-form input[type="email"]::placeholder { color: #aaa; line-height: 56px; }
.lux-banner-form button {
  height: 56px;
  min-height: 56px;
  padding: 0 30px;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--lf-btn, #7c3030);
  color: #fff;
  border: none;
  border-radius: 0 6px 6px 0;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}
.lux-banner-form button:hover { background: var(--lf-btn-hover, #933939); }

/* RTL Newsletter Fix */
html[dir="rtl"] .lux-banner-form { direction: rtl; }
html[dir="rtl"] .lux-banner-form input[type="email"] {
  border-right: 1px solid var(--lf-accent, #f5e6c8);
  border-left: none;
  border-radius: 0 6px 6px 0;
}
html[dir="rtl"] .lux-banner-form button { border-radius: 6px 0 0 6px; }

.lux-success-msg { color: #4caf50; font-size: 13px; margin-top: 10px; font-weight: 600; }
.lux-error-msg { color: #e53935; font-size: 13px; margin-top: 10px; }
.lux-banner-consent {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 10px;
  font-size: 12px;
  color: #666;
}
.lux-banner-consent input { margin-top: 2px; flex-shrink: 0; }
.lux-banner-consent a { color: #666; text-decoration: underline; }
.lux-banner-right {
  position: relative; z-index: 1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 20px;
}
.lux-promo-badge {
  background: rgba(255,255,255,0.85);
  border: 1.5px solid #d9d0c4;
  border-radius: 50px;
  padding: 14px 24px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  font-weight: 700;
  color: #222;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  white-space: nowrap;
}
.lux-promo-badge svg { width: 18px; height: 18px; }
.lux-banner-img { width: 110px; }
.lux-banner-img img { width: 100%; height: auto; border-radius: 14px; }

.lux-footer {
  background-color: var(--lf-bg, #1a1a1a);
  color: #fff;
  padding: 20px 40px 20px;
  font-family: inherit;
  width: 100%;
}

.lux-footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  grid-template-rows: max-content auto;
  grid-template-areas:
    "brand catalog about customers"
    "social catalog about customers";
  gap: 5px 40px;
  align-items: start;
  max-width: var(--lf-max, 1600px);
  margin-left: auto;
  margin-right: auto;
  width: 100%;
}

.lux-col-brand { grid-area: brand; display: flex; flex-direction: column; align-items: flex-start; }
.lux-col-catalog { grid-area: catalog; display: flex; flex-direction: column; align-items: flex-start; }
.lux-col-about { grid-area: about; display: flex; flex-direction: column; align-items: flex-start; }
.lux-col-customers { grid-area: customers; display: flex; flex-direction: column; align-items: flex-start; }
.lux-col-social-legal { grid-area: social; display: flex; flex-direction: column; gap: 8px; }

.lux-logo-wrap { display: block; margin-bottom: 16px; text-decoration: none; }
.lux-logo { width: var(--lf-logo-w, 160px); max-width: 100%; height: auto; display: block; opacity: 0.9; }
.lux-logo:hover { opacity: 1; }
.lux-logo-text { font-size: 22px; font-weight: 700; color: var(--lf-accent, #f5e6c8); }
.lux-contact-item { margin-bottom: 2px; }
.lux-phone,
.lux-email {
  font-size: 18px;
  font-weight: 700;
  color: var(--lf-accent, #f5e6c8);
  text-decoration: none;
  display: block;
  transition: color 0.2s;
  direction: ltr;
  unicode-bidi: isolate;
}
.lux-phone:hover,
.lux-email:hover { color: #fff; }
.lux-label {
  font-size: 11px;
  color: rgba(255,255,255,0.35);
  display: block;
  margin-bottom: 8px;
}

.lux-address-item { margin-top: 2px; max-width: 300px; }
.lux-address-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--lf-accent, #f5e6c8);
  line-height: 1.25;
  margin-bottom: 2px;
}
.lux-address-text {
  font-size: 11px;
  line-height: 1.45;
  color: rgba(255,255,255,0.35);
  max-width: 280px;
}

.lux-socials { display: flex; gap: 8px; margin: 12px 0 8px; }
.lux-socials a {
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  display: flex; align-items: center; justify-content: center;
  color: #fff; text-decoration: none;
  transition: background 0.2s;
}
.lux-socials a:hover { background: rgba(255,255,255,0.25); }
.lux-socials a svg { width: 14px; height: 14px; fill: currentColor; }
.lux-legal { display: flex; flex-direction: column; gap: 6px; }
.lux-legal a {
  font-size: 13px;
  color: rgba(255,255,255,0.5);
  text-decoration: none;
  transition: color 0.2s;
}
.lux-legal a:hover { color: #fff; }
.lux-col-nav .lux-nav-heading {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: rgba(255,255,255,0.35);
  display: block;
  margin-bottom: 16px;
}
.lux-col-nav ul {
  list-style: none; margin: 0; padding: 0;
  display: flex; flex-direction: column; gap: 10px;
}
.lux-col-nav ul li a {
  font-size: 14px;
  color: rgba(255,255,255,0.75);
  text-decoration: none;
  transition: color 0.2s;
}
.lux-col-nav ul li a:hover { color: #fff; }
.lux-footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.1);
  padding-top: 20px;
  margin-top: 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  max-width: var(--lf-max, 1600px);
  margin-left: auto;
  margin-right: auto;
  width: 100%;
}
.lux-footer-bottom p { font-size: 12px; color: rgba(255,255,255,0.35); margin: 0; }
.lux-footer-payments { display: flex; gap: 6px; align-items: center; }
.lux-footer-payments svg { height: 20px; width: auto; opacity: 0.55; }

@media (max-width: 900px) {
  .lux-footer { padding: 20px 30px 20px; }

  /* عمود الكتالوج مخفي على الموبايل. لو عايزه يظهر امسح السطر اللي تحت. */
  .lux-col-catalog { display: none !important; }

  .lux-footer-grid {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    grid-template-areas:
      "brand about"
      "customers customers"
      "social social" !important;
    gap: 30px 15px !important;
  }

  .lux-col-brand { grid-area: brand !important; }

  .lux-col-about {
    grid-area: about !important;
    align-items: flex-end !important;
    text-align: right !important;
  }
  .lux-col-about ul { align-items: flex-end !important; }
  .lux-col-about .lux-nav-heading,
  .lux-col-about ul li,
  .lux-col-about ul li a { text-align: right !important; }

  .lux-col-customers { grid-area: customers !important; width: 100% !important; }
  .lux-col-customers ul {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 14px 20px !important;
    width: 100% !important;
  }
  .lux-col-customers ul li { width: 100% !important; display: flex !important; }
  .lux-col-customers ul li:nth-child(odd) { justify-content: flex-start !important; }
  .lux-col-customers ul li:nth-child(even) { justify-content: flex-end !important; }
  .lux-col-customers ul li:nth-child(odd) a { text-align: left !important; }
  .lux-col-customers ul li:nth-child(even) a { text-align: right !important; }

  .lux-col-social-legal {
    grid-area: social !important;
    display: flex !important;
    flex-direction: row !important;
    justify-content: space-between !important;
    align-items: center !important;
    border-top: none !important;
    padding-top: 0 !important;
    margin-top: 10px !important;
  }
  .lux-socials { margin: 0 !important; justify-content: flex-start !important; }
  .lux-legal {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-end !important;
    text-align: right !important;
    gap: 8px !important;
  }
  .lux-col-nav { padding-top: 0 !important; }
}

@media (max-width: 768px) {
  .lux-banner {
    flex-direction: column;
    align-items: flex-start;
    padding: 20px 15px;
    border-radius: 10px;
    margin-bottom: 35px;
    gap: 15px;
  }
  .lux-banner-left { max-width: 100%; width: 100%; }
  .lux-banner-left .lux-banner-title { font-size: 24px; }

  .lux-banner-form {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) auto !important;
    align-items: stretch !important;
    width: 100% !important;
    max-width: 100% !important;
    overflow: hidden !important;
    border: 1px solid var(--lf-accent, #f5e6c8) !important;
    border-radius: 8px !important;
    background: #fff !important;
  }
  .lux-banner-form input[type="email"] {
    width: 100% !important;
    min-width: 0 !important;
    border: 0 !important;
    border-right: 1px solid var(--lf-accent, #f5e6c8) !important;
    border-radius: 0 !important;
    padding: 14px 16px !important;
    height: 58px !important;
    box-sizing: border-box !important;
    background: transparent !important;
  }
  .lux-banner-form button {
    border: 0 !important;
    border-radius: 0 !important;
    padding: 0 18px !important;
    min-width: 112px !important;
    height: 58px !important;
    box-sizing: border-box !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
  }

  .lux-banner-right { width: 100%; justify-content: flex-start; }
  .lux-promo-badge { font-size: 12px; padding: 10px 18px; }
  .lux-banner-img { display: none; }

  .lux-footer { padding: 20px 15px 15px; }
  .lux-col-nav ul li a {
    display: inline-block !important;
    font-size: 13px !important;
    white-space: normal !important;
  }
  .lux-logo { width: calc(var(--lf-logo-w, 160px) * 0.75); max-width: 100%; }
  .lux-phone,
  .lux-email,
  .lux-address-title { font-size: 15px; word-break: break-word; }
  .lux-address-text { font-size: 11px; max-width: 220px; }

  .lux-footer-bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 20px;
    padding-top: 15px;
  }
}

@media (max-width: 480px) {
  .lux-banner { padding: 18px 14px !important; }
  .lux-banner-left .lux-banner-title { font-size: 20px !important; line-height: 1.25 !important; }
  .lux-banner-left .lux-banner-subtitle { font-size: 13px !important; margin-bottom: 16px !important; }
  .lux-banner-form { grid-template-columns: minmax(0, 1fr) 112px !important; border-radius: 8px !important; }
  .lux-banner-form input[type="email"] { padding: 12px 14px !important; height: 56px !important; font-size: 15px !important; }
  .lux-banner-form button { min-width: 112px !important; height: 56px !important; padding: 0 14px !important; font-size: 15px !important; }
  .lux-banner-consent { gap: 8px !important; font-size: 11px !important; line-height: 1.5 !important; }
  .lux-banner-consent input { margin-top: 3px !important; }
}

@media (max-width: 375px) {
  .lux-banner-form { grid-template-columns: minmax(0, 1fr) 106px !important; }
  .lux-banner-form button { min-width: 106px !important; font-size: 14px !important; }
  .lux-banner-form input[type="email"] { font-size: 14px !important; padding: 12px !important; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  var COLORS = [
    'rgba(255, 182, 193, 0.7)',
    'rgba(255, 160, 180, 0.65)',
    'rgba(255, 192, 210, 0.7)',
    'rgba(250, 150, 175, 0.6)',
    'rgba(255, 210, 225, 0.75)'
  ];

  function startPetals(canvas) {
    var banner = canvas.parentElement;
    var ctx = canvas.getContext('2d');
    var petals = [];
    var count = 18;
    var raf = null, visible = false, initialized = false;
    var motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    function pause() { cancelAnimationFrame(raf); raf = null; }
    function sync() {
      if (!visible || document.hidden || motion.matches || !canvas.isConnected) { pause(); return; }
      if (!initialized) {
        resize();
        for (var i = 0; i < count; i++) petals.push(createPetal(true));
        initialized = true;
      }
      if (raf === null) raf = requestAnimationFrame(animate);
    }
    var visibility = new IntersectionObserver(function (entries) { visible = entries[0].isIntersecting; sync(); });
    visibility.observe(banner);
    document.addEventListener('visibilitychange', sync);
    motion.addEventListener('change', sync);

    function resize() {
      var width = banner.offsetWidth, height = banner.offsetHeight;
      canvas.width = width;
      canvas.height = height;
    }

    function createPetal(randomY) {
      return {
        x: Math.random() * canvas.width,
        y: randomY ? Math.random() * canvas.height : -20 - Math.random() * 80,
        size: 6 + Math.random() * 7,
        speedY: 0.4 + Math.random() * 0.5,
        speedX: -0.3 + Math.random() * 0.6,
        rotation: Math.random() * Math.PI * 2,
        rotSpeed: (Math.random() - 0.5) * 0.012,
        color: COLORS[Math.floor(Math.random() * COLORS.length)],
        narrow: Math.random() > 0.5,
        sway: Math.random() * Math.PI * 2,
        swaySpeed: 0.008 + Math.random() * 0.008,
        swayAmount: 0.3 + Math.random() * 0.4
      };
    }

    function animate() {
      raf = null;
      if (!visible || document.hidden || motion.matches || !canvas.isConnected) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (var i = 0; i < petals.length; i++) {
        var p = petals[i];
        p.sway += p.swaySpeed;
        p.x += p.speedX + Math.sin(p.sway) * p.swayAmount;
        p.y += p.speedY;
        p.rotation += p.rotSpeed;
        if (p.y > canvas.height + 20) { p = petals[i] = createPetal(false); }
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rotation);
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.ellipse(0, 0, p.size * (p.narrow ? 0.4 : 0.5), p.size * (p.narrow ? 0.9 : 1), 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
      raf = requestAnimationFrame(animate);
    }

    function onResize() { if (initialized && visible) resize(); }
    window.addEventListener('resize', onResize);

    return function stop() {
      pause();
      visibility.disconnect();
      window.removeEventListener('resize', onResize);
      document.removeEventListener('visibilitychange', sync);
      motion.removeEventListener('change', sync);
    };
  }

  function init(scope) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var canvases = (scope || document).querySelectorAll('[data-lux-petals]');
    for (var i = 0; i < canvases.length; i++) {
      if (!canvases[i]._stopPetals) canvases[i]._stopPetals = startPetals(canvases[i]);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { init(); });
  } else {
    init();
  }

  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
  document.addEventListener('shopify:section:unload', function (e) {
    var c = e.target.querySelector('[data-lux-petals]');
    if (c && c._stopPetals) { c._stopPetals(); c._stopPetals = null; }
  });
})();
{% endjavascript %}

