      {% if section.settings.banner_image != blank %}
        <img src="{{ section.settings.banner_image | image_url: width: 1200 }}" srcset="{% if section.settings.banner_image.width >= 400 %}{{ section.settings.banner_image | image_url: width: 400 }} 400w, {% endif %}{% if section.settings.banner_image.width >= 800 %}{{ section.settings.banner_image | image_url: width: 800 }} 800w, {% endif %}{% if section.settings.banner_image.width >= 1200 %}{{ section.settings.banner_image | image_url: width: 1200 }} 1200w, {% endif %}{% if section.settings.banner_image.width >= 1600 %}{{ section.settings.banner_image | image_url: width: 1600 }} 1600w, {% endif %}{% if section.settings.banner_image.width >= 2000 %}{{ section.settings.banner_image | image_url: width: 2000 }} 2000w, {% endif %}{% if section.settings.banner_image.width < 2000 %}{{ section.settings.banner_image | image_url: width: section.settings.banner_image.width }} {{ section.settings.banner_image.width }}w{% endif %}" sizes="100vw" width="{{ section.settings.banner_image.width }}" height="{{ section.settings.banner_image.height }}" alt="{{ section.settings.banner_image.alt | default: 'Find Your Perfect Recommendations' | escape }}" loading="lazy">
