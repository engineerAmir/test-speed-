<script>
(() => {
  if (customElements.get('ny-fixed-header')) return;
  class NicheyFixedHeader extends HTMLElement {
    connectedCallback() {
      this.frame = requestAnimationFrame(() => {
        this.frame = 0;
        if (!this.isConnected) return;
        const header = this.querySelector('.sukoshi-header');
        if (!header) return;
        const measure = () => {
          const height = Math.ceil(header.getBoundingClientRect().height) + 'px';
          if (this.style.getPropertyValue('--sk-fixed-header-height') !== height) {
            this.style.setProperty('--sk-fixed-header-height', height);
          }
        };
        this.observer = new ResizeObserver(measure);
        this.observer.observe(header);
        measure();
      });
    }
    disconnectedCallback() {
      cancelAnimationFrame(this.frame);
      this.observer?.disconnect();
    }
  }
  customElements.define('ny-fixed-header', NicheyFixedHeader);
})();
</script>

<div id="mobile-overlay" class="mobile-overlay" role="dialog" aria-modal="true" aria-label="{% if localization.language.iso_code == 'ar' %}قائمة التنقل{% else %}Navigation Menu{% endif %}">
  <div class="mobile-overlay-header">
    <a href="{{ routes.root_url }}" class="mobile-overlay-logo">
      <img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/1..png?v=1779628115&width=300" alt="{{ shop.name }}" loading="lazy">
    </a>
    <button id="mobile-close-btn" class="mobile-close-btn" aria-label="{% if localization.language.iso_code == 'ar' %}إغلاق القائمة{% else %}Close menu{% endif %}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="mobile-overlay-body">
    <ul class="mobile-menu">
      {% for link in section.settings.menu.links %}
        {% assign title_upper = link.title | upcase %}
        {% if title_upper == 'MEN' or title_upper == 'TOOLS' or title_upper == 'رجال' or title_upper == 'أدوات' %}{% continue %}{% endif %}

        {% assign link_title_down = link.title | downcase | strip %}
        {% assign is_brands_link = false %}
        {% if link_title_down == 'brands' or link_title_down == 'الماركات' or link_title_down == 'العلامات التجارية' or link.url contains 'brands' %}
          {% assign is_brands_link = true %}
        {% endif %}

        <li class="mobile-item">
          {% if link.links != blank or is_brands_link %}
            <div class="mobile-parent">
              <a href="{{ link.url }}" class="mobile-parent-link">{{ link.title }}</a>
              <span class="mobile-chevron">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </span>
            </div>
          {% else %}
            <div class="mobile-parent">
              <a href="{{ link.url }}" class="mobile-parent-link">{{ link.title }}</a>
            </div>
          {% endif %}

          {% if is_brands_link %}
            <ul class="mobile-sub">
              <li>
                <div class="mobile-brands-grid">
                  <a href="{{ lang_prefix }}/collections/COSRX" class="mobile-brand-item"><img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/COSRX.webp?v=1780667390&width=260" alt="COSRX" loading="lazy"></a>
                  <a href="{{ lang_prefix }}/collections/Medicube" class="mobile-brand-item"><img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/LOGO_medicube_5c532850-bfed-48eb-90aa-c0754dc93707.avif?v=1775562133&width=260" alt="Medicube" loading="lazy"></a>
                  <a href="{{ lang_prefix }}/collections/some-by-mi" class="mobile-brand-item"><img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/Some_By_Mi.webp?v=1780667390&width=260" alt="Some By Mi" loading="lazy"></a>
                  <a href="{{ lang_prefix }}/collections/CELIMAX" class="mobile-brand-item"><img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/CELIMAX.webp?v=1780667390&width=260" alt="CELIMAX" loading="lazy"></a>
                  <a href="{{ lang_prefix }}/collections/dr-melaxin" class="mobile-brand-item"><img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/dr_melaxin.png?v=1780930945&width=260" alt="Dr Melaxin" loading="lazy"></a>
                  <a href="{{ lang_prefix }}/collections/brands" class="mobile-brand-item mobile-see-more-btn">
                    {% if localization.language.iso_code == 'ar' %}عرض الكل «{% else %}See All »{% endif %}
                  </a>
                </div>
              </li>
            </ul>
          {% elsif link.links != blank %}
            <ul class="mobile-sub">
              {% for child in link.links %}
                <li>
                  <a href="{{ child.url }}" class="mobile-sub-link">{{ child.title }}</a>
                  {% if child.links != blank %}
                    <ul class="mobile-sub-sub">
                      {% for grandchild in child.links %}
                        <li><a href="{{ grandchild.url }}" class="mobile-sub-sub-link">{{ grandchild.title }}</a></li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {

    // ============================================================
    // MOBILE OVERLAY & ACCORDION TOGGLE
    // ============================================================
    var menuBtn  = document.getElementById('mobile-menu-btn');
    var closeBtn = document.getElementById('mobile-close-btn');
    var overlay  = document.getElementById('mobile-overlay');

    function openOverlay() {
      if (!overlay) return;
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden'; 
    }

    function closeOverlay() {
      if (!overlay) return;
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    if (menuBtn)  menuBtn.addEventListener('click',  openOverlay);
    if (closeBtn) closeBtn.addEventListener('click', closeOverlay);

    // Accordion Toggle for Mobile Submenu (Opens on chevron click only)
    var mobileChevrons = document.querySelectorAll('.mobile-chevron');
    mobileChevrons.forEach(function(chevron) {
      chevron.addEventListener('click', function(e) {
        e.stopPropagation();
        var parentDiv = this.closest('.mobile-parent');
        var parentLi = this.closest('.mobile-item');
        var subMenu = parentLi ? parentLi.querySelector('.mobile-sub') : null;
        if (subMenu) {
          var isOpen = subMenu.style.display === 'block';
          if (parentDiv) parentDiv.classList.toggle('is-open', !isOpen);
          subMenu.style.display = isOpen ? 'none' : 'block';
        }
      });
    });

    // ============================================================
    // PREDICTIVE SEARCH
    // ============================================================
    var searchInput = document.querySelector('.sk-search input[name="q"]');
    var searchForm  = document.querySelector('.sk-search form');

    if (searchInput && searchForm) {
      var resultsContainer = document.createElement('div');
      resultsContainer.className = 'predictive-results';
      searchForm.appendChild(resultsContainer);

      var debounceTimeout = null;
      var searchAbort = null;
      var SK_SEARCH_URL = "{{ routes.search_url }}";

      searchInput.addEventListener('input', function() {
        clearTimeout(debounceTimeout);
        var query = this.value.trim();
        if (query.length < 1) { resultsContainer.classList.remove('active'); return; }

        debounceTimeout = setTimeout(function() {
          if (searchAbort) searchAbort.abort();
          searchAbort = new AbortController();
          fetch(SK_SEARCH_URL + '?q=' + encodeURIComponent(query) + '&type=product&section_id=sukoshi-predictive-results', { signal: searchAbort.signal })
            .then(function(r) { return r.text(); })
            .then(function(text) {
              var section = new DOMParser().parseFromString(text, 'text/html')
                .getElementById('shopify-section-sukoshi-predictive-results');
              resultsContainer.innerHTML = section ? section.innerHTML : '';
              resultsContainer.classList.add('active');
            })
            .catch(function(err) { if (err.name !== 'AbortError') console.error(err); });
        }, 250);
      });

      document.addEventListener('click', function(e) {
        if (!searchForm.contains(e.target)) resultsContainer.classList.remove('active');
      });
    }

    // ============================================================
    // MEGA MENU (DESKTOP)
    // ============================================================
    (function() {
      var nav = document.querySelector('.sk-nav');
      if (!nav) return;

      var items = Array.from(nav.querySelectorAll('.menu-item.has-dropdown'));
      var activeItem   = null;
      var leaveTimeout = null;

      function activateItem(item) {
        if (activeItem && activeItem !== item) {
          activeItem.classList.add('no-animate');
          activeItem.classList.remove('is-active');
          void activeItem.offsetWidth;
          activeItem.classList.remove('no-animate');
          item.classList.add('no-animate');
          item.classList.add('is-active');
          void item.offsetWidth;
          requestAnimationFrame(function() { item.classList.remove('no-animate'); });
        } else if (!activeItem) {
          item.classList.remove('no-animate');
          item.classList.add('is-active');
        }
        activeItem = item;
      }

      function deactivateItem(item) {
        item.classList.remove('no-animate');
        item.classList.remove('is-active');
        activeItem = null;
      }

      items.forEach(function(item) {
        item.addEventListener('mouseenter', function() {
          clearTimeout(leaveTimeout);
          activateItem(this);
        });
        item.addEventListener('mouseleave', function(e) {
          var toEl = e.relatedTarget;
          if (toEl && toEl.closest('.menu-item.has-dropdown')) return;
          var self = this;
          leaveTimeout = setTimeout(function() { if (activeItem === self) deactivateItem(self); }, 80);
        });
      });

      nav.addEventListener('mouseleave', function() {
        clearTimeout(leaveTimeout);
        leaveTimeout = setTimeout(function() { if (activeItem) deactivateItem(activeItem); }, 80);
      });
      nav.addEventListener('mouseenter', function() { clearTimeout(leaveTimeout); });
    })();

    // ============================================================
    // CART COUNT BADGE SYNC (event-driven, no polling)
    // ============================================================
    (function() {
      var bubbles = document.querySelectorAll('[data-sk-cart-count]');
      if (!bubbles.length) return;

      var fetching = false;
      var timer = null;

      function render(count) {
        bubbles.forEach(function(el) {
          el.textContent = count;
          el.style.display = count > 0 ? 'flex' : 'none';
        });
      }

      function refreshCount() {
        if (fetching) return;
        fetching = true;
        fetch('/cart.js', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
          .then(function(r) { return r.json(); })
          .then(function(cart) { render(cart.item_count || 0); })
          .catch(function() { /* keep last known value */ })
          .finally(function() { fetching = false; });
      }

      function refreshSoon(ms) {
        clearTimeout(timer);
        timer = setTimeout(refreshCount, ms || 400);
      }

      // Events fired by sliders, quiz and the theme
      ['cart:refresh', 'cart:updated', 'cart:reload', 'cart:change'].forEach(function(evt) {
        document.addEventListener(evt, function() { refreshSoon(400); });
      });

      // Add-to-cart clicks and buttons inside the cart drawer
      document.addEventListener('click', function(e) {
        if (
          e.target.closest('button[name="add"], form[action*="/cart/add"] [type="submit"], [data-add-to-cart], .hdt-atc-btn') ||
          (e.target.closest('#CartDrawer') && e.target.closest('button'))
        ) {
          refreshSoon(500);
          setTimeout(refreshCount, 1500);
        }
      });

      document.addEventListener('change', function(e) {
        if (e.target.closest('#CartDrawer')) refreshSoon(400);
      });

      // Back/forward cache and returning to the tab
      window.addEventListener('pageshow', function(e) { if (e.persisted) refreshCount(); });
      document.addEventListener('visibilitychange', function() {
        if (!document.hidden) refreshCount();
      });
    })();

  });
</script>

{% schema %}
{
  "name": "Sukoshi Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Top announcement"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "message",
      "label": "Left announcement",
      "default": "Welcome to our store"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Left link label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Left link"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Announcement desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Announcement desktop height",
      "min": 1,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_bar_height",
      "label": "Announcement mobile height",
      "min": 1,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Announcement background",
      "default": "#7c3030"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Announcement text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Announcement desktop text size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Announcement mobile text size",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "Right announcement"
    },
    {
      "id": "message_right",
      "default": "Discover your next essential",
      "label": "Right announcement",
      "type": "text"
    },
    {
      "id": "link_label_right",
      "default": "Explore",
      "label": "Right link label",
      "type": "text"
    },
    {
      "id": "link_url_right",
      "label": "Right link",
      "type": "url"
    }
  ]
}
{% endschema %}
