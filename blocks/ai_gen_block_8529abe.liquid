{% doc %}
  @prompt
    Create a premium editorial blog header for a beauty ecommerce website.
    
    Include:
    
    * Small eyebrow text: "Beauty Journal"
    * Large title: "NICHEY BEAUTY BLOG"
    * Subtitle: "Expert skincare guides, makeup tips, brand reviews, and beauty trends."
    * Thin divider line below the subtitle.
    * Center aligned content.
    * White background with luxury minimal styling.
    * Typography-focused design with no large images.
    * Spacious layout with high-end magazine appearance.
    * Responsive design optimized for Shopify.
    * Soft neutral color palette matching luxury skincare brands.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-header-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-blog-header__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-blog-header__eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: {{ block.settings.eyebrow_weight }};
    letter-spacing: {{ block.settings.eyebrow_spacing }}px;
    text-transform: uppercase;
    color: {{ block.settings.eyebrow_color }};
    margin: 0 0 {{ block.settings.eyebrow_margin }}px;
    font-family: {{ block.settings.eyebrow_font.family }}, {{ block.settings.eyebrow_font.fallback_families }};
  }

  .ai-blog-header__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    letter-spacing: {{ block.settings.title_spacing }}px;
    line-height: {{ block.settings.title_line_height }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px;
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
  }

  .ai-blog-header__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: {{ block.settings.subtitle_weight }};
    line-height: {{ block.settings.subtitle_line_height }};
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 {{ block.settings.subtitle_margin }}px;
    max-width: {{ block.settings.subtitle_max_width }}px;
    margin-left: auto;
    margin-right: auto;
    font-family: {{ block.settings.subtitle_font.family }}, {{ block.settings.subtitle_font.fallback_families }};
  }

  .ai-blog-header__divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_thickness }}px;
    background-color: {{ block.settings.divider_color }};
    margin: 0 auto;
    border: none;
  }

  @media screen and (max-width: 749px) {
    .ai-blog-header-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-blog-header__eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_size_mobile }}px;
      margin-bottom: {{ block.settings.eyebrow_margin_mobile }}px;
    }

    .ai-blog-header__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
      margin-bottom: {{ block.settings.title_margin_mobile }}px;
    }

    .ai-blog-header__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size_mobile }}px;
      margin-bottom: {{ block.settings.subtitle_margin_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-blog-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-header__container-{{ ai_gen_id }}">
    {% if block.settings.eyebrow_text != blank %}
      <p class="ai-blog-header__eyebrow-{{ ai_gen_id }}">
        {{ block.settings.eyebrow_text }}
      </p>
    {% endif %}

    {% if block.settings.title_text != blank %}
      <h1 class="ai-blog-header__title-{{ ai_gen_id }}">
        {{ block.settings.title_text }}
      </h1>
    {% endif %}

    {% if block.settings.subtitle_text != blank %}
      <p class="ai-blog-header__subtitle-{{ ai_gen_id }}">
        {{ block.settings.subtitle_text }}
      </p>
    {% endif %}

    {% if block.settings.show_divider %}
      <hr class="ai-blog-header__divider-{{ ai_gen_id }}">
    {% endif %}
  </div>
</div>

