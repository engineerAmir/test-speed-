{% comment %}
  Collection carousel using the theme's shared card-product1 snippet.
  Product card appearance and actions follow the theme's global product card settings.
{% endcomment %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign selected_collection = block.settings.collection %}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{% capture card_sizes %}(min-width: 750px) calc(100vw / {{ block.settings.desktop_cards }}), calc(100vw / {{ block.settings.mobile_cards }}){% endcapture %}
{% capture btn_wishlist_code %}
  {% if settings.wishlist_mode != '0' %}
    {% render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'right' %}
  {% endif %}
{% endcapture %}
{% style %}
  .ai-product-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_side }}px {{ block.settings.padding_bottom }}px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    font-family: var(--f_family_1, inherit);
    box-sizing: border-box;
  }
  .ai-product-carousel-{{ ai_gen_id }} *, .ai-product-carousel-{{ ai_gen_id }} *::before, .ai-product-carousel-{{ ai_gen_id }} *::after { box-sizing: border-box; }
  .ai-product-carousel-{{ ai_gen_id }}__header { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:20px; }
  .ai-product-carousel-{{ ai_gen_id }}__heading { margin:0; color:inherit; font-family:inherit; font-size:clamp(20px, 2vw, 28px); line-height:1.25; font-weight:600; }
  .ai-product-carousel-{{ ai_gen_id }}__view-all { color:inherit; text-decoration:underline; text-underline-offset:3px; white-space:nowrap; }
  .ai-product-carousel-{{ ai_gen_id }}__view-all:focus-visible, .ai-product-carousel-{{ ai_gen_id }}__button:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
  .ai-product-carousel-{{ ai_gen_id }}__controls { display:flex; justify-content:flex-end; gap:8px; margin-bottom:12px; }
  .ai-product-carousel-{{ ai_gen_id }}__button { display:grid; place-items:center; width:38px; height:38px; border:1px solid {{ block.settings.text_color }}; border-radius:50%; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; cursor:pointer; }
  .ai-product-carousel-{{ ai_gen_id }}__track { display:grid; grid-auto-flow:column; grid-auto-columns:calc((100% - ({{ block.settings.desktop_gap }}px * ({{ block.settings.desktop_cards }} - 1))) / {{ block.settings.desktop_cards }}); gap:{{ block.settings.desktop_gap }}px; overflow-x:auto; overscroll-behavior-inline:contain; scroll-snap-type:x mandatory; scroll-behavior:smooth; scrollbar-width:none; }
  .ai-product-carousel-{{ ai_gen_id }}__track::-webkit-scrollbar { display:none; }
  .ai-product-carousel-{{ ai_gen_id }}__card { scroll-snap-align:start; min-width:0; display:flex; }
  .ai-product-carousel-{{ ai_gen_id }}__card > .hdt-card-product { display:block; width:100%; min-width:0; height:100%; }
  .ai-product-carousel-{{ ai_gen_id }}__card .hdt-card-product__wrapper { height:100%; display:flex; flex-direction:column; }
  .ai-product-carousel-{{ ai_gen_id }}__card .hdt-card-product__info { flex:1; }
  .ai-product-carousel-{{ ai_gen_id }}__card .hdt-ratio { --ratio-percent:calc(100% / ({{ block.settings.image_ratio }})); }
  .ai-product-carousel-{{ ai_gen_id }}__empty { padding:24px 12px; text-align:center; background:#f5f5f5; color:#333; }
  @media (max-width:749px) {
    .ai-product-carousel-{{ ai_gen_id }} { width:100%; padding-left:{{ block.settings.padding_side | at_most: 20 }}px; padding-right:{{ block.settings.padding_side | at_most: 20 }}px; }
    .ai-product-carousel-{{ ai_gen_id }}__track { grid-auto-columns:calc((100% - ({{ block.settings.mobile_gap }}px * {{ block.settings.mobile_cards }}) - 12px) / {{ block.settings.mobile_cards }}); gap:{{ block.settings.mobile_gap }}px; }
    .ai-product-carousel-{{ ai_gen_id }}__controls { display:none; }
    .ai-product-carousel-{{ ai_gen_id }}__heading { font-size:20px; }
  }
  @media (prefers-reduced-motion:reduce) { .ai-product-carousel-{{ ai_gen_id }}__track { scroll-behavior:auto; } }
{% endstyle %}
<product-carousel-{{ ai_gen_id }} class="ai-product-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-carousel-{{ ai_gen_id }}__header">
    <h2 class="ai-product-carousel-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% if selected_collection != blank %}<a class="ai-product-carousel-{{ ai_gen_id }}__view-all" href="{{ selected_collection.url }}">{{ block.settings.view_all_label | escape }} →</a>{% endif %}
  </div>
  {% if selected_collection != blank and selected_collection.products_count > 0 %}
    <div class="ai-product-carousel-{{ ai_gen_id }}__controls">
      <button class="ai-product-carousel-{{ ai_gen_id }}__button" type="button" aria-controls="CarouselTrack-{{ ai_gen_id }}" data-direction="previous" aria-label="Scroll to previous products"><span aria-hidden="true">←</span></button>
      <button class="ai-product-carousel-{{ ai_gen_id }}__button" type="button" aria-controls="CarouselTrack-{{ ai_gen_id }}" data-direction="next" aria-label="Scroll to next products"><span aria-hidden="true">→</span></button>
    </div>
    <div id="CarouselTrack-{{ ai_gen_id }}" class="ai-product-carousel-{{ ai_gen_id }}__track hdt-collection-products hdt-collection-has-pr1" tabindex="0" aria-label="Products from {{ selected_collection.title | escape }}">
      {% assign available_products = selected_collection.products | where: 'available', true %}
      {% assign sold_out_products = selected_collection.products | where: 'available', false %}
      {% assign carousel_products = available_products | concat: sold_out_products %}
      {% for product in carousel_products limit: block.settings.product_limit %}
        <div class="ai-product-carousel-{{ ai_gen_id }}__card">
          {% render 'card-product1',
            card_product: product,
            section_id: section.id,
            class: 'hdt-pr-style1',
            sizes: card_sizes,
            image_ratio: 'square',
            btn_wishlist_code: btn_wishlist_code
          %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-product-carousel-{{ ai_gen_id }}__empty">Choose a collection in this block’s settings to display products.</div>
  {% endif %}
</product-carousel-{{ ai_gen_id }}>
<script>
(function() {
  const tagName = 'product-carousel-{{ ai_gen_id }}';
  if (customElements.get(tagName)) return;
  class ProductCarousel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('.ai-product-carousel-{{ ai_gen_id }}__track');
      this.querySelectorAll('[data-direction]').forEach((button) => {
        button.addEventListener('click', () => {
          const direction = button.dataset.direction === 'next' ? 1 : -1;
          this.track.scrollBy({ left: direction * this.track.clientWidth * 0.85, behavior: 'smooth' });
        });
      });
    }
  }
  customElements.define(tagName, ProductCarousel);
})();
</script>
{% schema %}
{
  "name": "Product carousel",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Product limit",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "paragraph",
      "content": "Cards use the theme’s global product card settings for prices, badges, swatches, and quick add."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "desktop_cards",
      "label": "Desktop cards per view",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_cards",
      "label": "Mobile cards per view",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "3 / 4",
          "label": "Portrait"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_side",
      "label": "Side padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#222222"
    }
  ],
  "presets": [
    {
      "name": "Product carousel"
    }
  ],
  "tag": null,
  "class": "product-carousel-block"
}
{% endschema %}