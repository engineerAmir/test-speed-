      background: rgba(0, 0, 0, 0.45) !important;
      z-index: 2147483645 !important;
    }

    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-filter-sidebar {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      bottom: 0 !important;
      height: 100dvh !important;
      max-height: 100dvh !important;
      width: min(88vw, 360px) !important;
      background: #fff !important;
      z-index: 2147483646 !important;
      transform: translateX(0) !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
      box-shadow: 0 18px 60px rgba(0, 0, 0, 0.22) !important;
    }

    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-filter-panel {
      min-height: 100dvh !important;
      border-radius: 0 !important;
      border: 0 !important;
      position: relative !important;
      z-index: 2147483646 !important;
    }

    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-filter-panel-header {
      position: sticky !important;
      top: 0 !important;
      z-index: 2147483647 !important;
      background: #fff !important;
    }

    body.nichey-filter-is-open-{{ section.id }} .hdt-bottom-nav,
    body.nichey-filter-is-open-{{ section.id }} .hdt-sticky-cart,
    body.nichey-filter-is-open-{{ section.id }} .hdt-sticky-atc,
    body.nichey-filter-is-open-{{ section.id }} .bottom-navigation,
    body.nichey-filter-is-open-{{ section.id }} .mobile-bottom-navigation,
    body.nichey-filter-is-open-{{ section.id }} .shopify-section-header-sticky,
    body.nichey-filter-is-open-{{ section.id }} .shopify-section-header-hidden,
    body.nichey-filter-is-open-{{ section.id }} #shopify-section-header,
    body.nichey-filter-is-open-{{ section.id }} header {
      z-index: 1 !important;
      pointer-events: none !important;
    }
  }

  {% render 'spacing-vars', box: section %}
    [data-ncv-card] .css-pricing [hidden] { display: none !important; }
    .ncv-variant-label { text-align: center; font-size: 12px; margin: 10px 0 3px; line-height: 1.4; }
    .ncv-swatches { display: flex; justify-content: center; flex-wrap: wrap; gap: 2px; }
    .ncv-swatch { position: relative; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; min-width: 40px; min-height: 40px; padding: 6px; border: 0; background: transparent; color: inherit; cursor: pointer; }
    .ncv-swatch-dot { width: 24px; height: 24px; display: block; border-radius: 50%; border: 1px solid #bbb; overflow: hidden; box-sizing: border-box; }
    .ncv-swatch-dot img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .ncv-swatch[aria-pressed="true"] .ncv-swatch-dot { outline: 1px solid #333; outline-offset: 3px; }
    .ncv-swatch-text { padding: 4px 7px; border: 1px solid #ccc; border-radius: 5px; font-size: 12px; }
    .ncv-swatch[aria-pressed="true"] .ncv-swatch-text { border-color: #222; background: #f2f2f2; }
    .ncv-swatch-caption { font-size: 11px; max-width: 100px; overflow-wrap: anywhere; }
    .ncv-swatch[data-available="false"] { opacity: .5; cursor: pointer; }
    .ncv-swatch[data-available="false"] .ncv-swatch-text { text-decoration: line-through; }
    .ncv-swatch:focus-visible { outline: 2px solid #7c3030; border-radius: 5px; }
    .ncv-swatches { position: relative; z-index: 2; pointer-events: auto; }
    .ncv-swatch { pointer-events: auto; }
    [data-ncv-card] .css-atc:disabled:not([aria-busy="true"]) { cursor: not-allowed; }

</style>

<div id="{{ section.id }}" main-content class="hdt-main-collection-content hdt-section-spacing hdt-section-spacing-{{ section.id }}">
  {%- if section.settings.description_position == 'before' -%}
    {{ collection_description }}
  {%- endif -%}

  {%- if request.page_type == 'collection' -%}
  <div class="{{ parent }} nichey-collection-center">
    <div class="{{ child }}">
      <div class="nichey-collection-top">
        <div class="nichey-filter-spacer"></div>

        <h1 class="nichey-collection-title">{{ collection.title }}</h1>

        <div class="nichey-sort-wrap">
          {%- if section.settings.enable_sorting and collection.all_products_count > 0 -%}
            {%- liquid
              assign sort_by = collection.sort_by | default: collection.default_sort_by
            -%}

            <form class="nichey-sort-form" method="get" action="{{ collection.url }}">
              {%- for filter in collection.filters -%}
                {%- if filter.type == 'price_range' -%}
                  {%- if filter.min_value.value -%}
                    <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}">
                  {%- endif -%}
                  {%- if filter.max_value.value -%}
                    <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}">
                  {%- endif -%}
                {%- else -%}
                  {%- for value in filter.values -%}
                    {%- if value.active -%}
                      <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}

              <details class="nichey-sort-details">
                <summary class="nichey-sort-summary">
                  <span>
                    {%- for option in collection.sort_options -%}
                      {%- if option.value == sort_by -%}
                        {{ option.name | escape }}
                      {%- endif -%}
                    {%- endfor -%}
                  </span>

                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>

                <div class="nichey-sort-menu">
                  {%- for option in collection.sort_options -%}
                    <button
                      type="submit"
                      name="sort_by"
                      value="{{ option.value | escape }}"
                      class="nichey-sort-option {% if option.value == sort_by %}is-active{% endif %}"
                    >
                      {{ option.name | escape }}
                    </button>
                  {%- endfor -%}
                </div>
              </details>
            </form>
          {%- endif -%}
        </div>

        {%- if section.settings.enable_filtering -%}
          <button type="button" class="nichey-mobile-filter-btn" data-nichey-filter-open>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M324.4 64C339.6 64 352 76.37 352 91.63C352 98.32 349.6 104.8 345.2 109.8L240 230V423.6C240 437.1 229.1 448 215.6 448C210.3 448 205.2 446.3 200.9 443.1L124.7 385.6C116.7 379.5 112 370.1 112 360V230L6.836 109.8C2.429 104.8 0 98.32 0 91.63C0 76.37 12.37 64 27.63 64H324.4zM496 400C504.8 400 512 407.2 512 416C512 424.8 504.8 432 496 432H336C327.2 432 320 424.8 320 416C320 407.2 327.2 400 336 400H496zM320 256C320 247.2 327.2 240 336 240H496C504.8 240 512 247.2 512 256C512 264.8 504.8 272 496 272H336C327.2 272 320 264.8 320 256zM496 80C504.8 80 512 87.16 512 96C512 104.8 504.8 112 496 112H400C391.2 112 384 104.8 384 96C384 87.16 391.2 80 400 80H496z"></path></svg>
            <span>Filter</span>
          </button>
        {%- endif -%}
      </div>

      <div class="nichey-collection-layout">
        {%- if section.settings.enable_filtering -%}
          <div class="nichey-filter-overlay" data-nichey-filter-close></div>

          <aside class="nichey-filter-sidebar" data-nichey-filter-sidebar>
            <div class="nichey-filter-panel">
              <div class="nichey-filter-panel-header">
                <p class="nichey-filter-title">Filter by</p>

                <div class="nichey-filter-header-actions">
                  <button
                    type="button"
                    class="nichey-clear-real-btn"
                    data-nichey-clear-filters
                    data-clear-url="{{ collection.url }}"
                    aria-label="Clear all filters"
                  >
                    Clear
                  </button>
                </div>
              </div>

              <div class="nichey-filter-body">
                <form id="NicheyFilters-{{ section.id }}" class="nichey-filter-form" method="get" action="{{ collection.url }}">
                  {%- if collection.sort_by != blank -%}
                    <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
                  {%- endif -%}

                  {%- for filter in collection.filters -%}
                    {%- liquid
                      assign default_open_filter = false

                      if forloop.index <= 3
                        assign default_open_filter = true
                      endif
                    -%}

                    <details class="nichey-filter-group"{% if default_open_filter %} open{% endif %}>
                      <summary class="nichey-filter-summary">
                        <span>{{ filter.label }}</span>
                        <svg class="nichey-filter-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none">
                          <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </summary>

                      <div class="nichey-filter-content">
                        {%- case filter.type -%}
                          {%- when 'boolean', 'list' -%}
                            {%- liquid
                              assign filter_label_downcase = filter.label | downcase
                              assign is_color_filter = false

                              if filter_label_downcase contains 'color' or filter_label_downcase contains 'colour' or filter_label_downcase contains 'لون'
                                assign is_color_filter = true
                              endif
                            -%}

                            <div class="nichey-filter-values">
                              {%- for value in filter.values -%}
                                {%- liquid
                                  assign value_label_downcase = value.label | downcase
                                  assign swatch_color = ''
                                  assign light_swatch = false

                                  if is_color_filter
                                    if value_label_downcase contains 'black' or value_label_downcase contains 'اسود'
                                      assign swatch_color = '#111111'
                                    elsif value_label_downcase contains 'white' or value_label_downcase contains 'ابيض'
                                      assign swatch_color = '#ffffff'
                                      assign light_swatch = true
                                    elsif value_label_downcase contains 'beige'
                                      assign swatch_color = '#d8c4a3'
                                      assign light_swatch = true
                                    elsif value_label_downcase contains 'blue'
                                      assign swatch_color = '#2f65b9'
                                    elsif value_label_downcase contains 'navy'
                                      assign swatch_color = '#0b1f3a'
                                    elsif value_label_downcase contains 'red'
                                      assign swatch_color = '#b32626'
                                    elsif value_label_downcase contains 'green'
                                      assign swatch_color = '#3f7a45'
                                    elsif value_label_downcase contains 'pink'
                                      assign swatch_color = '#e7a5b8'
                                      assign light_swatch = true
                                    elsif value_label_downcase contains 'brown'
                                      assign swatch_color = '#7a4a2a'
                                    elsif value_label_downcase contains 'grey' or value_label_downcase contains 'gray'
                                      assign swatch_color = '#9b9b9b'
                                    elsif value_label_downcase contains 'yellow'
                                      assign swatch_color = '#f2d14b'
                                      assign light_swatch = true
                                    elsif value_label_downcase contains 'purple'
                                      assign swatch_color = '#7650a8'
                                    elsif value_label_downcase contains 'orange'
                                      assign swatch_color = '#e88635'
                                    elsif value_label_downcase contains 'gold'
                                      assign swatch_color = '#c8a045'
                                      assign light_swatch = true
                                    elsif value_label_downcase contains 'silver'
                                      assign swatch_color = '#c9c9c9'
                                      assign light_swatch = true
                                    else
                                      assign swatch_color = '#f7f5f0'
                                      assign light_swatch = true
                                    endif
                                  endif
                                -%}

                                <label
                                  class="nichey-filter-check{% if value.active %} is-active{% endif %}{% if value.count == 0 and value.active == false %} is-disabled{% endif %}{% if is_color_filter %} is-color-filter{% endif %}{% if light_swatch %} is-light-swatch{% endif %}"
                                  for="Filter-{{ section.id }}-{{ filter.param_name | escape }}-{{ forloop.index }}"
                                  {% if is_color_filter %}style="--nichey-swatch-color: {{ swatch_color }};"{% endif %}
                                >
                                  <input
                                    id="Filter-{{ section.id }}-{{ filter.param_name | escape }}-{{ forloop.index }}"
                                    type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    {% if value.active %}checked{% endif %}
                                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                  >

                                  <span class="nichey-checkbox-box"></span>

                                  <span class="nichey-filter-label-text">
                                    {{ value.label | escape }} <span>({{ value.count }})</span>
                                  </span>
                                </label>
                              {%- endfor -%}
                            </div>

                          {%- when 'price_range' -%}
                            {%- liquid
                              assign range_max = filter.range_max | money_without_currency | replace: ',', '' | plus: 0
                              assign min_value = filter.min_value.value | money_without_currency | replace: ',', '' | plus: 0
                              assign max_value = filter.max_value.value | money_without_currency | replace: ',', '' | plus: 0

                              if range_max == blank or range_max == 0
                                assign range_max = 1
                              endif

                              if min_value == blank
                                assign min_value = 0
                              endif

                              if max_value == blank or max_value == 0
                                assign max_value = range_max
                              endif
                            -%}

                            <div class="nichey-price-filter" data-price-filter>
                              <div class="nichey-price-slider" data-range-slider>
                                <div class="nichey-price-track" data-price-track></div>

                                <input
                                  class="nichey-range nichey-range-min"
                                  type="range"
                                  min="0"
                                  max="{{ range_max }}"
                                  step="1"
                                  value="{{ min_value }}"
                                  data-range-min
                                >

                                <input
                                  class="nichey-range nichey-range-max"
                                  type="range"
                                  min="0"
                                  max="{{ range_max }}"
                                  step="1"
                                  value="{{ max_value }}"
                                  data-range-max
                                >
                              </div>

                              <div class="nichey-price-inputs">
                                <span class="nichey-price-label">Price:</span>

                                <div class="nichey-price-field">
                                  <span>{{ cart.currency.iso_code }}</span>
                                  <input
                                    type="number"
                                    min="0"
                                    max="{{ range_max }}"
                                    name="{{ filter.min_value.param_name }}"
                                    value="{% if filter.min_value.value %}{{ min_value }}{% endif %}"
                                    placeholder="0"
                                    data-price-min
                                  >
                                </div>

                                <span class="nichey-price-separator">-</span>

                                <div class="nichey-price-field">
                                  <span>{{ cart.currency.iso_code }}</span>
                                  <input
                                    type="number"
                                    min="0"
                                    max="{{ range_max }}"
                                    name="{{ filter.max_value.param_name }}"
                                    value="{% if filter.max_value.value %}{{ max_value }}{% endif %}"
                                    placeholder="{{ range_max }}"
                                    data-price-max
                                  >
                                </div>
                              </div>
                            </div>
                        {%- endcase -%}
                      </div>
                    </details>
                  {%- endfor -%}
                </form>
              </div>
            </div>
          </aside>
        {%- endif -%}

        <main class="nichey-products-area">
          {%- if collection.all_products_count == 0 -%}
            <div class="nichey-empty">
              <div>
                <p>{{ 'sections.collection_template.empty' | t }}</p>
                <a href="{{ routes.all_products_collection_url }}">{{ 'sections.collection_template.continue_shopping' | t }}</a>
              </div>
            </div>
          {%- else -%}
            {%- paginate collection.products by section.settings.products_count -%}
              {%- if collection.products.size == 0 -%}
                <div class="nichey-no-result">
                  {{ 'general.search.no_product_results' | t }}
                </div>
              {%- else -%}
                <div id="{{ products_id }}" class="nichey-products-grid">
                  {%- for product in collection.products -%}
                    {%- liquid
                      assign first_variant = product.selected_or_first_available_variant
                      assign img = first_variant.featured_image | default: product.featured_image
                      assign is_ar = false
                      if localization.language.iso_code == 'ar'
                        assign is_ar = true
                      endif
                      unless settings.remove_collection_url
                        assign product_url = product.url | within: collection
                      else
                        assign product_url = product.url
                      endunless
                      assign card_form_id = 'product-form-card-' | append: section.id | append: '-' | append: product.id
                    -%}

                    <div class="css-card" data-ncv-card>
                      <div class="css-image-wrap">
                        <div class="css-media-box">
                          <a href="{{ product_url }}" class="css-image-link">
                            {%- if img != blank -%}
                              <img
                                src="{{ img | image_url: width: 600 }}"
                                alt="{{ img.alt | default: product.title | escape }}"
                                loading="lazy"
                                width="{{ img.width }}"
                                height="{{ img.height }}">
                            {%- else -%}
                              {{ 'product-1' | placeholder_svg_tag }}
                            {%- endif -%}
                          </a>

                          <hdt-wishlist class="css-icon-btn css-wishlist" role="button" data-id="{{ product.id }}" action="add" placement="left" tabindex="0">
                            <svg width="24" height="24" aria-hidden="true" focusable="false" class="hdt-svg-pr-icon hdt-svg-wis" viewBox="0 0 24 24"><use xlink:href="#hdt-icon-pr-wis"></use></svg>
                            <span class="sr-only">{{ 'general.wishlist.add_to_wishlist' | t }}</span>
                          </hdt-wishlist>

                          {%- if first_variant != blank -%}
                            <wrapp-hdt-pr-frm class="hdt-contents">
                              {%- form 'product', product, id: card_form_id, class: 'css-atc-form', data-gift-card-recipient: false -%}
                                <input type="hidden" name="id" value="{{ first_variant.id }}">
                                <hdt-atc-animation class="hdt-contents" config='{ "ani": "none", "time": "6" }'>
                                  <button data-animation type="submit" name="add" class="css-icon-btn css-atc hdt-btn-loading__svg" aria-label="Add to cart" {% unless first_variant.available %}disabled{% endunless %}>
                                    <span class="hdt-btn-atc_text">
                                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"></path><path d="M20 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"></path><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path><path d="M12 10h4"></path><path d="M14 8v4"></path></svg>
                                    </span>
                                    <span class="hdt-loading__spinner hdt-absolute" hidden>
                                      <svg width="16" height="16" class="hdt-svg-spinner" focusable="false" role="presentation" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg"><circle class="hdt-path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg>
                                    </span>
                                  </button>
                                </hdt-atc-animation>
                              {%- endform -%}
                            </wrapp-hdt-pr-frm>
                          {%- endif -%}
                        </div>
                      </div>

                      <div class="css-info">
                        {%- assign judge_review_count = product.metafields.reviews.rating_count | default: product.metafields.judge_me.reviews_count | plus: 0 -%}
                        <div class="css-rating">
                          {%- if judge_review_count > 0 -%}
                            <!-- Start of Judge.me code -->
                            <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
                              {{ product.metafields.judgeme.badge }}
                            </div>
                            <!-- End of Judge.me code -->
                          {%- else -%}
                            <div class="jdgm-prev-badge css-rating-empty" aria-label="No reviews">
                              <span class="jdgm-prev-badge__stars" aria-hidden="true">
                                <span class="jdgm-star jdgm--off"></span>
                                <span class="jdgm-star jdgm--off"></span>
                                <span class="jdgm-star jdgm--off"></span>
                                <span class="jdgm-star jdgm--off"></span>
                                <span class="jdgm-star jdgm--off"></span>
                              </span>
                              <span class="jdgm-prev-badge__text">No reviews</span>
                            </div>
                          {%- endif -%}
                        </div>

                        {%- if product.vendor != blank -%}
                          <div class="css-vendor">{{ product.vendor }}</div>
                        {%- endif -%}

                        <a href="{{ product_url }}" class="css-title">{{ product.title }}</a>

                  <div class="css-pricing" aria-live="polite">
                    <s class="css-old-price" {% unless first_variant.compare_at_price > first_variant.price %}hidden{% endunless %}>{{ first_variant.compare_at_price | money }}</s>
                    <span class="css-new-price">{{ first_variant.price | money }}</span>
                    <span class="css-discount" {% unless first_variant.compare_at_price > first_variant.price %}hidden{% endunless %}>-{% if first_variant.compare_at_price > first_variant.price %}{{ first_variant.compare_at_price | minus: first_variant.price | times: 100.0 | divided_by: first_variant.compare_at_price | round }}{% else %}0{% endif %}%</span>
                  </div>
                  {%- unless product.has_only_default_variant -%}
                    <div class="ncv-variant-label" aria-live="polite">{{ first_variant.title | escape }}{% unless first_variant.available %} — {% if is_ar %}غير متاح{% else %}Sold out{% endif %}{% endunless %}</div>
                    <div class="ncv-swatches" role="group" aria-label="{{ product.options | join: ' / ' | escape }}">
                      {%- for variant in product.variants -%}
                        {%- liquid
                          assign vimg = variant.featured_image | default: product.featured_image
                          assign swatch_color = blank
                          assign swatch_image = blank
                          for option in product.options_with_values
                            assign option_index = forloop.index0
                            assign option_name = variant.options[option_index]
                            for value in option.values
                              if value.name == option_name
                                if value.swatch.color != blank or value.swatch.image != blank
                                  assign swatch_color = value.swatch.color
                                  assign swatch_image = value.swatch.image
                                endif
                              endif
                            endfor
                          endfor
                          assign discount = 0
                          if variant.compare_at_price > variant.price
                            assign discount = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
                          endif
                        -%}
                        <button type="button" class="ncv-swatch{% if swatch_color != blank or swatch_image != blank or variant.featured_image != blank %} ncv-swatch-visual{% endif %}"
                          aria-pressed="{% if variant.id == first_variant.id %}true{% else %}false{% endif %}"
                          aria-label="{{ variant.title | escape }}{% unless variant.available %} — {% if is_ar %}غير متاح{% else %}Sold out{% endif %}{% endunless %}"
                          title="{{ variant.title | escape }}"
                          data-id="{{ variant.id }}" data-title="{{ variant.title | escape }}"
                          data-url="{{ product.url }}?variant={{ variant.id }}"
                          data-price="{{ variant.price | money | strip_html | escape }}"
                          data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | strip_html | escape }}{% endif %}"
                          data-discount="{{ discount }}"
                          data-image="{% if vimg %}{{ vimg | image_url: width: 480 }}{% endif %}"
                          data-srcset="{% if vimg %}{{ vimg | image_url: width: 240 }} 240w, {{ vimg | image_url: width: 360 }} 360w, {{ vimg | image_url: width: 480 }} 480w{% endif %}"
                          data-available="{{ variant.available }}">
                          {%- if swatch_image != blank -%}
                            <span class="ncv-swatch-dot"><img src="{{ swatch_image | image_url: width: 64 }}" width="24" height="24" loading="lazy" alt=""></span>
                          {%- elsif swatch_color != blank -%}
                            <span class="ncv-swatch-dot" style="background-color: {{ swatch_color }}"></span>
                          {%- elsif variant.featured_image != blank -%}
                            <span class="ncv-swatch-dot"><img src="{{ variant.featured_image | image_url: width: 64 }}" width="24" height="24" loading="lazy" alt=""></span>
                          {%- else -%}
                            <span class="ncv-swatch-text">{{ variant.title | escape }}</span>
                          {%- endif -%}
                          {%- if product.options.size > 1 -%}<span class="ncv-swatch-caption">{{ variant.title | escape }}</span>{%- endif -%}
                        </button>
                      {%- endfor -%}
                    </div>
                    {%- if product.variants.size >= 250 -%}<a href="{{ product.url }}">{% if is_ar %}كل الاختيارات{% else %}All options{% endif %}</a>{%- endif -%}
                  {%- endunless -%}

                      </div>
                    </div>
                  {%- endfor -%}
                </div>

                {%- if paginate.pages > 1 -%}
                  <div class="nichey-pagination">
                    {%- render 'pagination', paginate: paginate, anchor: '', section_id: section.id, pagination_type: section.settings.pagination_type, append_id: products_id, paginate_pos: section.settings.paginate_pos, dis_pagination: section.settings.dis_pagination, lm_text: section.settings.btn_label -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endpaginate -%}
          {%- endif -%}
        </main>
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- if section.settings.description_position == 'after' -%}
    {{ collection_description }}
  {%- endif -%}
</div>

<script>

    // Keep swatch selection independent of older slider initializers.
    (function () {
      if (window.__nicheyCollectionSwatchesV1) return;
      window.__nicheyCollectionSwatchesV1 = true;
      document.addEventListener('click', function (e) {
        if (!(e.target instanceof Element)) return;
        var swatch = e.target.closest('.ncv-swatch');
        if (swatch) {
          e.preventDefault();
          var card = swatch.closest('[data-ncv-card]');
          var add = card.querySelector('.css-atc');
          if (!add || add.getAttribute('aria-busy') === 'true') return;
          e.stopPropagation();
          card.querySelectorAll('.ncv-swatch').forEach(function (item) {
            item.setAttribute('aria-pressed', item === swatch ? 'true' : 'false');
          });
          var variantInput = card.querySelector('.css-atc-form input[name="id"]');
          if (!variantInput) return;
          variantInput.value = swatch.dataset.id;
          var available = swatch.dataset.available === 'true';
          var arabic = document.documentElement.lang.indexOf('ar') === 0;
          add.disabled = !available;
          add.setAttribute('aria-label', available ? (arabic ? 'أضف إلى السلة' : 'Add to cart') : (arabic ? 'غير متاح' : 'Sold out'));
          add.title = add.getAttribute('aria-label');
          card.querySelector('.ncv-variant-label').textContent = swatch.dataset.title + (available ? '' : (arabic ? ' — غير متاح' : ' — Sold out'));
          card.querySelector('.css-new-price').textContent = swatch.dataset.price;
          var oldPrice = card.querySelector('.css-old-price');
          oldPrice.textContent = swatch.dataset.compare;
          oldPrice.hidden = !swatch.dataset.compare;
          var badge = card.querySelector('.css-discount');
          badge.textContent = '-' + swatch.dataset.discount + '%';
          badge.hidden = !swatch.dataset.compare;
          var picture = card.querySelector('.css-image-link img');
          if (picture && swatch.dataset.image) {
            picture.srcset = swatch.dataset.srcset;
            picture.src = swatch.dataset.image;
          }
          card.querySelectorAll('.css-image-link, .css-title').forEach(function (link) {
            link.href = swatch.dataset.url;
          });
          return;
        }

      }, true);
    })();


</script>
<script>
  (function() {
    const sectionSelector = '#shopify-section-{{ section.id }}';
    const bodyOpenClass = 'nichey-filter-is-open-{{ section.id }}';
    let submitTimer;

    function getSection() {
      return document.querySelector(sectionSelector);
    }

    function getForm(section) {
      return section ? section.querySelector('#NicheyFilters-{{ section.id }}') : null;
    }

    function closeSortDropdown(section) {
      if (!section) return;

      const sortDetails = section.querySelector('.nichey-sort-details');

      if (sortDetails && sortDetails.open) {
        sortDetails.removeAttribute('open');
      }
    }

    function openFilter(section) {
      if (!section) return;

      const sidebar = section.querySelector('[data-nichey-filter-sidebar]');
      const overlay = section.querySelector('[data-nichey-filter-close]');

      if (!sidebar || !overlay) return;

      closeSortDropdown(section);

      sidebar.classList.add('is-open');
      overlay.classList.add('is-open');

      document.body.classList.add(bodyOpenClass);
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    }

    function closeFilter(section) {
      section = section || getSection();

      if (!section) return;

      const sidebar = section.querySelector('[data-nichey-filter-sidebar]');
      const overlay = section.querySelector('[data-nichey-filter-close]');

      if (!sidebar || !overlay) return;

      sidebar.classList.remove('is-open');
      overlay.classList.remove('is-open');

      document.body.classList.remove(bodyOpenClass);
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    }

    function submitFilters(form) {
      if (!form) return;

      clearTimeout(submitTimer);

      submitTimer = setTimeout(function() {
        form.submit();
      }, 350);
    }

    function updatePriceSlider(priceFilter) {
      if (!priceFilter) return;

      const minRange = priceFilter.querySelector('[data-range-min]');
      const maxRange = priceFilter.querySelector('[data-range-max]');
      const minInput = priceFilter.querySelector('[data-price-min]');
      const maxInput = priceFilter.querySelector('[data-price-max]');
      const track = priceFilter.querySelector('[data-price-track]');

      if (!minRange || !maxRange || !minInput || !maxInput || !track) return;

      const maxLimit = Number(maxRange.max) || 100;
      let minVal = Number(minRange.value) || 0;
      let maxVal = Number(maxRange.value) || maxLimit;

      if (minVal > maxVal - 1) {
        minVal = maxVal - 1;
        minRange.value = minVal;
      }

      if (maxVal < minVal + 1) {
        maxVal = minVal + 1;
        maxRange.value = maxVal;
      }

      const left = (minVal / maxLimit) * 100;
      const right = 100 - ((maxVal / maxLimit) * 100);

      track.style.left = left + '%';
      track.style.right = right + '%';

      minInput.value = minVal;
      maxInput.value = maxVal;
    }

    function syncNumberToRange(priceFilter) {
      if (!priceFilter) return;

      const minRange = priceFilter.querySelector('[data-range-min]');
      const maxRange = priceFilter.querySelector('[data-range-max]');
      const minInput = priceFilter.querySelector('[data-price-min]');
      const maxInput = priceFilter.querySelector('[data-price-max]');

      if (!minRange || !maxRange || !minInput || !maxInput) return;

      minRange.value = minInput.value || 0;
      maxRange.value = maxInput.value || maxRange.max;

      updatePriceSlider(priceFilter);
    }

    function initPriceSliders() {
      const section = getSection();

      if (!section) return;

      section.querySelectorAll('[data-price-filter]').forEach(function(priceFilter) {
        updatePriceSlider(priceFilter);
      });
    }

    function fixPaginationDots(section) {
      if (!section) return;

      section.querySelectorAll('.nichey-pagination a, .nichey-pagination span, .nichey-pagination button').forEach(function(item) {
        const text = item.textContent.trim();

        if (text === '...' || text === '…') {
          item.classList.add('nichey-pagination-dots-fix');
          item.classList.remove('current', 'active', 'is-active', 'hdt-current', 'hdt-pagination__item--current', 'pagination__item--current');
          item.removeAttribute('aria-current');
        }
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      const section = getSection();

      initPriceSliders();
      fixPaginationDots(section);
    });

    document.addEventListener('shopify:section:load', function() {
      const section = getSection();

      initPriceSliders();
      fixPaginationDots(section);
    });

    document.addEventListener('click', function(event) {
      const section = getSection();

      if (!section) return;

      const clearButton = event.target.closest('[data-nichey-clear-filters], .nichey-clear-real-btn');

      if (clearButton && section.contains(clearButton)) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();

        const href = clearButton.getAttribute('data-clear-url') || clearButton.getAttribute('href') || '{{ collection.url }}';

        window.location.href = href;
        return;
      }

      const paginationLink = event.target.closest('.nichey-pagination a[href]');

      if (paginationLink && section.contains(paginationLink)) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();

        window.location.href = paginationLink.href;
        return;
      }

      const openButton = event.target.closest('[data-nichey-filter-open]');

      if (openButton && section.contains(openButton)) {
        event.preventDefault();
        event.stopPropagation();

        openFilter(section);
        return;
      }

      const closeButton = event.target.closest('[data-nichey-filter-close]');

      if (closeButton && section.contains(closeButton)) {
        event.preventDefault();
        event.stopPropagation();

        closeFilter(section);
        return;
      }

      const sortDetails = section.querySelector('.nichey-sort-details');

      if (sortDetails && sortDetails.open && !sortDetails.contains(event.target)) {
        closeSortDropdown(section);
      }
    }, true);

    document.addEventListener('selectstart', function(event) {
      const section = getSection();

      if (!section) return;

      if (
        section.contains(event.target) &&
        (
          event.target.closest('.nichey-filter-panel-header') ||
          event.target.closest('.nichey-clear-real-btn') ||
          event.target.closest('.nichey-collection-title')
        )
      ) {
        event.preventDefault();
      }
    });

    document.addEventListener('keydown', function(event) {
      const section = getSection();

      if (!section) return;

      const clearButton = event.target.closest('[data-nichey-clear-filters], .nichey-clear-real-btn');

      if (clearButton && section.contains(clearButton) && (event.key === 'Enter' || event.key === ' ')) {
        event.preventDefault();
        event.stopPropagation();

        const href = clearButton.getAttribute('data-clear-url') || clearButton.getAttribute('href') || '{{ collection.url }}';

        window.location.href = href;
        return;
      }

      if (event.key === 'Escape') {
        closeFilter(section);
        closeSortDropdown(section);
      }
    });

    document.addEventListener('input', function(event) {
      const section = getSection();

      if (!section || !section.contains(event.target)) return;

      const priceFilter = event.target.closest('[data-price-filter]');

      if (!priceFilter) return;

      if (event.target.matches('[data-range-min], [data-range-max]')) {
        updatePriceSlider(priceFilter);
      }
    });

    document.addEventListener('change', function(event) {
      const section = getSection();

      if (!section || !section.contains(event.target)) return;

      const form = getForm(section);

      if (!form) return;

      if (event.target.matches('input[type="checkbox"]')) {
        const label = event.target.closest('.nichey-filter-check');

        if (label) {
          label.classList.toggle('is-active', event.target.checked);
        }

        submitFilters(form);
        return;
      }

      const priceFilter = event.target.closest('[data-price-filter]');

      if (priceFilter && event.target.matches('[data-range-min], [data-range-max]')) {
        updatePriceSlider(priceFilter);
        submitFilters(form);
        return;
      }

      if (priceFilter && event.target.matches('[data-price-min], [data-price-max]')) {
        syncNumberToRange(priceFilter);
        submitFilters(form);
      }
    });

    window.addEventListener('scroll', function() {
      const section = getSection();

      if (!section) return;

      closeSortDropdown(section);
    }, { passive: true });

    const section = getSection();
    initPriceSliders();
    fixPaginationDots(section);
  })();
</script>

{% schema %}
{
  "name": "Collection page",
  "class": "hdt-main-section hdt-main-section__collection",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description collection",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "use_read_more",
      "label": "Use read more",
      "default": false
    },
    {
      "type": "range",
      "id": "read_more_height",
      "label": "Read more height",
      "min": 100,
      "max": 1000,
      "step": 10,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "description_position",
      "label": "Position description collection",
      "options": [
        {
          "value": "before",
          "label": "Before main collection"
        },
        {
          "value": "after",
          "label": "After main collection"
        }
      ],
      "default": "before"
    },
    {
      "type": "header",
      "content": "Product layout"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 1,
      "max": 50,
      "step": 1,
      "label": "Maximum items to show",
      "default": 24
    },
    {
      "type": "select",
      "id": "col_dk",
      "label": "Items per row (Desktop)",
      "default": "5",
      "options": [
        {
          "label": "3",
          "value": "3"
        },
        {
          "label": "4",
          "value": "4"
        },
        {
          "label": "5",
          "value": "5"
        },
        {
          "label": "6",
          "value": "6"
        }
      ]
    },
    {
      "type": "select",
      "id": "col_tb",
      "label": "Items per row (Tablet)",
      "default": "3",
      "options": [
        {
          "label": "2",
          "value": "2"
        },
        {
          "label": "3",
          "value": "3"
        },
        {
          "label": "4",
          "value": "4"
        }
      ]
    },
    {
      "type": "select",
      "id": "col_mb",
      "label": "Items per row (Mobile)",
      "default": "2",
      "options": [
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        }
      ]
    },
    {
      "type": "header",
      "content": "Pagination products"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "Pagination type",
      "options": [
        {
          "value": "default",
          "label": "Default pagination"
        },
        {
          "value": "load_more",
          "label": "Load more button"
        },
        {
          "value": "infinite",
          "label": "Infinite scrolling"
        }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    }
  ]
}
