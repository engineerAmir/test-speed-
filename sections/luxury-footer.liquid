<script>
(function() {
  document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('LuxNewsletterForm');
    if (form) {
      form.addEventListener('submit', function(e) {
        var check = document.getElementById('lux-consent-check');
        if (check && !check.checked) {
          e.preventDefault();
          check.style.outline = '2px solid red';
          return false;
        }
      });
    }
  });

  function initPetals() {
    var banners = document.querySelectorAll('.lux-banner');
    banners.forEach(function(banner) {
      var canvas = banner.querySelector('.lux-petals-canvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var petals = [];
      var count = 18;
      function resize() {
        canvas.width = banner.offsetWidth;
        canvas.height = banner.offsetHeight;
      }
      resize();
      window.addEventListener('resize', resize);
      var petalShapes = [
        function(ctx, size) { ctx.beginPath(); ctx.ellipse(0, 0, size * 0.5, size, 0, 0, Math.PI * 2); ctx.fill(); },
        function(ctx, size) { ctx.beginPath(); ctx.ellipse(0, 0, size * 0.4, size * 0.9, 0, 0, Math.PI * 2); ctx.fill(); }
      ];
      var colors = [
        'rgba(255, 182, 193, 0.7)',
        'rgba(255, 160, 180, 0.65)',
        'rgba(255, 192, 210, 0.7)',
        'rgba(250, 150, 175, 0.6)',
        'rgba(255, 210, 225, 0.75)'
      ];
      function createPetal() {
        return {
          x: Math.random() * canvas.width,
          y: -20 - Math.random() * 80,
          size: 6 + Math.random() * 7,
          speedY: 0.4 + Math.random() * 0.5,
          speedX: -0.3 + Math.random() * 0.6,
          rotation: Math.random() * Math.PI * 2,
          rotSpeed: (Math.random() - 0.5) * 0.012,
          color: colors[Math.floor(Math.random() * colors.length)],
          shape: Math.floor(Math.random() * petalShapes.length),
          sway: Math.random() * Math.PI * 2,
          swaySpeed: 0.008 + Math.random() * 0.008,
          swayAmount: 0.3 + Math.random() * 0.4
        };
      }
      for (var i = 0; i < count; i++) {
        var p = createPetal();
        p.y = Math.random() * canvas.height;
        petals.push(p);
      }
      function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        petals.forEach(function(p, idx) {
          p.sway += p.swaySpeed;
          p.x += p.speedX + Math.sin(p.sway) * p.swayAmount;
          p.y += p.speedY;
          p.rotation += p.rotSpeed;
          if (p.y > canvas.height + 20) { petals[idx] = createPetal(); }
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rotation);
          ctx.fillStyle = p.color;
          petalShapes[p.shape](ctx, p.size);
          ctx.restore();
        });
        requestAnimationFrame(animate);
      }
      animate();
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPetals);
  } else {
    initPetals();
  }
})();
</script>

