    {% comment %} {%- section 'product-card-configs' -%} {% endcomment %}

{%- unless template == 'product.only_config' and request.design_mode == false -%}
  {%- if request.page_type == "index" -%}
    <h1 class="hdt-hidden">{{ page_title | default: shop.name }}</h1>
  {%- endif -%}
  {%- render 's-dom-temp' -%}
  <a class="skip-to-content-link button sr-only" href="#MainContent">
    {{ 'accessibility.skip_to_text' | t }}
  </a>
  {%- sections 'header-group' -%}
{%- endunless -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
      {%- if template.suffix == 'only_config' -%}
        {%- section 'color-swatch' -%}
      {%- endif -%}
    </main>

    {%- unless template == 'product.only_config' and request.design_mode == false -%}
    <footer>
      {%- sections 'footer-group' -%}
    </footer>
    {%- liquid
      sections 'system-group'
      if settings.enable_compare_popup
        render 'compare-offcanvas'
      endif
      render 'system-bottom'
      if settings.custom_html_footer != blank
        echo settings.custom_html_footer
      endif
      render 'structured-data'
    -%}
   {%- endunless -%}
   <script>
  document.addEventListener("DOMContentLoaded", function () {
    // استثناء الصور الخاصة بالسلايدر، البراندات، والـ Carousel
    const images = document.querySelectorAll("img:not(.slider *):not(.carousel *):not([class*='brand']):not([class*='logo'])");

    images.forEach((img) => {
      if (!img.hasAttribute("width") || !img.hasAttribute("height")) {
        if (img.complete) {
          setAttributeValues(img);
        } else {
          img.addEventListener("load", function () {
            setAttributeValues(img);
          });
        }
      }
    });

    function setAttributeValues(img) {
      // إسناد الأبعاد فقط إذا كانت أبعاد الصورة الطبيعية أكبر من 10 بكسل
      if (img.naturalWidth > 10 && img.naturalHeight > 10) {
        img.setAttribute("width", img.naturalWidth);
        img.setAttribute("height", img.naturalHeight);
      }
    }
  });
</script>
