{% doc %}
  @prompt
    Create a premium editorial blog hero section for a luxury beauty and skincare brand called NICHEY.
    
    Layout requirements:
    
    * Center aligned content.
    * Small eyebrow text above the title: "BEAUTY JOURNAL".
    * Large prominent heading: "NICHEY BEAUTY BLOG".
    * Short subtitle: "Expert skincare guides, makeup tips, brand reviews, and beauty trends."
    * Thin horizontal divider below the subtitle.
    * Maximum content width: 700px.
    * White background.
    * No banner image.
    * No buttons.
    * Generous spacing but avoid excessive empty space.
    
    Typography:
    
    * Heading should be the visual focal point.
    * Large title size (40-48px desktop).
    * Medium weight luxury typography.
    * Subtitle should be highly readable with softer gray color.
    * Elegant letter spacing for the eyebrow text.
    
    Spacing:
    
    * Top padding: 80px.
    * Bottom padding: 50px.
    * Balanced vertical spacing between all elements.
    
    Style:
    
    * Premium beauty editorial aesthetic.
    * Inspired by high-end skincare brands, beauty magazines, Sephora editorial pages, and luxury cosmetics websites.
    * Minimal, elegant, modern, clean, and sophisticated.
    * Focus on typography and whitespace.
    * Fully responsive on mobile and desktop.
    
    Below the hero section, add a horizontal category filter navigation with pill-style tabs:
    
    All Articles | Skincare | Makeup | Hair Care | Body Care | Brands
    
    The active category should have a subtle beige background matching the Nichey brand aesthetic.
    
{% enddoc %}
{%- liquid
  assign ai_gen_id = block.id | replace: '_', '' | downcase
  assign active_blog_tag = current_tags | first
  assign active_blog_tag_handle = active_blog_tag | handleize
  assign dynamic_heading = block.settings.heading_text

  if active_blog_tag != blank
    assign formatted_blog_tag = active_blog_tag | replace: '-', ' ' | upcase
    assign dynamic_heading = 'NICHEY ' | append: formatted_blog_tag | append: ' BLOG'
  endif
-%}

{% style %}
  .ai-blog-hero-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .ai-blog-hero-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }

  .ai-blog-hero-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: {{ block.settings.eyebrow_weight }};
    letter-spacing: {{ block.settings.eyebrow_spacing }}px;
    text-transform: uppercase;
    color: {{ block.settings.eyebrow_color }};
    margin: 0 0 {{ block.settings.eyebrow_margin }}px 0;
  }

  .ai-blog-hero-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_mobile }}px;
    font-weight: {{ block.settings.heading_weight }};
    letter-spacing: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin }}px 0;
    line-height: 1.2;
  }

  .ai-blog-hero-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: {{ block.settings.subtitle_weight }};
    line-height: 1.6;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 {{ block.settings.subtitle_margin }}px 0;
  }

  .ai-blog-hero-divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_height }}px;
    background-color: {{ block.settings.divider_color }};
    margin: 0 auto;
  }

  .ai-blog-hero-categories-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.category_gap }}px;
    margin-top: {{ block.settings.categories_margin_top }}px;
    padding: 0 20px;
  }

  .ai-blog-hero-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_font_size }}px;
    font-weight: {{ block.settings.category_font_weight }};
    color: {{ block.settings.category_text_color }};
    background-color: {{ block.settings.category_bg_color }};
    padding: {{ block.settings.category_padding_vertical }}px {{ block.settings.category_padding_horizontal }}px;
    border-radius: {{ block.settings.category_border_radius }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: {{ block.settings.category_border_width }}px solid {{ block.settings.category_border_color }};
    white-space: nowrap;
  }

  .ai-blog-hero-category-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.category_hover_bg }};
    color: {{ block.settings.category_hover_text }};
    border-color: {{ block.settings.category_hover_border }};
  }

  .ai-blog-hero-category-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.category_active_bg }};
    color: {{ block.settings.category_active_text }};
    border-color: {{ block.settings.category_active_border }};
  }

  @media screen and (min-width: 750px) {
    .ai-blog-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }
{% endstyle %}

<blog-hero-{{ ai_gen_id }} class="ai-blog-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-hero-container-{{ ai_gen_id }}">
    {% if block.settings.eyebrow_text != blank %}
      <div class="ai-blog-hero-eyebrow-{{ ai_gen_id }}">
        {{ block.settings.eyebrow_text }}
      </div>
    {% endif %}

    {% if dynamic_heading != blank %}
      <h1 class="ai-blog-hero-heading-{{ ai_gen_id }}">
        {{ dynamic_heading }}
      </h1>
    {% endif %}

    {% if block.settings.subtitle_text != blank %}
      <div class="ai-blog-hero-subtitle-{{ ai_gen_id }}">
        {{ block.settings.subtitle_text }}
      </div>
    {% endif %}

    {% if block.settings.show_divider %}
      <div class="ai-blog-hero-divider-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>

  {% if block.settings.show_categories %}
    <div class="ai-blog-hero-categories-{{ ai_gen_id }}">
      {% assign categories = block.settings.categories | split: '|' %}
      {% for category in categories %}
        {% assign category_parts = category | split: ':' %}
        {% assign category_label = category_parts[0] | strip %}
        {% assign category_url = category_parts[1] | strip %}
        
        {% if category_label != blank %}

  {%- liquid
    assign active_class = ''
    assign category_handle = category_label | handleize

    if active_blog_tag == blank and category_handle == 'all-articles'
      assign active_class = ' active'
    elsif active_blog_tag != blank and active_blog_tag_handle == category_handle
      assign active_class = ' active'
    endif
  -%}

  <a
    href="{% if category_url != blank %}{{ category_url }}{% else %}#{% endif %}"
    class="ai-blog-hero-category-{{ ai_gen_id }}{{ active_class }}"
  >
    {{ category_label }}
  </a>

{% endif %}
      {% endfor %}
    </div>
  {% endif %}
</blog-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupCategoryNavigation();
      }

      setupCategoryNavigation() {
        const categories = this.querySelectorAll('.ai-blog-hero-category-{{ ai_gen_id }}');
        
        categories.forEach(category => {
          category.addEventListener('click', (e) => {
            if (category.getAttribute('href') === '#') {
              e.preventDefault();
            }
            
            categories.forEach(cat => cat.classList.remove('active'));
            category.classList.add('active');
          });
        });
      }
    }

    customElements.define('blog-hero-{{ ai_gen_id }}', BlogHero{{ ai_gen_id }});
  })();
</script>

