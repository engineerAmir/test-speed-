<nav aria-label="{{ section.settings.nav_label | escape }}"><ol class="ny-breadcrumbs" role="list"><li><a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a></li>{% for block in section.blocks %}{% if block.settings.label != blank and block.settings.url != blank %}<li {{ block.shopify_attributes }}><span class="ny-crumb-separator" aria-hidden="true">{% render 'nichey-icon', settings: section.settings, name: 'arrow' %}</span><a href="{{ block.settings.url }}">{% render 'nichey-icon', settings: block.settings %}{{ block.settings.label | escape }}</a></li>{% endif %}{% endfor %}{% if collection != blank %}<li><span class="ny-crumb-separator" aria-hidden="true">{% render 'nichey-icon', settings: section.settings, name: 'arrow' %}</span><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>{% endif %}<li><span class="ny-crumb-separator" aria-hidden="true">{% render 'nichey-icon', settings: section.settings, name: 'arrow' %}</span><span aria-current="page">{{ product.title | escape }}</span></li></ol></nav>
