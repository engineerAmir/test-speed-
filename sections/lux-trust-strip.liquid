{% comment %}
  Lux Trust Strip
  - كل عنصر (صورة + عنوان + وصف) عبارة عن Block تقدر تضيفه/تمسحه/ترتبه.
  - Option لتحويل العناصر لسلايدر بيلف بشكل لا نهائي (Infinite loop).
{% endcomment %}

<section
  class="lux-trust"
  data-lux-trust
  data-slider="{{ section.settings.enable_slider }}"
  data-slider-devices="{{ section.settings.slider_devices }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
  data-cols-desktop="{{ section.settings.columns_desktop }}"
  data-cols-mobile="{{ section.settings.columns_mobile }}"
  {% if section.settings.aria_label != blank %}aria-label="{{ section.settings.aria_label | escape }}"{% endif %}
  style="
    --lt-cols-d: {{ section.settings.columns_desktop }};
    --lt-cols-m: {{ section.settings.columns_mobile }};
    --lt-max: {{ section.settings.max_width }}px;
    --lt-pt: {{ section.settings.padding_top }}px;
    --lt-pb: {{ section.settings.padding_bottom }}px;
    --lt-icon: {{ section.settings.icon_color }};
    --lt-icon-bg: {{ section.settings.icon_bg }};
    --lt-title: {{ section.settings.title_color }};
    --lt-sub: {{ section.settings.subtitle_color }};
    --lt-accent: {{ section.settings.accent_color }};
    --lt-gold: {{ section.settings.gold_color }};
    --lt-featured-sub: {{ section.settings.featured_sub_color }};
  "
>
  <div class="lux-trust-viewport">
    <div class="lux-trust-track">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }}
          class="lux-trust-item{% if block.settings.featured %} lux-trust-featured{% endif %}"
          {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.icon_image != blank -%}
            <div class="lux-trust-icon" aria-hidden="true">
              {{ block.settings.icon_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
            </div>
          {%- endif -%}

          {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
            <div class="lux-trust-copy">
              {%- if block.settings.title != blank -%}
                <strong>{{ block.settings.title }}</strong>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <span>{{ block.settings.subtitle }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.show_dots -%}
    <div class="lux-trust-dots" role="group" aria-label="{{ section.settings.aria_label | escape }}"></div>
  {%- endif -%}
</section>

{% stylesheet %}
.lux-trust,
.lux-trust * {
  box-sizing: border-box;
}

.lux-trust {
  max-width: var(--lt-max, 1500px);
  width: calc(100% - 90px);
  margin: 0 auto;
  padding: var(--lt-pt, 34px) 0 var(--lt-pb, 28px);
}

.lux-trust-viewport {
  position: relative;
}

/* ---------- Grid mode (default) ---------- */
.lux-trust-track {
  display: grid;
  grid-template-columns: repeat(var(--lt-cols-d, 4), minmax(0, 1fr));
  gap: 34px;
  align-items: start;
}

.lux-trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  text-align: center;
  gap: 10px;
  min-width: 0;
  padding: 0 8px;
  color: var(--lt-title, #1a1a1a);
  text-decoration: none;
}

.lux-trust-icon {
  width: 60px;
  height: 60px;
  min-width: 60px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--lt-icon, #1a1a1a);
  background: var(--lt-icon-bg, #f7f5f0);
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.95) inset, 0 10px 24px rgba(26, 26, 26, 0.06);
}

.lux-trust-icon img {
  width: 25px;
  height: 25px;
  display: block;
  object-fit: contain;
}

.lux-trust-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  min-width: 0;
  max-width: 190px;
  line-height: 1.25;
}

.lux-trust-copy strong {
  margin: 0;
  font-size: 15px;
  line-height: 1.25;
  font-weight: 800;
  color: var(--lt-title, #1a1a1a);
  letter-spacing: 0.01em;
}

.lux-trust-copy span {
  margin: 0;
  font-size: 12px;
  line-height: 1.45;
  font-weight: 500;
  color: var(--lt-sub, #666);
}

/* Featured (highlight) */
.lux-trust-featured .lux-trust-icon {
  color: var(--lt-accent, #7c3030);
  background: linear-gradient(135deg, rgba(255, 249, 232, 0.96), rgba(244, 229, 188, 0.94));
  box-shadow: 0 0 0 1px var(--lt-gold, #d4af37) inset, 0 14px 32px rgba(124, 48, 48, 0.12);
}

.lux-trust-featured .lux-trust-copy strong {
  color: var(--lt-accent, #7c3030);
}

.lux-trust-featured .lux-trust-copy span {
  color: var(--lt-featured-sub, #9a7424);
  font-weight: 700;
}

.lux-trust-featured .lux-trust-copy::after {
  content: "";
  width: 58px;
  height: 2px;
  margin-top: 6px;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, var(--lt-gold, #d4af37), transparent);
}

/* ---------- Slider mode (class added by JS) ---------- */
.lux-trust-dots {
  display: none;
  justify-content: center;
  gap: 8px;
  margin-top: 14px;
}

.lux-trust.is-slider .lux-trust-dots {
  display: flex;
}

.lux-trust-dots button {
  width: 8px;
  height: 8px;
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: rgba(26, 26, 26, 0.2);
  cursor: pointer;
  transition: width 0.25s ease, background 0.25s ease;
}

.lux-trust-dots button[aria-current="true"] {
  width: 22px;
  background: var(--lt-accent, #7c3030);
}

.lux-trust.is-slider .lux-trust-viewport {
  overflow: hidden;
  padding-bottom: 24px;
  margin-bottom: -24px;
  touch-action: pan-y;
}

.lux-trust.is-slider .lux-trust-track {
  display: flex;
  gap: 0;
  will-change: transform;
}

.lux-trust.is-slider .lux-trust-item {
  flex: 0 0 calc(100% / var(--lt-per-view, 2));
  padding: 0 12px;
}

/* ---------- Responsive ---------- */
@media (max-width: 900px) {
  .lux-trust {
    width: calc(100% - 32px);
  }

  .lux-trust-track {
    grid-template-columns: repeat(var(--lt-cols-m, 2), minmax(0, 1fr));
    gap: 24px 16px;
  }

  .lux-trust-item {
    gap: 8px;
    padding: 0 4px;
  }

  .lux-trust-icon {
    width: 52px;
    height: 52px;
    min-width: 52px;
  }

  .lux-trust-icon img {
    width: 22px;
    height: 22px;
  }

  .lux-trust-copy {
    max-width: 160px;
    gap: 4px;
  }

  .lux-trust-copy strong {
    font-size: 13px;
  }

  .lux-trust-copy span {
    font-size: 11px;
    line-height: 1.4;
  }

  .lux-trust.is-slider .lux-trust-track {
    gap: 0;
  }
}

@media (max-width: 480px) {
  .lux-trust {
    width: calc(100% - 24px);
  }

  .lux-trust-track {
    gap: 20px 12px;
  }

  .lux-trust-icon {
    width: 48px;
    height: 48px;
    min-width: 48px;
  }

  .lux-trust-icon img {
    width: 20px;
    height: 20px;
  }

  .lux-trust-copy {
    max-width: 145px;
  }

  .lux-trust-copy strong {
    font-size: 12px;
  }

  .lux-trust-copy span {
    font-size: 10px;
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  var MOBILE_QUERY = '(max-width: 900px)';

  function debounce(fn, wait) {
    var t;
    return function () {
      clearTimeout(t);
      t = setTimeout(fn, wait);
    };
  }

  function LuxTrust(root) {
    var self = this;
    this.root = root;
    this.viewport = root.querySelector('.lux-trust-viewport');
    this.track = root.querySelector('.lux-trust-track');
    this.dotsWrap = root.querySelector('.lux-trust-dots');
    this.count = this.track.children.length;

    this.wantSlider = root.getAttribute('data-slider') === 'true';
    this.devices = root.getAttribute('data-slider-devices') || 'mobile';
    this.reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    this.autoplay = root.getAttribute('data-autoplay') === 'true' && !this.reduceMotion;
    this.speed = (parseInt(root.getAttribute('data-speed'), 10) || 4) * 1000;
    this.colsDesktop = parseInt(root.getAttribute('data-cols-desktop'), 10) || 4;
    this.colsMobile = parseInt(root.getAttribute('data-cols-mobile'), 10) || 2;

    this.active = false;
    this.locked = false;
    this.paused = false;
    this.index = 0;
    this.perView = 1;
    this.rtl = false;
    this.timer = null;
    this.fallback = null;
    this.startX = null;
    this.startY = null;

    this.onResize = debounce(function () { self.setup(); }, 150);
    this.onTransitionEnd = function (e) {
      if (e.target === self.track && e.propertyName === 'transform') self.normalize();
    };

    window.addEventListener('resize', this.onResize);
    this.track.addEventListener('transitionend', this.onTransitionEnd);

    root.addEventListener('mouseenter', function () { self.paused = true; });
    root.addEventListener('mouseleave', function () { self.paused = false; });
    root.addEventListener('focusin', function () { self.paused = true; });
    root.addEventListener('focusout', function () { self.paused = false; });

    this.viewport.addEventListener('pointerdown', function (e) {
      self.startX = e.clientX;
      self.startY = e.clientY;
    });
    this.viewport.addEventListener('pointerup', function (e) {
      if (!self.active || self.startX === null) return;
      var dx = e.clientX - self.startX;
      var dy = e.clientY - self.startY;
      self.startX = null;
      if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
      var forward = self.rtl ? dx > 0 : dx < 0;
      self.step(forward ? 1 : -1);
    });

    this.visible = false;
    this.motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    this.onVisibility = function () { self.startAutoplay(); };
    this.visibilityObserver = new IntersectionObserver(function (entries) {
      self.visible = entries[0].isIntersecting;
      self.startAutoplay();
    });
    this.visibilityObserver.observe(root);
    document.addEventListener('visibilitychange', this.onVisibility);
    this.motion.addEventListener('change', this.onVisibility);
    this.setup();
  }

  LuxTrust.prototype.teardown = function () {
    this.stopAutoplay();
    clearTimeout(this.fallback);
    var clones = this.track.querySelectorAll('.is-clone');
    for (var i = 0; i < clones.length; i++) clones[i].parentNode.removeChild(clones[i]);
    this.track.style.transform = '';
    this.track.style.transition = '';
    this.root.classList.remove('is-slider');
    if (this.dotsWrap) this.dotsWrap.innerHTML = '';
    this.active = false;
    this.locked = false;
  };

  LuxTrust.prototype.makeClone = function (node) {
    var clone = node.cloneNode(true);
    clone.classList.add('is-clone');
    clone.setAttribute('aria-hidden', 'true');
    clone.removeAttribute('data-shopify-editor-block');
    if (clone.tagName === 'A') clone.tabIndex = -1;
    return clone;
  };

  LuxTrust.prototype.setup = function () {
    this.teardown();

    var mobile = window.matchMedia(MOBILE_QUERY).matches;
    this.perView = mobile ? this.colsMobile : this.colsDesktop;

    var allowed = this.wantSlider && (this.devices === 'all' || mobile);
    if (!allowed || this.count <= this.perView) return;

    var n = this.perView;
    var originals = Array.prototype.slice.call(this.track.children);
    var i;

    this.rtl = window.getComputedStyle(this.root).direction === 'rtl';

    var head = document.createDocumentFragment();
    for (i = this.count - n; i < this.count; i++) head.appendChild(this.makeClone(originals[i]));
    this.track.insertBefore(head, this.track.firstChild);

    for (i = 0; i < n; i++) this.track.appendChild(this.makeClone(originals[i]));

    this.root.style.setProperty('--lt-per-view', n);
    this.root.classList.add('is-slider');
    this.active = true;
    this.index = n;
    this.buildDots();
    this.move(false);
    this.startAutoplay();
  };

  LuxTrust.prototype.move = function (animate) {
    var w = this.viewport.clientWidth / this.perView;
    var dir = this.rtl ? 1 : -1;
    this.track.style.transition = animate ? 'transform 600ms cubic-bezier(.22,.61,.36,1)' : 'none';
    if (!animate) void this.track.offsetWidth;
    this.track.style.transform = 'translate3d(' + (dir * this.index * w) + 'px,0,0)';
    this.updateDots();
  };

  LuxTrust.prototype.step = function (delta) {
    if (!this.active || this.locked) return;
    var self = this;
    this.locked = true;
    this.index += delta;
    this.move(true);
    clearTimeout(this.fallback);
    this.fallback = setTimeout(function () { self.normalize(); }, 750);
  };

  LuxTrust.prototype.normalize = function () {
    if (!this.active || !this.locked) return;
    clearTimeout(this.fallback);
    var n = this.perView;
    var c = this.count;
    var changed = false;
    if (this.index >= n + c) { this.index -= c; changed = true; }
    else if (this.index < n) { this.index += c; changed = true; }
    if (changed) this.move(false);
    this.locked = false;
  };

  LuxTrust.prototype.goTo = function (i) {
    var delta = this.perView + i - this.index;
    if (delta !== 0) this.step(delta);
  };

  LuxTrust.prototype.buildDots = function () {
    if (!this.dotsWrap) return;
    var self = this;
    this.dotsWrap.innerHTML = '';
    for (var i = 0; i < this.count; i++) {
      (function (i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', (i + 1) + ' / ' + self.count);
        b.addEventListener('click', function () {
          self.goTo(i);
          self.stopAutoplay();
          self.startAutoplay();
        });
        self.dotsWrap.appendChild(b);
      })(i);
    }
  };

  LuxTrust.prototype.updateDots = function () {
    if (!this.dotsWrap || !this.dotsWrap.children.length) return;
    var c = this.count;
    var real = (((this.index - this.perView) % c) + c) % c;
    for (var i = 0; i < this.dotsWrap.children.length; i++) {
      this.dotsWrap.children[i].setAttribute('aria-current', i === real ? 'true' : 'false');
    }
  };

  LuxTrust.prototype.startAutoplay = function () {
    var self = this;
    this.stopAutoplay();
    if (!this.autoplay || !this.active || !this.visible || document.hidden || this.motion.matches) return;
    this.timer = setInterval(function () {
      if (!self.paused && !document.hidden) self.step(1);
    }, this.speed);
  };

  LuxTrust.prototype.stopAutoplay = function () {
    clearInterval(this.timer);
    this.timer = null;
  };

  LuxTrust.prototype.destroy = function () {
    this.visibilityObserver.disconnect();
    document.removeEventListener('visibilitychange', this.onVisibility);
    this.motion.removeEventListener('change', this.onVisibility);
    this.teardown();
    window.removeEventListener('resize', this.onResize);
    this.track.removeEventListener('transitionend', this.onTransitionEnd);
  };

  function init(scope) {
    var roots = (scope || document).querySelectorAll('[data-lux-trust]');
    for (var i = 0; i < roots.length; i++) {
      if (!roots[i]._luxTrust) roots[i]._luxTrust = new LuxTrust(roots[i]);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { init(); });
  } else {
    init();
  }

  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
  document.addEventListener('shopify:section:unload', function (e) {
    var r = e.target.querySelector('[data-lux-trust]');
    if (r && r._luxTrust) { r._luxTrust.destroy(); r._luxTrust = null; }
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Trust Strip",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "aria_label", "label": "Accessibility label", "default": "Shopping benefits" },
    { "type": "range", "id": "columns_desktop", "label": "Items per row (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_mobile", "label": "Items per row (mobile)", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 1000, "max": 1800, "step": 50, "unit": "px", "default": 1500 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 28 },

    { "type": "header", "content": "Slider" },
    { "type": "paragraph", "content": "The slider only runs when you have more items than fit in one row (see 'Items per row')." },
    { "type": "checkbox", "id": "enable_slider", "label": "Enable slider (infinite loop)", "default": false },
    {
      "type": "select",
      "id": "slider_devices",
      "label": "Use slider on",
      "default": "mobile",
      "options": [
        { "value": "mobile", "label": "Mobile only" },
        { "value": "all", "label": "All devices" }
      ]
    },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay delay", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4 },
    { "type": "checkbox", "id": "show_dots", "label": "Show dots", "default": true },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "icon_color", "label": "Icon", "default": "#1a1a1a" },
    { "type": "color", "id": "icon_bg", "label": "Icon background", "default": "#f7f5f0" },
    { "type": "color", "id": "title_color", "label": "Title", "default": "#1a1a1a" },
    { "type": "color", "id": "subtitle_color", "label": "Subtitle", "default": "#666666" },
    { "type": "color", "id": "accent_color", "label": "Highlight accent", "default": "#7c3030" },
    { "type": "color", "id": "gold_color", "label": "Highlight border / line", "default": "#d4af37" },
    { "type": "color", "id": "featured_sub_color", "label": "Highlight subtitle", "default": "#9a7424" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon image", "info": "PNG/WebP, square, 120x120px or larger." },
        { "type": "text", "id": "title", "label": "Title", "default": "Original Products" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Authentic Korean products" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "checkbox", "id": "featured", "label": "Highlight this item", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Strip",
      "blocks": [
        {
          "type": "item",
          "settings": { "title": "Original Products", "subtitle": "Authentic Korean products", "featured": true }
        },
        {
          "type": "item",
          "settings": { "title": "Fast Delivery", "subtitle": "Within 48 hours in Cairo" }
        },
        {
          "type": "item",
          "settings": { "title": "Free Shipping Over 1500 EGP", "subtitle": "Free shipping for a limited time" }
        },
        {
          "type": "item",
          "settings": { "title": "Secure Payments", "subtitle": "100% protected checkout" }
        }
      ]
    }
  ]
}
{% endschema %}