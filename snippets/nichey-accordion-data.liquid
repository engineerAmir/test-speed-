{% doc %}
  Reuse existing product fields and headed description content in one accordion.
  @param {product} product - Current product
  @param {section} section - Existing accordion section
{% enddoc %}
{%- assign rendered_sources = '|' -%}
{%- capture accordion_items -%}
  {%- for block in section.blocks -%}
    {%- assign source_key = block.settings.source | prepend: '|' | append: '|' -%}
    {%- unless rendered_sources contains source_key -%}
      {%- render 'nichey-info-panel', product: product, section: section, source: block.settings.source, block: block -%}
      {%- assign rendered_sources = rendered_sources | append: block.settings.source | append: '|' -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- comment -%}Extract existing editorial sections only; do not generate recommendations from benefits.{%- endcomment -%}
  {%- assign optional_sources = 'why,suitability,concerns,sensitive,frequency,pairing,faq' | split: ',' -%}
  {%- for source in optional_sources -%}
    {%- assign source_key = source | prepend: '|' | append: '|' -%}
    {%- unless rendered_sources contains source_key -%}
      {%- render 'nichey-info-panel', product: product, section: section, source: source -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign accordion_items = accordion_items | strip -%}
{%- if accordion_items != blank -%}<ny-info-accordions class="ny-published-accordion">{{ accordion_items }}</ny-info-accordions>{%- endif -%}
