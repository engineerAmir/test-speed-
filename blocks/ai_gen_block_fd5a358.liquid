{% doc %}
  Two editable promotional banners matching the supplied desktop/mobile references.
  Reference mode: entire pair occupies 50% of desktop viewport and 35% of the
  stable mobile viewport by default. Desktop: photo beside a black copy panel,
  then SHEGLAM below. Mobile: photo, black copy panel, then SHEGLAM.
  Text, links, colors, button styles and responsive images remain editable.
  Disable reference layout to use the previously supplied independent pixel heights.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-pair-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: {{ block.settings.desktop_height }}vh;
    overflow: hidden;
    margin: 0;
    padding: 0;
  }
  .ai-promo-pair-{{ ai_gen_id }}__banner {
    position: relative;
    display: flex;
    width: 100%;
    height: 50%;
    min-height: 0;
    overflow: hidden;
    margin: 0;
    padding: 0;
  }
  .ai-promo-pair-{{ ai_gen_id }}__image-side {
    position: relative;
    display: block;
    width: 52%;
    height: 100%;
    overflow: hidden;
    flex: 0 0 52%;
  }
  .ai-promo-pair-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ai-promo-pair-{{ ai_gen_id }}__mobile-image { display: none; }
  .ai-promo-pair-{{ ai_gen_id }}__first-content {
    display: flex;
    flex: 1 1 48%;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
    padding: {{ block.settings.content_padding }}px;
    background: #000000;
    color: {{ block.settings.first_text_color }};
    text-align: center;
  }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__heading {
    margin: 0;
    color: inherit;
    font-size: {{ block.settings.heading_size }}px !important;
    line-height: 1.05;
    letter-spacing: 0.04em;
  }
  .ai-promo-pair-{{ ai_gen_id }}__categories {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
  }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__category {
    color: inherit;
    font-size: {{ block.settings.category_size }}px !important;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
  }
  .ai-promo-pair-{{ ai_gen_id }}__category:focus-visible,
  .ai-promo-pair-{{ ai_gen_id }}__button:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 10px 22px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.button_size }}px !important;
    line-height: 1.2;
    border: 1px solid {{ block.settings.button_background }};
  }
  .ai-promo-pair-{{ ai_gen_id }}__second {
    align-items: center;
    justify-content: flex-start;
    background: #222;
  }
  .ai-promo-pair-{{ ai_gen_id }}__second-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ai-promo-pair-{{ ai_gen_id }}__second-overlay {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    width: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: {{ block.settings.content_gap }}px;
    padding: {{ block.settings.content_padding }}px;
    color: {{ block.settings.second_text_color }};
  }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second-heading { font-size: {{ block.settings.second_heading_size }}px !important; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__subtitle {
    margin: 0;
    color: inherit;
    font-size: {{ block.settings.subtitle_size }}px !important;
    letter-spacing: 0.12em;
  }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second .ai-promo-pair-{{ ai_gen_id }}__button {
    color: {{ block.settings.second_button_text }};
    background: {{ block.settings.second_button_background }};
    border-color: {{ block.settings.second_button_background }};
  }
  .ai-promo-pair-{{ ai_gen_id }}__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background: #e8e8e8;
  }
  .ai-promo-pair-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; }
  @media screen and (max-width: 749px) {
    .ai-promo-pair-{{ ai_gen_id }} { height: auto; overflow: visible; }
    .ai-promo-pair-{{ ai_gen_id }}__banner { height: auto; min-height: 0; }
    .ai-promo-pair-{{ ai_gen_id }}__first { flex-direction: column; }
    .ai-promo-pair-{{ ai_gen_id }}__image-side { width: 100%; height: auto; flex: 0 0 auto; }
    .ai-promo-pair-{{ ai_gen_id }}__desktop-image { display: none; }
    .ai-promo-pair-{{ ai_gen_id }}__mobile-image { display: block; width: 100%; height: auto; object-fit: contain; }
    .ai-promo-pair-{{ ai_gen_id }}__first-content { width: 100%; height: auto; flex: auto; padding: {{ block.settings.mobile_padding }}px; }
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__heading { font-size: {{ block.settings.mobile_heading_size }}px !important; }
    .ai-promo-pair-{{ ai_gen_id }}__second { min-height: 340px; }
    .ai-promo-pair-{{ ai_gen_id }}__second-image { height: 100%; }
    .ai-promo-pair-{{ ai_gen_id }}__second-image.ai-promo-pair-{{ ai_gen_id }}__mobile-image { position: absolute; object-fit: cover; }
    .ai-promo-pair-{{ ai_gen_id }}__second-overlay { min-height: 340px; padding: {{ block.settings.mobile_padding }}px; }
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second-heading { font-size: {{ block.settings.mobile_second_heading_size }}px !important; }
    .ai-promo-pair-{{ ai_gen_id }}__categories { gap: 10px 14px; }
  }

  /* Include padding in banner dimensions and keep the divider in the height budget. */
  .ai-promo-pair-{{ ai_gen_id }},
  .ai-promo-pair-{{ ai_gen_id }} * {
    box-sizing: border-box;
  }

  .ai-promo-pair-{{ ai_gen_id }}__first {
    border-bottom: {{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }};
  }

  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__category,
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__subtitle {
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__category {
      font-size: {{ block.settings.mobile_category_size }}px !important;
    }
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__button {
      font-size: {{ block.settings.mobile_button_size }}px !important;
    }
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__subtitle {
      font-size: {{ block.settings.mobile_subtitle_size }}px !important;
    }
  }

  /* Editable banner controls. Empty color overrides inherit the original settings. */
  @media screen and (min-width: 750px) {
    .ai-promo-pair-{{ ai_gen_id }} { width: {{ block.settings.desktop_width_percent | default: 100 }}%; margin-inline: auto; }
  }
  .ai-promo-pair-{{ ai_gen_id }}__first-content { background: {{ block.settings.first_background | default: '#000000' }}; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__first .ai-promo-pair-{{ ai_gen_id }}__heading { color: {{ block.settings.first_heading_color | default: block.settings.first_text_color }}; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__category { color: {{ block.settings.first_category_color | default: block.settings.first_text_color }}; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__category:hover { color: {{ block.settings.first_category_hover | default: block.settings.first_category_color | default: block.settings.first_text_color }}; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second-heading { color: {{ block.settings.second_heading_color | default: block.settings.second_text_color }}; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__subtitle { color: {{ block.settings.second_subtitle_color | default: block.settings.second_text_color }}; }
  .ai-promo-pair-{{ ai_gen_id }}__responsive-picture { display: block; width: 100%; height: 100%; }
  .ai-promo-pair-{{ ai_gen_id }}__responsive-picture > img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__first .ai-promo-pair-{{ ai_gen_id }}__button {
    min-height: {{ block.settings.first_button_height | default: 44 }}px;
    padding-inline: {{ block.settings.first_button_padding | default: 22 }}px;
    border-radius: {{ block.settings.first_button_radius | default: 0 }}px;
    border: {{ block.settings.first_button_border_width | default: 1, allow_false: true }}px solid {{ block.settings.first_button_border | default: block.settings.button_background }};
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    max-width: 100%; white-space: normal; overflow-wrap: anywhere; text-align: center;
  }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__first .ai-promo-pair-{{ ai_gen_id }}__button[data-button-style="outline"] { background: transparent; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__first .ai-promo-pair-{{ ai_gen_id }}__button[data-button-style="text"] { background: transparent; border-color: transparent; text-decoration: underline; text-underline-offset: 4px; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__first .ai-promo-pair-{{ ai_gen_id }}__button:hover { background: {{ block.settings.first_button_hover_bg | default: block.settings.button_background }}; color: {{ block.settings.first_button_hover_text | default: block.settings.button_text_color }}; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__first .ai-promo-pair-{{ ai_gen_id }}__button[data-button-style="text"]:hover { background: transparent; text-decoration-thickness: 2px; }

  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second .ai-promo-pair-{{ ai_gen_id }}__button {
    min-height: {{ block.settings.second_button_height | default: 44 }}px;
    padding-inline: {{ block.settings.second_button_padding | default: 22 }}px;
    border-radius: {{ block.settings.second_button_radius | default: 0 }}px;
    border: {{ block.settings.second_button_border_width | default: 1, allow_false: true }}px solid {{ block.settings.second_button_border | default: block.settings.second_button_background }};
    background: {{ block.settings.second_button_background }};
    color: {{ block.settings.second_button_text }};
    max-width: 100%; white-space: normal; overflow-wrap: anywhere; text-align: center;
  }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second .ai-promo-pair-{{ ai_gen_id }}__button[data-button-style="outline"] { background: transparent; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second .ai-promo-pair-{{ ai_gen_id }}__button[data-button-style="text"] { background: transparent; border-color: transparent; text-decoration: underline; text-underline-offset: 4px; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second .ai-promo-pair-{{ ai_gen_id }}__button:hover { background: {{ block.settings.second_button_hover_bg | default: block.settings.second_button_background }}; color: {{ block.settings.second_button_hover_text | default: block.settings.second_button_text }}; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second .ai-promo-pair-{{ ai_gen_id }}__button[data-button-style="text"]:hover { background: transparent; text-decoration-thickness: 2px; }

  {% if block.settings.individual_heights %}
  .ai-promo-pair-{{ ai_gen_id }} { height: auto; overflow: visible; }
  .ai-promo-pair-{{ ai_gen_id }}__banner { height: auto; }
  .ai-promo-pair-{{ ai_gen_id }}__first { min-height: {{ block.settings.first_desktop_height }}px; }
  .ai-promo-pair-{{ ai_gen_id }}__image-side { height: auto; min-height: {{ block.settings.first_desktop_height }}px; align-self: stretch; }
  .ai-promo-pair-{{ ai_gen_id }}__image-side > .ai-promo-pair-{{ ai_gen_id }}__responsive-picture { position: absolute; inset: 0; }
  .ai-promo-pair-{{ ai_gen_id }}__first-content { height: auto; }
  .ai-promo-pair-{{ ai_gen_id }}__second, .ai-promo-pair-{{ ai_gen_id }}__second-overlay { height: auto; min-height: {{ block.settings.second_desktop_height }}px; }
  {% endif %}
  @media screen and (max-width: 749px) {
    .ai-promo-pair-{{ ai_gen_id }}__image-side > .ai-promo-pair-{{ ai_gen_id }}__responsive-picture { height: auto; }
    .ai-promo-pair-{{ ai_gen_id }}__image-side > .ai-promo-pair-{{ ai_gen_id }}__responsive-picture > img { height: auto; object-fit: contain; }
    {% if block.settings.individual_heights %}
    .ai-promo-pair-{{ ai_gen_id }}__image-side { min-height: 0; height: {{ block.settings.first_mobile_height }}px; }
    .ai-promo-pair-{{ ai_gen_id }}__first { min-height: 0; }
    .ai-promo-pair-{{ ai_gen_id }}__image-side > .ai-promo-pair-{{ ai_gen_id }}__responsive-picture { position: relative; height: 100%; }
    .ai-promo-pair-{{ ai_gen_id }}__image-side > .ai-promo-pair-{{ ai_gen_id }}__responsive-picture > img { height: 100%; object-fit: cover; }
    .ai-promo-pair-{{ ai_gen_id }}__second, .ai-promo-pair-{{ ai_gen_id }}__second-overlay { min-height: {{ block.settings.second_mobile_height }}px; }
    {% endif %}
  }

  /* Screenshot reference mode: viewport budget is for the WHOLE pair. */
  {% unless block.settings.reference_layout == false %}
  .ai-promo-pair-{{ ai_gen_id }} {
    height: {{ block.settings.reference_desktop_height | default: 50 }}vh;
    display: grid; grid-template-rows: 53% 47%;
    overflow: hidden;
  }
  .ai-promo-pair-{{ ai_gen_id }}__banner { height: 100%; min-height: 0; }
  .ai-promo-pair-{{ ai_gen_id }}__first { display: grid; grid-template-columns: 52% 48%; border-bottom: {{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }}; }
  .ai-promo-pair-{{ ai_gen_id }}__image-side { width: 100%; min-height: 0; height: 100%; }
  .ai-promo-pair-{{ ai_gen_id }}__image-side > .ai-promo-pair-{{ ai_gen_id }}__responsive-picture { position: absolute; inset: 0; height: 100%; }
  .ai-promo-pair-{{ ai_gen_id }}__image-side > .ai-promo-pair-{{ ai_gen_id }}__responsive-picture > img { height: 100%; object-fit: cover; }
  .ai-promo-pair-{{ ai_gen_id }}__first-content {
    align-items: flex-start; text-align: left; height: 100%; min-height: 0;
    gap: clamp(6px, 1vh, 12px); overflow: auto;
    padding: clamp(12px, 2vh, {{ block.settings.content_padding }}px);
  }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__heading { font-family: Arial, Helvetica, sans-serif; font-weight: 750; letter-spacing: -0.025em; line-height: 1.02; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__first .ai-promo-pair-{{ ai_gen_id }}__heading { max-width: 11ch; font-size: clamp(22px, 4.2vh, {{ block.settings.heading_size }}px) !important; }
  .ai-promo-pair-{{ ai_gen_id }}__categories { justify-content: flex-start; flex-wrap: nowrap; gap: clamp(10px, 1.8vw, 26px); width: 100%; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__category { border-bottom: 0; padding: 0; white-space: nowrap; font-size: clamp(10px, 1.4vh, {{ block.settings.category_size }}px) !important; }
  .ai-promo-pair-{{ ai_gen_id }}__second { height: 100%; min-height: 0; background: #edc4cc; }
  .ai-promo-pair-{{ ai_gen_id }}__second-overlay { height: 100%; min-height: 0; overflow: auto; gap: clamp(4px, .7vh, 10px); padding: clamp(12px, 2vh, {{ block.settings.content_padding }}px) clamp(20px, 5vw, 80px); }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second-heading { font-size: clamp(28px, 5.2vh, {{ block.settings.second_heading_size }}px) !important; font-weight: 800; letter-spacing: -.025em; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__subtitle { max-width: 23ch; font-size: clamp(11px, 1.7vh, {{ block.settings.subtitle_size }}px) !important; line-height: 1.1; letter-spacing: 0; }
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__button { flex-shrink: 0; }
  @media screen and (max-width: 749px) {
    .ai-promo-pair-{{ ai_gen_id }} {
      width: 100%; margin: 0;
      height: {{ block.settings.reference_mobile_height | default: 35 }}vh;
      height: {{ block.settings.reference_mobile_height | default: 35 }}svh;
      {% assign reference_first_share = block.settings.reference_first_share | default: 67 %}
      grid-template-rows: {{ reference_first_share }}% {{ 100 | minus: reference_first_share }}%;
    }
    .ai-promo-pair-{{ ai_gen_id }}__first { grid-template-columns: 100%; grid-template-rows: 46% 54%; min-height: 0; }
    .ai-promo-pair-{{ ai_gen_id }}__image-side { height: 100%; min-height: 0; }
    .ai-promo-pair-{{ ai_gen_id }}__first-content { width: 100%; height: 100%; min-height: 0; padding: clamp(4px, .7svh, {{ block.settings.mobile_padding }}px) 16px; gap: clamp(2px, .35svh, 5px); justify-content: center; }
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__first .ai-promo-pair-{{ ai_gen_id }}__heading { max-width: 12ch; font-size: clamp(16px, 2.5svh, {{ block.settings.mobile_heading_size }}px) !important; }
    .ai-promo-pair-{{ ai_gen_id }}__categories { gap: clamp(10px, 5vw, 24px); }
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__category { font-size: clamp(10px, 1.35svh, {{ block.settings.mobile_category_size }}px) !important; line-height: 1.1; }
    .ai-promo-pair-{{ ai_gen_id }}__second-overlay { height: 100%; min-height: 0; padding: clamp(4px, .7svh, {{ block.settings.mobile_padding }}px) 24px; gap: clamp(2px, .35svh, 5px); }
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second-heading { font-size: clamp(20px, 3svh, {{ block.settings.mobile_second_heading_size }}px) !important; }
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__subtitle { max-width: 21ch; font-size: clamp(9px, 1.2svh, {{ block.settings.mobile_subtitle_size }}px) !important; line-height: 1.05; }
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__first .ai-promo-pair-{{ ai_gen_id }}__button { min-height: min({{ block.settings.first_button_height | default: 44 }}px, 3.6svh); }
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second .ai-promo-pair-{{ ai_gen_id }}__button { min-height: min({{ block.settings.second_button_height | default: 44 }}px, 3.6svh); }
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__first .ai-promo-pair-{{ ai_gen_id }}__button,
    .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__second .ai-promo-pair-{{ ai_gen_id }}__button { padding-block: 3px; font-size: clamp(10px, 1.4svh, {{ block.settings.mobile_button_size }}px) !important; line-height: 1.1; }
  }
  {% endunless %}

  {% unless block.settings.reference_layout == false %}
  .ai-promo-pair-{{ ai_gen_id }} .ai-promo-pair-{{ ai_gen_id }}__first .ai-promo-pair-{{ ai_gen_id }}__heading { max-width: 100%; }
  .ai-promo-pair-{{ ai_gen_id }}__heading > span { display: block; }
  @media screen and (max-width: 749px) {
    .ai-promo-pair-{{ ai_gen_id }}__image-side > .ai-promo-pair-{{ ai_gen_id }}__responsive-picture > img { object-position: {{ block.settings.first_mobile_position | default: 'center 15%' }} !important; }
  }
  {% endunless %}
{% endstyle %}

<div class="ai-promo-pair-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-promo-pair-{{ ai_gen_id }}__banner ai-promo-pair-{{ ai_gen_id }}__first">
    <div class="ai-promo-pair-{{ ai_gen_id }}__image-side">
      {% liquid
        assign first_desktop = block.settings.first_desktop_image | default: block.settings.first_mobile_image
        assign first_mobile = block.settings.first_mobile_image | default: block.settings.first_desktop_image
      %}
      {% if first_desktop != blank %}
        <picture class="ai-promo-pair-{{ ai_gen_id }}__responsive-picture">
          <source media="(max-width: 749px)" srcset="{{ first_mobile | image_url: width: 375 }} 375w, {{ first_mobile | image_url: width: 750 }} 750w, {{ first_mobile | image_url: width: 1200 }} 1200w" sizes="100vw">
          <img class="ai-promo-pair-{{ ai_gen_id }}__image" src="{{ first_desktop | image_url: width: 2400 }}" srcset="{{ first_desktop | image_url: width: 750 }} 750w, {{ first_desktop | image_url: width: 1500 }} 1500w, {{ first_desktop | image_url: width: 2400 }} 2400w" sizes="(max-width: 749px) 100vw, 52vw" alt="{{ first_desktop.alt | escape }}" width="{{ first_desktop.width }}" height="{{ first_desktop.height }}" loading="lazy" style="object-position: {{ block.settings.first_position }};">
        </picture>
      {% else %}
        <div class="ai-promo-pair-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {% endif %}
    </div>
    <div class="ai-promo-pair-{{ ai_gen_id }}__first-content">
      <h2 class="ai-promo-pair-{{ ai_gen_id }}__heading">{% if block.settings.first_heading == 'MAKE YOUR MARK.' %}<span>MAKE</span><span>YOUR MARK.</span>{% else %}{{ block.settings.first_heading | escape }}{% endif %}</h2>
      <nav class="ai-promo-pair-{{ ai_gen_id }}__categories" aria-label="Makeup categories">
        {% for i in (1..5) %}
          {% liquid
            assign label_key = 'category_' | append: i | append: '_label'
            assign url_key = 'category_' | append: i | append: '_url'
            assign category_label = block.settings[label_key]
            assign category_url = block.settings[url_key]
          %}
          {% if category_label != blank and category_url != blank %}<a class="ai-promo-pair-{{ ai_gen_id }}__category" href="{{ category_url }}">{{ category_label | escape }}</a>{% endif %}
        {% endfor %}
      </nav>
      {% if block.settings.first_button_label != blank and block.settings.first_button_url != blank %}<a class="ai-promo-pair-{{ ai_gen_id }}__button" data-button-style="{{ block.settings.first_button_style | default: 'solid' }}" href="{{ block.settings.first_button_url }}">{{ block.settings.first_button_label | escape }}</a>{% endif %}
    </div>
  </div>
  <div class="ai-promo-pair-{{ ai_gen_id }}__banner ai-promo-pair-{{ ai_gen_id }}__second">
    {% liquid
        assign second_desktop = block.settings.second_desktop_image | default: block.settings.second_mobile_image
        assign second_mobile = block.settings.second_mobile_image | default: block.settings.second_desktop_image
      %}
      {% if second_desktop != blank %}
        <picture class="ai-promo-pair-{{ ai_gen_id }}__responsive-picture ai-promo-pair-{{ ai_gen_id }}__second-image">
          <source media="(max-width: 749px)" srcset="{{ second_mobile | image_url: width: 375 }} 375w, {{ second_mobile | image_url: width: 750 }} 750w, {{ second_mobile | image_url: width: 1200 }} 1200w" sizes="100vw">
          <img class="ai-promo-pair-{{ ai_gen_id }}__image" src="{{ second_desktop | image_url: width: 2400 }}" srcset="{{ second_desktop | image_url: width: 750 }} 750w, {{ second_desktop | image_url: width: 1500 }} 1500w, {{ second_desktop | image_url: width: 2400 }} 2400w" sizes="100vw" alt="{{ second_desktop.alt | escape }}" width="{{ second_desktop.width }}" height="{{ second_desktop.height }}" loading="lazy" style="object-position: {{ block.settings.second_position }};">
        </picture>
      {% else %}
        <div class="ai-promo-pair-{{ ai_gen_id }}__placeholder ai-promo-pair-{{ ai_gen_id }}__second-image">{{ 'image' | placeholder_svg_tag }}</div>
      {% endif %}
    <div class="ai-promo-pair-{{ ai_gen_id }}__second-overlay">
      <h2 class="ai-promo-pair-{{ ai_gen_id }}__heading ai-promo-pair-{{ ai_gen_id }}__second-heading">{{ block.settings.second_heading | escape }}</h2>
      <p class="ai-promo-pair-{{ ai_gen_id }}__subtitle">{{ block.settings.second_subtitle | escape }}</p>
      {% if block.settings.second_button_label != blank and block.settings.second_button_url != blank %}<a class="ai-promo-pair-{{ ai_gen_id }}__button" data-button-style="{{ block.settings.second_button_style | default: 'solid' }}" href="{{ block.settings.second_button_url }}">{{ block.settings.second_button_label | escape }}</a>{% endif %}
    </div>
  </div>
</div>

