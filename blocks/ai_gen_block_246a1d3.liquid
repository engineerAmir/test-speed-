    { "type": "text", "id": "label_2", "label": "Label", "default": "Mascara" },
    { "type": "url", "id": "link_2", "label": "Collection link" },
    { "type": "range", "id": "focal_x_2", "label": "Image focal point horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y_2", "label": "Image focal point vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
