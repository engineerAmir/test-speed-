<section class="niche-advanced-reviews">
  <div class="niche-reviews-container">
    
    <div class="niche-section-header">
      <span class="niche-subtitle">Client Experiences</span>
      <h2 class="niche-title">Ratings & Reviews</h2>
    </div>

    <!-- 1. SUMMARY SECTION (Stats & Write Review) -->
    <div class="niche-summary-box">
      
      <!-- Rating Breakdown (Progress Bars) -->
      <div class="niche-summary-breakdown">
        <div class="niche-bar-row">
          <span>5 Stars</span>
          <div class="niche-bar-track"><div class="niche-bar-fill" style="width: 85%;"></div></div>
          <span class="niche-bar-count">524</span>
        </div>
        <div class="niche-bar-row">
          <span>4 Stars</span>
          <div class="niche-bar-track"><div class="niche-bar-fill" style="width: 10%;"></div></div>
          <span class="niche-bar-count">67</span>
        </div>
        <div class="niche-bar-row">
          <span>3 Stars</span>
          <div class="niche-bar-track"><div class="niche-bar-fill" style="width: 2%;"></div></div>
          <span class="niche-bar-count">12</span>
        </div>
        <div class="niche-bar-row">
          <span>2 Stars</span>
          <div class="niche-bar-track"><div class="niche-bar-fill" style="width: 1%;"></div></div>
          <span class="niche-bar-count">4</span>
        </div>
        <div class="niche-bar-row">
          <span>1 Star</span>
          <div class="niche-bar-track"><div class="niche-bar-fill" style="width: 2%;"></div></div>
          <span class="niche-bar-count">6</span>
        </div>
      </div>

      <!-- Overall Rating Score -->
      <div class="niche-summary-overall">
        <span class="niche-score">4.8</span>
        <div class="niche-stars-main">
          {% for i in (1..5) %}
            <svg viewBox="0 0 24 24" class="niche-star filled"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {% endfor %}
        </div>
        <p class="niche-total-text">Based on 613 reviews<br>97% recommend this formulation.</p>
      </div>

      <!-- Action Area -->
      <div class="niche-summary-action">
        <p class="niche-action-title">Share your experience</p>
        <button class="niche-btn-primary" id="openReviewModalBtn">Write a Review</button>
      </div>

    </div>

    <!-- 2. CUSTOMER IMAGES GALLERY -->
    <div class="niche-reviews-gallery-wrap">
      <h4 class="niche-gallery-title">Images from our clientele</h4>
      <div class="niche-reviews-gallery">
        <div class="niche-gallery-item"><img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/photo-1620916297397-a4a5402a3c6c.avif?v=1776280622" loading="lazy"></div>
        <div class="niche-gallery-item"><img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/photo-1620916297397-a4a5402a3c6c.avif?v=1776280622" loading="lazy"></div>
        <div class="niche-gallery-item"><img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/photo-1620916297397-a4a5402a3c6c.avif?v=1776280622" loading="lazy"></div>
        <div class="niche-gallery-item"><img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/photo-1620916297397-a4a5402a3c6c.avif?v=1776280622" loading="lazy"></div>
        <div class="niche-gallery-item"><img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/photo-1620916297397-a4a5402a3c6c.avif?v=1776280622" loading="lazy"></div>
        <div class="niche-gallery-item"><img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/photo-1620916297397-a4a5402a3c6c.avif?v=1776280622" loading="lazy"></div>
      </div>
    </div>

    <!-- 3. FILTERS & SEARCH -->
    <div class="niche-reviews-filters">
      <div class="niche-search-box">
        <svg viewBox="0 0 24 24" class="niche-search-icon"><path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
        <input type="text" id="nicheSearchInput" placeholder="Search topics and reviews...">
      </div>
      
      <div class="niche-filter-group">
        <select id="nicheRatingFilter" class="niche-dropdown">
          <option value="all">Filter by Rating</option>
          <option value="5">5 Stars</option>
          <option value="4">4 Stars</option>
          <option value="3">3 Stars</option>
          <option value="2">2 Stars</option>
          <option value="1">1 Star</option>
        </select>
        
        <select id="nicheSortFilter" class="niche-dropdown">
          <option value="newest">Sort by: Newest</option>
          <option value="highest">Highest Rating</option>
          <option value="lowest">Lowest Rating</option>
        </select>
      </div>
    </div>

    <!-- 4. REVIEWS LIST -->
    <div class="niche-reviews-list" id="nicheReviewsList">
      
      <!-- No Results Message (Hidden by default) -->
      <div id="nicheNoResults" style="display: none; text-align: center; padding: 40px; font-family: 'IBM Plex Sans', sans-serif; color: #777;">
        No reviews found matching your criteria.
      </div>

      {% for block in section.blocks %}
      <!-- Added data attributes for JS filtering and sorting -->
      <div class="niche-review-item" 
           data-rating="{{ block.settings.rating }}" 
           data-date="{{ block.settings.review_date }}" 
           {{ block.shopify_attributes }}>
        
        <div class="niche-review-meta">
          <div class="niche-stars-small">
            {% for i in (1..5) %}
              {% if i <= block.settings.rating %}
                <svg viewBox="0 0 24 24" class="niche-star filled"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" class="niche-star empty"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% endif %}
            {% endfor %}
          </div>
          <span class="niche-review-date">{{ block.settings.review_date }}</span>
        </div>

        <div class="niche-review-content">
          <h4 class="niche-review-title">{{ block.settings.review_title }}</h4>
          <p class="niche-review-text">{{ block.settings.review_text }}</p>
        </div>

        <div class="niche-review-footer">
          <div class="niche-author-info">
            <span class="niche-author-name">{{ block.settings.author_name }}</span>
            {% if block.settings.verified %}
              <span class="niche-verified">✓ Verified Buyer</span>
            {% endif %}
          </div>
          
          <button class="niche-helpful-btn" data-helpful-count="{{ block.settings.helpful_count }}">
            <svg viewBox="0 0 24 24"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Helpful (<span class="count">{{ block.settings.helpful_count }}</span>)
          </button>
        </div>

      </div>
      {% endfor %}

    </div>

    <!-- Pagination / Load More -->
    <div class="niche-load-more" id="loadMoreContainer">
      <button class="niche-btn-secondary" id="loadMoreBtn">Load More Reviews</button>
    </div>

  </div>
</section>

<!-- Write Review Modal -->
<div class="niche-review-modal" id="reviewModal">
  <div class="niche-modal-overlay" id="closeReviewOverlay"></div>
  <div class="niche-modal-content">
    <button class="niche-modal-close" id="closeReviewBtn">×</button>
    <h3 class="niche-modal-title">Share Your Experience</h3>
    <p class="niche-modal-desc">We value your feedback. Please share your thoughts below.</p>
    
    <form id="nicheReviewForm" class="niche-form">
      <div class="niche-form-group">
        <label>Rating</label>
        <div class="niche-interactive-stars">
          <span data-value="1">★</span><span data-value="2">★</span><span data-value="3">★</span><span data-value="4">★</span><span data-value="5">★</span>
        </div>
        <input type="hidden" id="formRating" required>
      </div>
      <div class="niche-form-group">
        <label>Name</label>
        <input type="text" required placeholder="e.g. Sarah M.">
      </div>
      <div class="niche-form-group">
        <label>Review Title</label>
        <input type="text" required placeholder="Summarize your experience">
      </div>
      <div class="niche-form-group">
        <label>Your Review</label>
        <textarea required rows="4" placeholder="How did this product perform for you?"></textarea>
      </div>
      <button type="submit" class="niche-btn-primary" style="width: 100%; max-width: 100%;">Submit Review</button>
    </form>
    
    <!-- Success Message -->
    <div id="nicheReviewSuccess" style="display: none; text-align: center; padding: 40px 0;">
      <h3 style="font-family: 'IBM Plex Serif', serif; color: #1a1a1a;">Thank You</h3>
      <p style="font-family: 'IBM Plex Sans', sans-serif; color: #555;">Your review has been submitted successfully and is pending approval.</p>
    </div>
  </div>
</div>

<style>
/* =========================================
   NICHE Luxury Reviews - Full Width Layout
   ========================================= */

.niche-advanced-reviews {
  background-color: #fff;
  padding: 80px 0;
  border-top: 1px solid rgba(26,26,26,0.05);
  width: 100%; /* العرض بالكامل */
}

.niche-reviews-container {
  max-width: 1600px; /* تمديد العرض ليتناسق مع الهيدر */
  margin: 0 auto;
  padding: 0 40px;
}

.niche-section-header {
  text-align: center;
  margin-bottom: 50px;
}

.niche-subtitle {
  display: block;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #1a1a1a;
  font-weight: 500;
  margin-bottom: 12px;
}

.niche-title {
  font-family: 'IBM Plex Serif', serif;
  font-size: 34px;
  color: #1a1a1a;
  margin: 0;
  font-weight: 400;
}

/* --- 1. SUMMARY SECTION --- */
.niche-summary-box {
  display: grid;
  grid-template-columns: 1fr 1.5fr 1fr; /* نسب معدلة للعرض الكامل */
  align-items: center;
  background: #f7f5f0; 
  padding: 50px;
  border-radius: 6px;
  margin-bottom: 50px;
  border: 1px solid rgba(26,26,26,0.03);
}

.niche-summary-breakdown {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-right: 40px;
  border-right: 1px solid rgba(26,26,26,0.1);
}

.niche-bar-row {
  display: flex;
  align-items: center;
  gap: 15px;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 12px;
  color: #555;
}

.niche-bar-track {
  flex-grow: 1;
  height: 2px; /* خط أنحف للفخامة */
  background: #eaeaea;
  border-radius: 2px;
  overflow: hidden;
}

.niche-bar-fill {
  height: 100%;
  background: #1a1a1a; 
}

.niche-bar-count {
  min-width: 30px;
  text-align: right;
}

.niche-summary-overall {
  text-align: center;
  padding: 0 40px;
  border-right: 1px solid rgba(26,26,26,0.1);
}

.niche-score {
  font-family: 'IBM Plex Serif', serif;
  font-size: 64px;
  line-height: 1;
  color: #1a1a1a;
  display: block;
  margin-bottom: 10px;
}

.niche-stars-main {
  display: flex;
  justify-content: center;
  gap: 3px;
  margin-bottom: 12px;
}

.niche-stars-main svg,
.niche-stars-small svg {
  width: 18px;
  height: 18px;
}

.niche-star.filled { fill: #1a1a1a; }
.niche-star.empty { fill: none; stroke: #1a1a1a; stroke-width: 1.5; }

.niche-total-text {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 14px;
  color: #555;
  line-height: 1.6;
  margin: 0;
}

.niche-summary-action {
  text-align: center;
  padding-left: 40px;
}

.niche-action-title {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 14px;
  color: #1a1a1a;
  margin: 0 0 20px;
  font-weight: 500;
}

.niche-btn-primary, .niche-btn-secondary {
  display: inline-block;
  padding: 16px 32px;
  border-radius: 4px;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 13px;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  font-weight: 500;
  transition: all 0.3s ease;
  width: 100%;
  max-width: 240px;
}

.niche-btn-primary {
  background: #1a1a1a;
  color: #f7f5f0;
  border: 1px solid #1a1a1a;
}
.niche-btn-primary:hover { background: #7c3030; border-color: #7c3030; }

.niche-btn-secondary {
  background: transparent;
  color: #1a1a1a;
  border: 1px solid #1a1a1a;
}
.niche-btn-secondary:hover { background: #1a1a1a; color: #f7f5f0; }


/* --- 2. GALLERY --- */
.niche-reviews-gallery-wrap {
  margin-bottom: 50px;
}

.niche-gallery-title {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 13px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #1a1a1a;
  margin: 0 0 20px;
  font-weight: 500;
}

.niche-reviews-gallery {
  display: flex;
  gap: 15px;
  overflow-x: auto;
  padding-bottom: 10px;
  scrollbar-width: thin;
}

.niche-gallery-item {
  width: 140px;
  height: 140px;
  flex-shrink: 0;
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid rgba(26,26,26,0.05);
  cursor: pointer;
}

.niche-gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.niche-gallery-item:hover img {
  transform: scale(1.08);
}


/* --- 3. FILTERS & SEARCH --- */
.niche-reviews-filters {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 40px;
  padding-bottom: 25px;
  border-bottom: 1px solid rgba(26,26,26,0.1);
}

.niche-search-box {
  position: relative;
  flex-grow: 1;
  max-width: 500px;
}

.niche-search-icon {
  position: absolute;
  left: 15px;
  top: 50%;
  transform: translateY(-50%);
  width: 18px;
  height: 18px;
  color: #555;
}

.niche-search-box input {
  width: 100%;
  padding: 14px 15px 14px 45px;
  border: 1px solid rgba(26,26,26,0.15);
  border-radius: 4px;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 14px;
  color: #1a1a1a;
  background: transparent;
  outline: none;
  transition: border-color 0.3s;
}
.niche-search-box input:focus { border-color: #1a1a1a; }

.niche-filter-group {
  display: flex;
  gap: 15px;
}

.niche-dropdown {
  padding: 14px 40px 14px 20px;
  border: 1px solid rgba(26,26,26,0.15);
  border-radius: 4px;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 13px;
  letter-spacing: 0.5px;
  color: #1a1a1a;
  background: transparent;
  outline: none;
  cursor: pointer;
  appearance: none;
  background-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231a1a1a' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpolyline points='6 9 12 15 18 9'%3E%3C/polyline%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right 15px center;
  background-size: 16px;
}


/* --- 4. REVIEWS LIST --- */
.niche-reviews-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr); /* شبكة من عمودين عشان العرض الكامل */
  gap: 40px;
}

.niche-review-item {
  padding: 30px;
  border: 1px solid rgba(26,26,26,0.08);
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  background: #fff;
  transition: opacity 0.3s ease;
}

.niche-review-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.niche-stars-small {
  display: flex;
  gap: 2px;
}

.niche-review-date {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 13px;
  color: #777;
}

.niche-review-content {
  margin-bottom: 30px;
  flex-grow: 1;
}

.niche-review-title {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 18px;
  color: #1a1a1a;
  margin: 0 0 12px;
  font-weight: 600;
}

.niche-review-text {
  font-family: 'IBM Plex Serif', serif;
  font-size: 16px;
  line-height: 1.7;
  color: #333;
  margin: 0;
}

.niche-review-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20px;
  border-top: 1px solid rgba(26,26,26,0.05);
}

.niche-author-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.niche-author-name {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 14px;
  font-weight: 600;
  color: #1a1a1a;
}

.niche-verified {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 11px;
  color: #5a6650;
  font-weight: 500;
  background: rgba(90, 102, 80, 0.08);
  padding: 4px 10px;
  border-radius: 12px;
}

.niche-helpful-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: none;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 13px;
  color: #555;
  cursor: pointer;
  transition: color 0.3s;
  padding: 0;
}
.niche-helpful-btn.active {
  color: #1a1a1a;
  font-weight: 600;
}
.niche-helpful-btn svg {
  width: 16px;
  height: 16px;
}
.niche-helpful-btn:hover {
  color: #1a1a1a;
}

.niche-load-more {
  text-align: center;
  margin-top: 60px;
}

/* --- MODAL STYLES --- */
.niche-review-modal {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: none;
  align-items: center;
  justify-content: center;
}
.niche-review-modal.show {
  display: flex;
}
.niche-modal-overlay {
  position: absolute;
  inset: 0;
  background: rgba(26,26,26,0.8);
  backdrop-filter: blur(5px);
}
.niche-modal-content {
  position: relative;
  background: #f7f5f0;
  width: 100%;
  max-width: 500px;
  border-radius: 6px;
  padding: 40px;
  z-index: 1;
  box-shadow: 0 20px 50px rgba(0,0,0,0.2);
}
.niche-modal-close {
  position: absolute;
  top: 15px;
  right: 20px;
  background: none;
  border: none;
  font-size: 28px;
  color: #1a1a1a;
  cursor: pointer;
}
.niche-modal-title {
  font-family: 'IBM Plex Serif', serif;
  font-size: 28px;
  margin: 0 0 10px;
  color: #1a1a1a;
}
.niche-modal-desc {
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 14px;
  color: #555;
  margin-bottom: 25px;
}
.niche-form-group {
  margin-bottom: 20px;
  text-align: left;
}
.niche-form-group label {
  display: block;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 13px;
  color: #1a1a1a;
  font-weight: 500;
  margin-bottom: 8px;
}
.niche-form-group input, .niche-form-group textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid rgba(26,26,26,0.15);
  border-radius: 4px;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 14px;
  background: #fff;
  outline: none;
}
.niche-form-group input:focus, .niche-form-group textarea:focus {
  border-color: #1a1a1a;
}
.niche-interactive-stars {
  font-size: 28px;
  color: #ccc;
  cursor: pointer;
  display: flex;
  gap: 5px;
}
.niche-interactive-stars span {
  transition: color 0.2s;
}
.niche-interactive-stars span.active {
  color: #1a1a1a;
}


/* --- Responsive --- */
@media(max-width: 990px) {
  .niche-summary-box {
    grid-template-columns: 1fr;
    gap: 30px;
    text-align: center;
  }
  .niche-summary-breakdown {
    border-right: none;
    border-bottom: 1px solid rgba(26,26,26,0.1);
    padding-right: 0;
    padding-bottom: 30px;
  }
  .niche-summary-overall {
    border-right: none;
    border-bottom: 1px solid rgba(26,26,26,0.1);
    padding-bottom: 30px;
  }
  .niche-summary-action {
    padding-left: 0;
  }
  .niche-reviews-filters {
    flex-direction: column;
    align-items: stretch;
  }
  .niche-search-box {
    max-width: 100%;
  }
  .niche-filter-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .niche-reviews-list {
    grid-template-columns: 1fr; /* عمود واحد في الشاشات الصغيرة */
  }
}

@media(max-width: 768px) {
  .niche-advanced-reviews { padding: 50px 0; }
  .niche-reviews-container { padding: 0 20px; }
  .niche-title { font-size: 28px; }
  .niche-review-footer {
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // 1. Search & Filter Logic
  const searchInput = document.getElementById('nicheSearchInput');
  const ratingFilter = document.getElementById('nicheRatingFilter');
  const sortFilter = document.getElementById('nicheSortFilter');
  const reviewsContainer = document.getElementById('nicheReviewsList');
  const noResultsMsg = document.getElementById('nicheNoResults');
  let reviewItems = Array.from(document.querySelectorAll('.niche-review-item'));

  function filterAndSortReviews() {
    const searchTerm = searchInput.value.toLowerCase();
    const ratingValue = ratingFilter.value;
    const sortValue = sortFilter.value;
    let visibleCount = 0;

    // Filter
    let filteredReviews = reviewItems.filter(review => {
      const text = review.innerText.toLowerCase();
      const rating = review.getAttribute('data-rating');
      const matchesSearch = text.includes(searchTerm);
      const matchesRating = (ratingValue === 'all' || rating === ratingValue);
      
      if (matchesSearch && matchesRating) {
        review.style.display = 'flex'; // لأننا بنستخدم flex جوا الكارت
        visibleCount++;
        return true;
      } else {
        review.style.display = 'none';
        return false;
      }
    });

    // Show/Hide No Results
    noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';

    // Sort
    if (sortValue === 'newest') {
      filteredReviews.sort((a, b) => b.getAttribute('data-date').localeCompare(a.getAttribute('data-date')));
    } else if (sortValue === 'highest') {
      filteredReviews.sort((a, b) => parseInt(b.getAttribute('data-rating')) - parseInt(a.getAttribute('data-rating')));
    } else if (sortValue === 'lowest') {
      filteredReviews.sort((a, b) => parseInt(a.getAttribute('data-rating')) - parseInt(b.getAttribute('data-rating')));
    }

    // Re-append sorted elements
    filteredReviews.forEach(review => reviewsContainer.appendChild(review));
  }

  if(searchInput) searchInput.addEventListener('input', filterAndSortReviews);
  if(ratingFilter) ratingFilter.addEventListener('change', filterAndSortReviews);
  if(sortFilter) sortFilter.addEventListener('change', filterAndSortReviews);

  // 2. Helpful Button Logic
  const helpfulBtns = document.querySelectorAll('.niche-helpful-btn');
  helpfulBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      this.classList.toggle('active');
      const countSpan = this.querySelector('.count');
      let currentCount = parseInt(countSpan.innerText);
      if (this.classList.contains('active')) {
        countSpan.innerText = currentCount + 1;
      } else {
        countSpan.innerText = currentCount - 1;
      }
    });
  });

  // 3. Write a Review Modal Logic
  const modal = document.getElementById('reviewModal');
  const openBtn = document.getElementById('openReviewModalBtn');
  const closeBtn = document.getElementById('closeReviewBtn');
  const overlay = document.getElementById('closeReviewOverlay');
  const form = document.getElementById('nicheReviewForm');
  const successMsg = document.getElementById('nicheReviewSuccess');

  if(openBtn) {
    openBtn.addEventListener('click', () => {
      modal.classList.add('show');
      form.style.display = 'block';
      successMsg.style.display = 'none';
      form.reset();
      document.querySelectorAll('.niche-interactive-stars span').forEach(s => s.classList.remove('active'));
    });
  }

  function closeModal() {
    modal.classList.remove('show');
  }

  if(closeBtn) closeBtn.addEventListener('click', closeModal);
  if(overlay) overlay.addEventListener('click', closeModal);

  // Interactive Stars in Modal
  const stars = document.querySelectorAll('.niche-interactive-stars span');
  const ratingInput = document.getElementById('formRating');
  
  stars.forEach(star => {
    star.addEventListener('click', function() {
      const val = this.getAttribute('data-value');
      ratingInput.value = val;
      stars.forEach(s => {
        if(s.getAttribute('data-value') <= val) {
          s.classList.add('active');
        } else {
          s.classList.remove('active');
        }
      });
    });
  });

  // Form Submit Dummy Action
  if(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      if(!ratingInput.value) {
        alert('Please select a star rating.');
        return;
      }
      form.style.display = 'none';
      successMsg.style.display = 'block';
      setTimeout(closeModal, 3000);
    });
  }
});
</script>

