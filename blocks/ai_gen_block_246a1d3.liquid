{% doc %}
  @prompt
    Create a responsive Shopify collection section matching the references. White background, bold black heading “All eyes on you.”
    
    Desktop: four equal cards in one row.
    Mobile: a 2×2 grid.
    Order: Eyeshadow, Mascara, Eyeliner, Brows.
    
    Each card has a landscape image with a bold black label and small right arrow underneath. Make the entire card clickable. Use cover-fit images with adjustable focal points, narrow gaps, compact padding and square corners. No borders, shadows or text overlays.
    
    Set total section height to 45vh on desktop and mobile, including heading and padding. Make images fill the remaining space while keeping labels visible without clipping or overflow.
    
    Provide editable heading, four images, labels, collection links, typography, gaps, padding and separate desktop/mobile height controls. Keep all text separate from images.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-showcase-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: {{ block.settings.desktop_height }}vh;
    min-height: 0;
    box-sizing: border-box;
    padding: {{ block.settings.section_padding }}px;
    overflow: hidden;
    background: #ffffff;
    color: #000000;
  }
  .ai-collection-showcase-{{ ai_gen_id }}__inner { height: 100%; min-height: 0; display: flex; flex-direction: column; }
  .ai-collection-showcase-{{ ai_gen_id }}__heading {
    flex: 0 0 auto;
    margin: 0 0 {{ block.settings.heading_gap }}px;
    color: #000000;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.05;
  }
  .ai-collection-showcase-{{ ai_gen_id }}__grid {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: minmax(0, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }
  .ai-collection-showcase-{{ ai_gen_id }}__card {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    color: #000000;
    text-decoration: none;
    overflow: hidden;
  }
  .ai-collection-showcase-{{ ai_gen_id }}__media {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    overflow: hidden;
    background: #f4f4f4;
  }
  .ai-collection-showcase-{{ ai_gen_id }}__media img,
  .ai-collection-showcase-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ai-collection-showcase-{{ ai_gen_id }}__media img {
    object-position: var(--focal-x) var(--focal-y);
  }
  .ai-collection-showcase-{{ ai_gen_id }}__media svg { background: #f4f4f4; }
  .ai-collection-showcase-{{ ai_gen_id }}__label {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    min-height: 30px;
    padding-top: 7px;
    color: #000000;
    font-family: {{ block.settings.label_font.family }}, {{ block.settings.label_font.fallback_families }};
    font-size: {{ block.settings.label_size }}px;
    font-weight: 700;
    line-height: 1.15;
  }
  .ai-collection-showcase-{{ ai_gen_id }}__arrow { flex: 0 0 auto; width: 16px; height: 16px; }
  .ai-collection-showcase-{{ ai_gen_id }}__card:focus-visible { outline: 2px solid #000000; outline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .ai-collection-showcase-{{ ai_gen_id }} { height: {{ block.settings.mobile_height }}vh; }
    .ai-collection-showcase-{{ ai_gen_id }}__heading { font-size: {{ block.settings.mobile_heading_size }}px; }
    .ai-collection-showcase-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }
    .ai-collection-showcase-{{ ai_gen_id }}__label { font-size: {{ block.settings.mobile_label_size }}px; }
  }
{% endstyle %}

<div class="ai-collection-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-showcase-{{ ai_gen_id }}__inner">
    <h2 class="ai-collection-showcase-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    <div class="ai-collection-showcase-{{ ai_gen_id }}__grid">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign label_key = 'label_' | append: i
          assign link_key = 'link_' | append: i
          assign focal_x_key = 'focal_x_' | append: i
          assign focal_y_key = 'focal_y_' | append: i
          assign card_image = block.settings[image_key]
          assign card_label = block.settings[label_key]
          assign card_link = block.settings[link_key]
          assign focal_x = block.settings[focal_x_key]
          assign focal_y = block.settings[focal_y_key]
        %}
        <a class="ai-collection-showcase-{{ ai_gen_id }}__card" href="{{ card_link | default: routes.all_products_collection_url }}" aria-label="{{ card_label | escape }}">
          <span class="ai-collection-showcase-{{ ai_gen_id }}__media" style="--focal-x: {{ focal_x }}%; --focal-y: {{ focal_y }}%;">
            {% if card_image != blank %}
              <img src="{{ card_image | image_url: width: 1200 }}" alt="{{ card_image.alt | default: card_label | escape }}" loading="lazy" width="{{ card_image.width }}" height="{{ card_image.height }}">
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </span>
          <span class="ai-collection-showcase-{{ ai_gen_id }}__label">
            <span>{{ card_label | escape }}</span>
            <svg class="ai-collection-showcase-{{ ai_gen_id }}__arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3.5 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
