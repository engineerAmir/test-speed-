      {% elsif section.settings.banner_image == blank %}
        <source media="(max-width: 768px)" srcset="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/FULL_WIDTH_3_phone_size.webp?v=1781213262&width=320 320w, https://cdn.shopify.com/s/files/1/0815/5696/3547/files/FULL_WIDTH_3_phone_size.webp?v=1781213262&width=420 420w, https://cdn.shopify.com/s/files/1/0815/5696/3547/files/FULL_WIDTH_3_phone_size.webp?v=1781213262&width=640 640w, https://cdn.shopify.com/s/files/1/0815/5696/3547/files/FULL_WIDTH_3_phone_size.webp?v=1781213262&width=840 840w, https://cdn.shopify.com/s/files/1/0815/5696/3547/files/FULL_WIDTH_3_phone_size.webp?v=1781213262&width=1280 1280w" sizes="100vw" width="1600" height="480">
