/* Compact desktop layout: half-height images and reduced spacing. */
@media (min-width: 990px) {
  .ai-explore-{{ ai_gen_id }} {
    padding-top: {{ block.settings.padding_vertical | divided_by: 2.0 }}px;
    padding-bottom: {{ block.settings.padding_vertical | divided_by: 2.0 }}px;
  }

  .ai-explore-{{ ai_gen_id }} .head {
    margin-bottom: 5px;
  }

  .ai-explore-{{ ai_gen_id }} .grid {
    row-gap: {{ block.settings.row_gap | divided_by: 2.0 }}px;
  }

  .ai-explore-{{ ai_gen_id }} .media {
    aspect-ratio: calc(2 * ({{ block.settings.desktop_ratio }}));
  }
}
/* Compact mobile layout: half-height images and reduced spacing. */
@media (max-width: 749px) {
  .ai-explore-{{ ai_gen_id }} {
    padding-top: {{ block.settings.mobile_padding | divided_by: 2.0 }}px;
    padding-bottom: {{ block.settings.mobile_padding | divided_by: 2.0 }}px;
  }

  .ai-explore-{{ ai_gen_id }} .head {
    margin-bottom: 6px;
  }

  .ai-explore-{{ ai_gen_id }} .grid {
    row-gap: {{ block.settings.row_gap | divided_by: 2.0 }}px;
  }

  .ai-explore-{{ ai_gen_id }} .media {
    aspect-ratio: calc(2 * ({{ block.settings.mobile_ratio }}));
  }

  .ai-explore-{{ ai_gen_id }} .label {
    margin-top: 3px;
  }
}
{% endstyle %}
<section class="ai-explore-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="inner"><div class="head"><h2>{{ block.settings.heading | escape }}</h2>{% if block.settings.show_all_link and block.settings.all_link != blank %}<a class="all" href="{{ block.settings.all_link }}">{{ block.settings.all_label | escape }} →</a>{% endif %}</div><div class="grid">{% for i in (1..8) %}{% assign image_key = 'image_' | append: i %}{% assign title_key = 'title_' | append: i %}{% assign collection_key = 'collection_' | append: i %}{% assign url_key = 'url_' | append: i %}{% assign focal_key = 'focal_' | append: i %}{% assign category_image = block.settings[image_key] %}{% assign category_title = block.settings[title_key] %}{% assign category_collection = block.settings[collection_key] %}{% assign destination = block.settings[url_key] %}{% if category_collection != blank %}{% assign destination = category_collection.url %}{% endif %}{% if category_image == blank and category_collection != blank %}{% assign category_image = category_collection.featured_image %}{% endif %}<a class="card" href="{{ destination | default: routes.all_products_collection_url }}" aria-label="{{ category_title | escape }}"><div class="media">{% if category_image != blank %}<img src="{{ category_image | image_url: width: 900 }}" srcset="{{ category_image | image_url: width: 360 }} 360w, {{ category_image | image_url: width: 600 }} 600w, {{ category_image | image_url: width: 900 }} 900w" sizes="(max-width:749px) 50vw,(max-width:989px) 33vw,25vw" alt="{{ category_image.alt | default: category_title | escape }}" loading="lazy" width="{{ category_image.width }}" height="{{ category_image.height }}" style="object-position:{{ block.settings[focal_key] }}">{% else %}<div class="empty">{{ 'image' | placeholder_svg_tag }}<span class="empty-note">Add an image for {{ category_title | escape }}</span></div>{% endif %}</div><span class="label"><span>{{ category_title | escape }}</span><span class="arrow" aria-hidden="true">→</span></span></a>{% endfor %}</div></div></section>
