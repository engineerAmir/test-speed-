{% doc %}
  @prompt
    Create a responsive Shopify hair-care section matching the references. White background, bold black typography and compact spacing.
    
    Desktop: a thin horizontal strip, approximately 130–160px tall. Three areas in one row: wide hair/model image on the left, heading “Good hair starts with care.” in the middle, and four pale-gray collection links in a 2×2 grid on the right: Shampoo, Conditioner, Hair masks, Oils & treatments. Each link includes a small right arrow.
    
    Mobile: place a wide promotional image at the top with the heading overlaid on its light left side. Below, show four image cards in a 2×2 grid, each with its label and arrow underneath. Keep the entire section compact, approximately 300–350px tall.
    
    Use separate promotional images for desktop/mobile. Provide individual mobile collection images with cover-fit and adjustable focal points. Make each collection card/link fully clickable. Use square corners, narrow gaps and no shadows.
    
    All headings, labels and links must be editable elements separate from images. Include settings for images, text, collection links, colors, typography, spacing, padding and separate desktop/mobile heights.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hair-care-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: {{ block.settings.desktop_height }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    box-sizing: border-box;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    
  }

  .ai-hair-care-{{ ai_gen_id }} *,
  .ai-hair-care-{{ ai_gen_id }} *::before,
  .ai-hair-care-{{ ai_gen_id }} *::after { box-sizing: border-box; }

  .ai-hair-care-{{ ai_gen_id }}__desktop {
    height: 100%;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr 1.2fr;
    gap: {{ block.settings.gap }}px;
    align-items: stretch;
  }

  .ai-hair-care-{{ ai_gen_id }}__promo,
  .ai-hair-care-{{ ai_gen_id }}__mobile-promo {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: #f2f2f2;
  }

  .ai-hair-care-{{ ai_gen_id }}__promo img,
  .ai-hair-care-{{ ai_gen_id }}__mobile-promo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hair-care-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
    background: #f2f2f2;
  }

  .ai-hair-care-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hair-care-{{ ai_gen_id }}__heading {
    display: flex;
    align-items: center;
    margin: 0;
    padding: {{ block.settings.heading_padding }}px;
    color: {{ block.settings.text_color }};
    {% unless block.settings.use_theme_typography %}font-size: {{ block.settings.heading_size }}px;{% endunless %}
    {% unless block.settings.use_theme_typography %}line-height: 1.08;{% endunless %}
    {% unless block.settings.use_theme_typography %}font-weight: 700;{% endunless %}
    {% unless block.settings.use_theme_typography %}letter-spacing: -0.04em;{% endunless %}
  }

  .ai-hair-care-{{ ai_gen_id }}__links {
    display: grid;
    min-width: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-hair-care-{{ ai_gen_id }}__link {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    min-width: 0;
    padding: 12px 16px;
    background: {{ block.settings.card_color }};
    color: {{ block.settings.text_color }};
    text-decoration: none;
    {% unless block.settings.use_theme_typography %}font-size: {{ block.settings.label_size }}px;{% endunless %}
    {% unless block.settings.use_theme_typography %}font-weight: 600;{% endunless %}
    {% unless block.settings.use_theme_typography %}line-height: 1.2;{% endunless %}
  }

  .ai-hair-care-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: -3px;
  }

  .ai-hair-care-{{ ai_gen_id }}__arrow { flex: 0 0 auto; font-size: 1em; line-height: 1; }
  .ai-hair-care-{{ ai_gen_id }}__mobile { display: none; }

  @media screen and (max-width: 749px) {
    .ai-hair-care-{{ ai_gen_id }} {
      height: auto;
      padding: {{ block.settings.mobile_padding }}px;
    }
    .ai-hair-care-{{ ai_gen_id }}__desktop { display: none; }
    .ai-hair-care-{{ ai_gen_id }}__mobile { display: block; }
    .ai-hair-care-{{ ai_gen_id }}__mobile-promo { height: {{ block.settings.mobile_promo_height }}px; }
    .ai-hair-care-{{ ai_gen_id }}__mobile-promo::after {
      content: '';
      position: absolute;
      inset: 0;
      width: 62%;
      background: linear-gradient(90deg, {{ block.settings.background_color }} 0%, {{ block.settings.background_color | color_modify: 'alpha', 0.88 }} 68%, transparent 100%);
      pointer-events: none;
    }
    .ai-hair-care-{{ ai_gen_id }}__mobile-heading {
      position: absolute;
      z-index: 1;
      top: 50%;
      left: 16px;
      transform: translateY(-50%);
      width: 58%;
      margin: 0;
      color: {{ block.settings.text_color }};
      {% unless block.settings.use_theme_typography %}font-size: {{ block.settings.mobile_heading_size }}px;{% endunless %}
      {% unless block.settings.use_theme_typography %}line-height: 1.08;{% endunless %}
      {% unless block.settings.use_theme_typography %}font-weight: 700;{% endunless %}
      {% unless block.settings.use_theme_typography %}letter-spacing: -0.04em;{% endunless %}
    }
    .ai-hair-care-{{ ai_gen_id }}__mobile-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: {{ block.settings.gap }}px;
      margin-top: {{ block.settings.gap }}px;
    }
    .ai-hair-care-{{ ai_gen_id }}__mobile-card {
      display: block;
      min-width: 0;
      color: {{ block.settings.text_color }};
      text-decoration: none;
      background: {{ block.settings.card_color }};
    }
    .ai-hair-care-{{ ai_gen_id }}__mobile-image {
      display: block;
      width: 100%;
      aspect-ratio: 1.8 / 1;
      overflow: hidden;
      background: #f2f2f2;
    }
    .ai-hair-care-{{ ai_gen_id }}__mobile-image img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
    .ai-hair-care-{{ ai_gen_id }}__mobile-caption {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      gap: 6px;
      padding: 7px 9px;
      {% unless block.settings.use_theme_typography %}font-size: {{ block.settings.label_size }}px;{% endunless %}
      {% unless block.settings.use_theme_typography %}font-weight: 600;{% endunless %}
      {% unless block.settings.use_theme_typography %}line-height: 1.15;{% endunless %}
    }
    .ai-hair-care-{{ ai_gen_id }}__mobile-card:focus-visible {
      outline: 2px solid {{ block.settings.text_color }};
      outline-offset: 2px;
    }
  }

  /* Allow the theme's heading styles to determine the content height. */
  .ai-hair-care-{{ ai_gen_id }} {
    height: auto;
    min-height: {{ block.settings.desktop_height }}px;
    margin-inline: auto;
  }
  .ai-hair-care-{{ ai_gen_id }}__desktop {
    height: auto;
    min-height: max(80px, calc({{ block.settings.desktop_height }}px - {{ block.settings.padding_vertical | times: 2 }}px));
  }
  .ai-hair-care-{{ ai_gen_id }}__promo img {
    position: absolute;
    inset: 0;
  }
  .ai-hair-care-{{ ai_gen_id }}__links {
    grid-template-rows: repeat(2, minmax(min-content, 1fr));
  }

  @media screen and (max-width: 749px) {
    .ai-hair-care-{{ ai_gen_id }} { min-height: 0; }
    .ai-hair-care-{{ ai_gen_id }}__desktop { display: none; }
    .ai-hair-care-{{ ai_gen_id }}__mobile-promo {
      height: auto;
      min-height: {{ block.settings.mobile_promo_height }}px;
      padding-bottom: {{ block.settings.mobile_overlap }}px;
    }
    .ai-hair-care-{{ ai_gen_id }}__mobile-promo > img,
    .ai-hair-care-{{ ai_gen_id }}__mobile-promo > .ai-hair-care-{{ ai_gen_id }}__placeholder {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .ai-hair-care-{{ ai_gen_id }}__mobile-heading {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      width: 62%;
      padding: 16px 12px 18px 16px;
      overflow-wrap: break-word;
    }
    .ai-hair-care-{{ ai_gen_id }}__mobile-grid {
      position: relative;
      z-index: 2;
      margin-top: -{{ block.settings.mobile_overlap }}px;
      margin-inline: {{ block.settings.mobile_grid_inset }}px;
      background: {{ block.settings.background_color }};
    }
    .ai-hair-care-{{ ai_gen_id }}__mobile-card,
    .ai-hair-care-{{ ai_gen_id }}__mobile-caption {
      background: {{ block.settings.background_color }};
    }
    .ai-hair-care-{{ ai_gen_id }}__mobile-caption { padding: 6px 2px; }
  }
{% endstyle %}

<div class="ai-hair-care-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hair-care-{{ ai_gen_id }}__desktop">
    <div class="ai-hair-care-{{ ai_gen_id }}__promo">
      {% if block.settings.desktop_image != blank %}
        <img src="{{ block.settings.desktop_image | image_url: width: 1200 }}" alt="{{ block.settings.desktop_image.alt | escape }}" loading="lazy" width="{{ block.settings.desktop_image.width }}" height="{{ block.settings.desktop_image.height }}">
      {% else %}
        <div class="ai-hair-care-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {% endif %}
    </div>
    <h2 class="ai-hair-care-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    <div class="ai-hair-care-{{ ai_gen_id }}__links">
      {% for i in (1..4) %}
        {% liquid
          assign title_key = 'link_' | append: i | append: '_label'
          assign url_key = 'link_' | append: i | append: '_url'
          assign title = block.settings[title_key]
          assign url = block.settings[url_key]
        %}
        <a class="ai-hair-care-{{ ai_gen_id }}__link" href="{{ url | default: routes.all_products_collection_url }}">
          <span>{{ title | escape }}</span><span class="ai-hair-care-{{ ai_gen_id }}__arrow" aria-hidden="true">→</span>
        </a>
      {% endfor %}
    </div>
  </div>

  <div class="ai-hair-care-{{ ai_gen_id }}__mobile">
    <div class="ai-hair-care-{{ ai_gen_id }}__mobile-promo">
      {% if block.settings.mobile_image != blank %}
        <img src="{{ block.settings.mobile_image | image_url: width: 1000 }}" alt="{{ block.settings.mobile_image.alt | escape }}" loading="lazy" width="{{ block.settings.mobile_image.width }}" height="{{ block.settings.mobile_image.height }}">
      {% else %}
        <div class="ai-hair-care-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {% endif %}
      <h2 class="ai-hair-care-{{ ai_gen_id }}__mobile-heading">{{ block.settings.heading | escape }}</h2>
    </div>
    <div class="ai-hair-care-{{ ai_gen_id }}__mobile-grid">
      {% for i in (1..4) %}
        {% liquid
          assign title_key = 'link_' | append: i | append: '_label'
          assign url_key = 'link_' | append: i | append: '_url'
          assign image_key = 'link_' | append: i | append: '_image'
          assign focal_key = 'link_' | append: i | append: '_focal'
          assign title = block.settings[title_key]
          assign url = block.settings[url_key]
          assign card_image = block.settings[image_key]
          assign focal = block.settings[focal_key]
        %}
        <a class="ai-hair-care-{{ ai_gen_id }}__mobile-card" href="{{ url | default: routes.all_products_collection_url }}">
          <span class="ai-hair-care-{{ ai_gen_id }}__mobile-image">
            {% if card_image != blank %}
              <img src="{{ card_image | image_url: width: 700 }}" alt="{{ card_image.alt | escape }}" loading="lazy" width="{{ card_image.width }}" height="{{ card_image.height }}" style="object-position: {{ focal }};">
            {% else %}
              <span class="ai-hair-care-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</span>
            {% endif %}
          </span>
          <span class="ai-hair-care-{{ ai_gen_id }}__mobile-caption"><span>{{ title | escape }}</span><span class="ai-hair-care-{{ ai_gen_id }}__arrow" aria-hidden="true">→</span></span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

