{{ 'nichey-sticky-purchase.css' | asset_url | stylesheet_tag }}
{{ 'nichey-product-hero.css' | asset_url | stylesheet_tag }}
{{ 'nichey-hero-refinements.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nichey-cart.js' | asset_url }}" defer></script>
<script src="{{ 'nichey-product-hero.js' | asset_url }}" defer></script>
{% assign variant = product.selected_or_first_available_variant %}
{% assign trust_blocks = section.blocks | where: 'type', 'trust' %}
{% if product != blank %}
<ny-product-hero id="NyHero-{{ section.id }}" class="ny-hero ny-hero-premium" data-section="{{ section.id }}" data-product-url="{{ product.url }}" data-error="{{ section.settings.error_label | escape }}" data-cart-error="{{ section.settings.cart_error | escape }}" data-updating="{{ section.settings.updating_label | escape }}" style="--ny-title:{{ section.settings.title_d }}px;--ny-title-t:{{ section.settings.title_t }}px;--ny-title-m:{{ section.settings.title_m }}px;--ny-hero-gap:{{ section.settings.hero_gap }}px;--ny-media-ratio:{{ section.settings.media_ratio }};--ny-media-fit:{{ section.settings.media_fit }};--ny-media-max:{{ section.settings.media_max_d }}px;--ny-media-max-m:{{ section.settings.media_max_m }}px;--ny-thumb-width:{{ section.settings.thumb_width }}px;--ny-purchase-gap:{{ section.settings.purchase_gap }}px;--ny-cta-primary:{{ section.settings.cta_primary }};--ny-cta-primary-text:{{ section.settings.cta_primary_text }};--ny-cta-secondary:{{ section.settings.cta_secondary }};--ny-cta-secondary-text:{{ section.settings.cta_secondary_text }}">
<div class="ny-hero-main">{% render 'nichey-product-gallery', product: product, section: section %}
{% assign benefit_blocks = section.blocks | where: 'type', 'benefit' %}{% if benefit_blocks.size > 0 %}<div class="ny-hero-benefits">{% for block in benefit_blocks %}{% if block.settings.text != blank %}<div {{ block.shopify_attributes }}>{% render 'nichey-icon', settings: block.settings %}<p>{{ block.settings.text | escape }}</p></div>{% endif %}{% endfor %}</div>{% endif %}</div>
<div class="ny-purchase">{% for block in section.blocks %}{% unless block.type == 'benefit' or block.type == 'control_icon' or block.type == 'gallery_media' %}{% capture module_content %}
{% case block.type %}
{% when 'title' %}{% if block.settings.vendor %}<p class="ny-eyebrow">{{ product.vendor | escape }}</p>{% endif %}{% if block.settings.badge != blank %}<p class="ny-sale">{{ block.settings.badge | escape }}</p>{% endif %}<h1>{{ product.title | escape }}</h1>
{% when 'summary' %}{% if block.settings.text != blank %}<div class="ny-copy">{{ block.settings.text }}</div>{% else %}<div class="ny-copy">{{ product.description | strip_html | truncate: block.settings.length }}</div>{% endif %}
{% when 'rating' %}{% render 'nichey-rating', product: product, section: section %}
{% when 'price' %}{% render 'nichey-price', variant: variant, section: section %}
{% when 'purchase' %}{% render 'nichey-product-form', product: product, section: section, block: block %}{% if trust_blocks.size == 0 %}{% render 'nichey-hero-services', section: section %}{% assign services_rendered = true %}{% endif %}
{% when 'trust' %}{% unless trust_rendered %}{% assign trust_rendered = true %}{% assign trust_blocks = section.blocks | where: 'type', 'trust' %}<div class="ny-trust-grid ny-trust-cards" data-mobile-scroll="{% if section.settings.trust_scroll_m == false %}false{% else %}true{% endif %}" style="--ny-trust-bg:{{ section.settings.trust_bg | default: '#ffffff' }};--ny-trust-border:{{ section.settings.trust_border | default: '#e9e9e7' }};--ny-trust-radius:{{ section.settings.trust_radius | default: 12 }}px;--ny-trust-gap:{{ section.settings.trust_gap_d | default: 8 }}px;--ny-trust-gap-m:{{ section.settings.trust_gap_m | default: 8 }}px;--ny-trust-heading:{{ section.settings.trust_type_d | default: 13 }}px;--ny-trust-heading-m:{{ section.settings.trust_type_m | default: 12 }}px;--ny-trust-outer-bg:{{ section.settings.trust_outer_bg | default: '#fafafa' }};--ny-trust-outer-radius:{{ section.settings.trust_outer_radius | default: 26 }}px;--ny-trust-outer-padding:{{ section.settings.trust_outer_padding | default: 12 }}px;--ny-trust-border-width:{{ section.settings.trust_border_width | default: 2 }}px;--ny-trust-padding-d:{{ section.settings.trust_padding_d | default: 22 }}px;--ny-trust-padding-m:{{ section.settings.trust_padding_m | default: 18 }}px;--ny-trust-height-d:{{ section.settings.trust_height_d | default: 154 }}px;--ny-trust-height-m:{{ section.settings.trust_height_m | default: 142 }}px;--ny-trust-width-m:{{ section.settings.trust_width_m | default: 132 }}px;--ny-trust-icon-m:{{ section.settings.trust_icon_m | default: 32 }}px;--ny-trust-icon-gap:{{ section.settings.trust_icon_gap | default: 14 }}px;--ny-trust-body-size:{{ section.settings.trust_body_size | default: 12 }}px;--ny-trust-text-color:{{ section.settings.trust_text_color | default: '#191919' }};--ny-trust-body-color:{{ section.settings.trust_body_color | default: '#666666' }};--ny-trust-width-d:{{ section.settings.trust_width_d | default: 140 }}px;--ny-trust-count:{{ trust_blocks.size }}">{% for trust in trust_blocks %}{% if trust.settings.title != blank %}<div {{ trust.shopify_attributes }}>{% render 'nichey-icon', settings: trust.settings %}<h3>{{ trust.settings.title | escape }}</h3><p class="ny-muted">{{ trust.settings.text | escape }}</p></div>{% endif %}{% endfor %}</div>{% render 'nichey-hero-services', section: section %}{% assign services_rendered = true %}{% endunless %}
{% when '@app' %}{% render block %}
{% endcase %}{% endcapture %}{% assign module_visible = module_content | strip %}{% if module_visible != blank %}<div class="ny-module" style="padding-top:{{ block.settings.space_top }}px;padding-bottom:{{ block.settings.space_bottom }}px" {{ block.shopify_attributes }}>{{ module_content }}</div>{% endif %}{% endunless %}{% endfor %}{% unless services_rendered %}{% render 'nichey-hero-services', section: section %}{% endunless %}</div>
{% render 'nichey-sticky-purchase', product: product, section: section %}
</ny-product-hero>
{% elsif request.design_mode %}<p class="ny-empty">Open a product preview to configure this hero.</p>{% endif %}

