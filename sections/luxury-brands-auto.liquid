<style>
.luxury-brands {
  padding: 30px 0;
  background: #ffffff;
  overflow: hidden;
}

.brands-wrapper {
  position: relative;
  width: 100%;
  overflow-x: auto;
  white-space: nowrap;
  cursor: grab;
  -ms-overflow-style: none;
  scrollbar-width: none;
  will-change: scroll-position;
  -webkit-overflow-scrolling: touch;
  direction: ltr !important; 
}

.brands-wrapper::-webkit-scrollbar {
  display: none;
}

.brands-wrapper:active {
  cursor: grabbing;
}

.brands-track {
  display: flex;
  align-items: center;
  width: max-content;
  transform: translateZ(0); 
}

.brand-item {
  flex: 0 0 auto;
  padding: 0 30px;
  opacity: 0.55;
  transition: opacity 0.4s ease, transform 0.4s ease;
  display: block;
  user-select: none;
  -webkit-user-drag: none;
}

.brand-item img {
  height: 75px;
  width: auto;
  object-fit: contain;
  filter: grayscale(100%);
  transition: 0.4s;
  pointer-events: none;
}

.placeholder-svg {
  width: 150px;
  height: 75px;
  background-color: #f3f3f3;
  color: #ccc;
}

.brand-item:hover {
  opacity: 1;
  transform: scale(1.1);
}

.brand-item:hover img {
  filter: grayscale(0%);
}

@media(max-width: 768px){
  .brand-item {
    padding: 0 10px; 
  }
  .brand-item img {
    height: 50px;
    width: auto;
  }
}
</style>

<script src="{{ 'nichey-brands.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Luxury Brands Auto",
  "settings": [],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand Link"
        }
      ]
    } 
  ],
  "presets": [
    {
      "name": "Luxury Brands Auto"
    }
  ]
}
{% endschema %}