{% doc %}
  @prompt
    Create a responsive Shopify information section matching the references. White background, black text and heading “Better informed. More confident.”
    
    Three editable items:
    • Product details — “Check ingredients, batch code and expiry information.”
    • How to use — “Simple, clear guidance for best results.”
    • Shipping & returns — “Delivery information and easy returns.”
    
    Desktop: a thin, compact strip with the heading above three equal columns. Each item has a black outline icon on the left and a bold title with smaller description on the right. Add subtle vertical dividers between columns.
    
    Mobile: stack three full-width rows with fine horizontal separators. Each row has an outline icon on the left, title and description in the middle, and a right arrow at the far right.
    
    Use clipboard, lightbulb and delivery-truck icons. Make each item clickable through an editable link. Keep text separate from icons and allow custom icon uploads.
    
    Include controls for heading, titles, descriptions, links, icons, colors, typography, spacing and separate desktop/mobile padding. Use natural content height, compact spacing and no shadows or large empty areas. Display only information supported by the store’s actual policies.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-info-strip-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: {{ block.settings.desktop_padding }}px 0;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    
  }
  .ai-info-strip-{{ ai_gen_id }} *,
  .ai-info-strip-{{ ai_gen_id }} *::before,
  .ai-info-strip-{{ ai_gen_id }} *::after { box-sizing: border-box; }
  .ai-info-strip-{{ ai_gen_id }}__heading {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 700;
  }
  .ai-info-strip-{{ ai_gen_id }}__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .ai-info-strip-{{ ai_gen_id }}__item {
    display: flex;
    align-items: center;
    gap: {{ block.settings.item_gap }}px;
    min-width: 0;
    padding: 4px 20px;
    color: inherit;
    text-decoration: none;
  }
  .ai-info-strip-{{ ai_gen_id }}__item:first-child { padding-left: 0; }
  .ai-info-strip-{{ ai_gen_id }}__item + .ai-info-strip-{{ ai_gen_id }}__item {
    border-left: 1px solid {{ block.settings.divider_color }};
  }
  .ai-info-strip-{{ ai_gen_id }}__icon {
    flex: 0 0 {{ block.settings.icon_size }}px;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ai-info-strip-{{ ai_gen_id }}__icon svg,
  .ai-info-strip-{{ ai_gen_id }}__icon img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .ai-info-strip-{{ ai_gen_id }}__icon svg { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .ai-info-strip-{{ ai_gen_id }}__copy { min-width: 0; }
  .ai-info-strip-{{ ai_gen_id }}__title {
    display: block;
    margin: 0 0 3px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.3;
    font-weight: 700;
  }
  .ai-info-strip-{{ ai_gen_id }}__description {
    display: block;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.45;
  }
  .ai-info-strip-{{ ai_gen_id }}__arrow { display: none; }
  .ai-info-strip-{{ ai_gen_id }}__item:focus-visible { outline: 2px solid {{ block.settings.icon_color }}; outline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .ai-info-strip-{{ ai_gen_id }} { width: 100%; padding: {{ block.settings.mobile_padding }}px 0; }
    .ai-info-strip-{{ ai_gen_id }}__heading { font-size: {{ block.settings.mobile_heading_size }}px; margin-bottom: {{ block.settings.mobile_heading_spacing }}px; }
    .ai-info-strip-{{ ai_gen_id }}__items { display: block; }
    .ai-info-strip-{{ ai_gen_id }}__item,
    .ai-info-strip-{{ ai_gen_id }}__item:first-child {
      width: 100%;
      min-height: 64px;
      padding: 12px 0;
      gap: 14px;
    }
    .ai-info-strip-{{ ai_gen_id }}__item + .ai-info-strip-{{ ai_gen_id }}__item { border-left: 0; border-top: 1px solid {{ block.settings.divider_color }}; }
    .ai-info-strip-{{ ai_gen_id }}__copy { flex: 1; }
    .ai-info-strip-{{ ai_gen_id }}__arrow { display: block; flex: 0 0 18px; width: 18px; height: 18px; color: {{ block.settings.icon_color }}; }
    .ai-info-strip-{{ ai_gen_id }}__arrow svg { display: block; width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  }

  .ai-info-strip-{{ ai_gen_id }} {
    margin-inline: auto;
    padding-inline: {{ block.settings.desktop_side_padding }}px;
  }
  .ai-info-strip-{{ ai_gen_id }}__item { padding: 2px 24px; }
  .ai-info-strip-{{ ai_gen_id }}__item:last-child { padding-right: 0; }
  .ai-info-strip-{{ ai_gen_id }}__copy { flex: 1 1 auto; }
  .ai-info-strip-{{ ai_gen_id }}__description { max-width: 28ch; }
  .ai-info-strip-{{ ai_gen_id }}__icon svg { stroke-width: 1.4; }
  .ai-info-strip-{{ ai_gen_id }}__icon img { max-width: 100%; max-height: 100%; }
  @media screen and (max-width: 749px) {
    .ai-info-strip-{{ ai_gen_id }} {
      padding-inline: {{ block.settings.mobile_side_padding }}px;
    }
    .ai-info-strip-{{ ai_gen_id }}__item,
    .ai-info-strip-{{ ai_gen_id }}__item:first-child,
    .ai-info-strip-{{ ai_gen_id }}__item:last-child {
      display: grid;
      grid-template-columns: {{ block.settings.icon_size }}px minmax(0, 1fr) 16px;
      align-items: center;
      gap: {{ block.settings.item_gap }}px;
      min-height: 66px;
      padding: 10px 2px;
    }
    .ai-info-strip-{{ ai_gen_id }}__item:last-child {
      border-bottom: 1px solid {{ block.settings.divider_color }};
    }
    .ai-info-strip-{{ ai_gen_id }}__title { margin-bottom: 2px; }
    .ai-info-strip-{{ ai_gen_id }}__description { max-width: 27ch; }
    .ai-info-strip-{{ ai_gen_id }}__arrow { width: 16px; height: 16px; }
  }
{% endstyle %}

<div class="ai-info-strip-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-info-strip-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  <div class="ai-info-strip-{{ ai_gen_id }}__items">
    {% for i in (1..3) %}
      {% liquid
        assign title_key = 'item_' | append: i | append: '_title'
        assign description_key = 'item_' | append: i | append: '_description'
        assign link_key = 'item_' | append: i | append: '_link'
        assign icon_key = 'item_' | append: i | append: '_icon'
        assign title = block.settings[title_key]
        assign description = block.settings[description_key]
        assign item_link = block.settings[link_key]
        assign custom_icon = block.settings[icon_key]
      %}
      {% if item_link != blank %}<a class="ai-info-strip-{{ ai_gen_id }}__item" href="{{ item_link }}" aria-label="{{ title | escape }}">{% else %}<div class="ai-info-strip-{{ ai_gen_id }}__item">{% endif %}
        <span class="ai-info-strip-{{ ai_gen_id }}__icon" aria-hidden="true">
          {% if custom_icon != blank %}
            <img src="{{ custom_icon | image_url: width: 120 }}" alt="" loading="lazy" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}">
          {% elsif i == 1 %}
            <svg viewBox="0 0 24 24" focusable="false"><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"></path><rect x="8" y="2" width="8" height="5" rx="1.5"></rect><path d="M8 11h8M8 15h8M8 19h5"></path></svg>
          {% elsif i == 2 %}
            <svg viewBox="0 0 24 24" focusable="false"><path d="M9 18h6M10 21h4M9 16c0-1.5-3-2.5-3-6a6 6 0 0 1 12 0c0 3.5-3 4.5-3 6Z"></path><path d="M12 1v1M3.5 3.5 5 5M1 10h2M3.5 16.5 5 15M19 5l1.5-1.5M21 10h2M19 15l1.5 1.5"></path></svg>
          {% else %}
            <svg viewBox="0 0 24 24" focusable="false"><path d="M3 7V4h11v13h-3M3 13v4h2M14 8h4l4 5v4h-2M14 17h2M16 9v4h5M1 8h8M1 11h6"></path><circle cx="8" cy="17" r="2.5"></circle><circle cx="18" cy="17" r="2.5"></circle></svg>
          {% endif %}
        </span>
        <span class="ai-info-strip-{{ ai_gen_id }}__copy"><strong class="ai-info-strip-{{ ai_gen_id }}__title">{{ title | escape }}</strong><span class="ai-info-strip-{{ ai_gen_id }}__description">{{ description | escape | newline_to_br }}</span></span>
        <span class="ai-info-strip-{{ ai_gen_id }}__arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
      {% if item_link != blank %}</a>{% else %}</div>{% endif %}
    {% endfor %}
  </div>
</div>

