<div style="max-width:780px;margin:0 auto;padding:60px 20px;">
  <div style="display:flex;flex-direction:column;gap:0;">

    <div style="display:flex;gap:24px;align-items:flex-start;padding:28px 0;border-bottom:1px solid #efefef;">
      <div style="min-width:44px;width:44px;height:44px;border-radius:50%;background:#1a1a1a;color:#fff;font-size:20px;display:flex;align-items:center;justify-content:center;">📧</div>
      <div style="padding-top:8px;"><strong>Check Your Email</strong><br><span style="color:#666;font-size:14px;line-height:1.8;">Once your order is dispatched, you will receive a shipping confirmation email containing your tracking number. Check your inbox and spam folder if you can't find it.</span></div>
    </div>

    <div style="display:flex;gap:24px;align-items:flex-start;padding:28px 0;border-bottom:1px solid #efefef;">
      <div style="min-width:44px;width:44px;height:44px;border-radius:50%;background:#1a1a1a;color:#fff;font-size:20px;display:flex;align-items:center;justify-content:center;">🔍</div>
      <div style="padding-top:8px;"><strong>Use Your Tracking Number</strong><br><span style="color:#666;font-size:14px;line-height:1.8;">Copy your tracking number from the email and visit our carrier's website to monitor your delivery status in real time.</span></div>
    </div>

    <div style="display:flex;gap:24px;align-items:flex-start;padding:28px 0;border-bottom:1px solid #efefef;">
      <div style="min-width:44px;width:44px;height:44px;border-radius:50%;background:#1a1a1a;color:#fff;font-size:20px;display:flex;align-items:center;justify-content:center;">👤</div>
      <div style="padding-top:8px;"><strong>Track via Your Account</strong><br><span style="color:#666;font-size:14px;line-height:1.8;">Log in to your Nichey account and go to "My Orders" to view your order status and tracking information at any time.</span></div>
    </div>

    <div style="display:flex;gap:24px;align-items:flex-start;padding:28px 0;border-bottom:1px solid #efefef;">
      <div style="min-width:44px;width:44px;height:44px;border-radius:50%;background:#1a1a1a;color:#fff;font-size:20px;display:flex;align-items:center;justify-content:center;">⏱️</div>
      <div style="padding-top:8px;"><strong>Delivery Timeframes</strong><br><span style="color:#666;font-size:14px;line-height:1.8;">Standard shipping within the UAE takes 3–5 business days. Express shipping takes 1–2 business days. International orders arrive within 7–14 business days.</span></div>
    </div>

    <div style="display:flex;gap:24px;align-items:flex-start;padding:28px 0;border-bottom:1px solid #efefef;">
      <div style="min-width:44px;width:44px;height:44px;border-radius:50%;background:#1a1a1a;color:#fff;font-size:20px;display:flex;align-items:center;justify-content:center;">❓</div>
      <div style="padding-top:8px;"><strong>No Tracking Update?</strong><br><span style="color:#666;font-size:14px;line-height:1.8;">Tracking information may take up to 24 hours to update after dispatch. If there is no update after 48 hours, please contact us and we'll investigate immediately.</span></div>
    </div>

    <div style="display:flex;gap:24px;align-items:flex-start;padding:28px 0;">
      <div style="min-width:44px;width:44px;height:44px;border-radius:50%;background:#1a1a1a;color:#fff;font-size:20px;display:flex;align-items:center;justify-content:center;">📞</div>
      <div style="padding-top:8px;"><strong>Need Help?</strong><br><span style="color:#666;font-size:14px;line-height:1.8;">If you have any issues with your delivery, contact us at <a href="mailto:hello@nichey.store" style="color:#1a1a1a;">hello@nichey.store</a> with your order number and we'll get back to you within 24 hours.</span></div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Track Order",
  "settings": [],
  "presets": [{ "name": "Track Order" }]
}
{% endschema %}