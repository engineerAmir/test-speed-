{% assign poster = block.settings.video.preview_image | default: block.settings.image %}
{% if mode == 'thumb' %}<a class="ny-thumb" href="#NyMedia-{{ section.id }}-{{ block.id }}" data-media-id="{{ block.id }}" aria-label="{{ section.settings.view_label | escape }} {{ index }}">{% if poster != blank %}{{ poster | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 80, height: 80 }}{% else %}{% render 'nichey-control-icon', section: section, target: 'play', name: 'play' %}{% endif %}</a>
{% else %}<figure id="NyMedia-{{ section.id }}-{{ block.id }}" class="ny-slide" data-slide data-media-id="{{ block.id }}" {{ block.shopify_attributes }}>
{% if block.settings.video != blank %}{{ block.settings.video | video_tag: image_size: '900x', controls: true, preload: 'none' }}
{% elsif block.settings.external != blank %}<button class="ny-video-poster" type="button" data-play aria-label="{{ section.settings.play_label | escape }}">{% if poster != blank %}{{ poster | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}{% endif %}{% render 'nichey-control-icon', section: section, target: 'play', name: 'play' %}</button><template data-player>{% if block.settings.external.type == 'youtube' %}<iframe src="https://www.youtube-nocookie.com/embed/{{ block.settings.external.id }}?autoplay=1" title="{{ block.settings.alt | default: section.settings.play_label | escape }}" allow="autoplay; fullscreen" allowfullscreen></iframe>{% else %}<iframe src="https://player.vimeo.com/video/{{ block.settings.external.id }}?autoplay=1" title="{{ block.settings.alt | default: section.settings.play_label | escape }}" allow="autoplay; fullscreen" allowfullscreen></iframe>{% endif %}</template>
{% elsif poster != blank %}{% assign loading = 'lazy' %}{% if index == 1 %}{% assign loading = 'eager' %}{% endif %}{{ poster | image_url: width: 1600 | image_tag: loading: loading, alt: block.settings.alt, widths: '400,800,1200,1600', sizes: '(min-width:750px) 48vw, 94vw' }}<button class="ny-zoom-button" data-zoom type="button" aria-label="{{ section.settings.zoom_label | escape }}" data-src="{{ poster | image_url: width: 2200 }}">{% render 'nichey-control-icon', section: section, target: 'zoom', name: 'zoom' %}</button>{% endif %}</figure>{% endif %}
