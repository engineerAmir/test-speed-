{% assign native_media = product.media %}{% if section.settings.media_mode == 'custom' %}{% assign native_media = nil %}{% endif %}{% assign custom_media = section.blocks | where: 'type', 'gallery_media' %}{% assign total_media = native_media.size | default: 0 %}
{% capture custom_thumbs %}{% unless section.settings.media_mode == 'native' %}{% for block in custom_media %}{% if block.settings.product == blank or block.settings.product.id == product.id %}{% if block.settings.image != blank or block.settings.video != blank or block.settings.external != blank %}{% assign total_media = total_media | plus: 1 %}{% render 'nichey-gallery-custom', block: block, section: section, mode: 'thumb', index: total_media %}{% endif %}{% endif %}{% endfor %}{% endunless %}{% endcapture %}
{% assign custom_index = native_media.size | default: 0 %}{% capture custom_slides %}{% unless section.settings.media_mode == 'native' %}{% for block in custom_media %}{% if block.settings.product == blank or block.settings.product.id == product.id %}{% if block.settings.image != blank or block.settings.video != blank or block.settings.external != blank %}{% assign custom_index = custom_index | plus: 1 %}{% render 'nichey-gallery-custom', block: block, section: section, mode: 'slide', index: custom_index %}{% endif %}{% endif %}{% endfor %}{% endunless %}{% endcapture %}
{% assign selected_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media %}
<ny-gallery class="ny-gallery" aria-label="{{ section.settings.gallery_label | escape }}">
<div class="ny-thumbs">{% for media in native_media %}<a class="ny-thumb" href="#NyMedia-{{ section.id }}-{{ media.id }}" data-media-id="{{ media.id }}" aria-label="{{ section.settings.view_label | escape }} {{ forloop.index }}" {% if media.id == selected_media.id %}aria-current="true"{% endif %}>{{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', widths: '80,160', sizes: '76px' }}</a>{% endfor %}{{ custom_thumbs }}</div>
<div class="ny-stage">
{% for media in native_media %}<figure id="NyMedia-{{ section.id }}-{{ media.id }}" class="ny-slide" data-slide data-media-id="{{ media.id }}" {% if media.id == selected_media.id %}data-initial{% endif %}>
{% case media.media_type %}
{% when 'image' %}
{% if media.id == selected_media.id %}{{ media | image_url: width: 1600 | image_tag: widths: '400,600,800,1000,1200,1600', sizes: '(min-width: 1024px) 48vw, (min-width: 750px) 46vw, 94vw', loading: 'eager', fetchpriority: 'high' }}{% else %}{{ media | image_url: width: 1400 | image_tag: widths: '400,600,800,1000,1400', sizes: '(min-width: 750px) 48vw, 94vw', loading: 'lazy' }}{% endif %}
<button class="ny-zoom-button" data-zoom type="button" aria-label="{{ section.settings.zoom_label | escape }}" data-src="{{ media | image_url: width: 2200 }}">{% render 'nichey-control-icon', section: section, target: 'zoom', name: 'zoom' %}</button>
{% when 'video' %}{{ media | video_tag: image_size: '800x', controls: true, preload: 'none' }}
{% when 'external_video' %}<button class="ny-video-poster" type="button" data-play aria-label="{{ section.settings.play_label | escape }}">{{ media.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}{% render 'nichey-control-icon', section: section, target: 'play', name: 'play' %}</button><template data-player>{{ media | external_video_tag: loading: 'lazy' }}</template>
{% when 'model' %}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
{% endcase %}</figure>{% endfor %}
{{ custom_slides }}
{% if total_media > 1 %}<div class="ny-gallery-controls"><button type="button" data-prev aria-label="{{ section.settings.previous_label | escape }}">{% render 'nichey-control-icon', section: section, target: 'previous', name: 'arrow' %}</button><button type="button" data-next aria-label="{{ section.settings.next_label | escape }}">{% render 'nichey-control-icon', section: section, target: 'next', name: 'arrow' %}</button></div><span class="ny-count" aria-live="polite"><span data-count>1</span> / {{ total_media }}</span>{% endif %}
</div><dialog class="ny-zoom"><button type="button" data-close aria-label="{{ section.settings.close_label | escape }}">{% render 'nichey-control-icon', section: section, target: 'close', name: 'close' %}</button><img width="1600" height="1600" alt="" data-zoom-image></dialog>
</ny-gallery>
