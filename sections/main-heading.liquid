{{ 'hdt-main-pages.css' | asset_url | stylesheet_tag }}
{{ 'facets.css' | asset_url | stylesheet_tag }}
{{ 'hdt-widget.css' | asset_url | stylesheet_tag }}
{{ 'hdt-pagination.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign products_id = 'products-' | append: section.id

  assign col_mb = section.settings.col_mb | plus: 0
  assign col_tb = section.settings.col_tb | plus: 0
  assign col_dk = section.settings.col_dk | plus: 0

  assign current_width = settings.page_width | append: 'px'
  assign current_width_tb = '100vw'
  assign current_width_mb = '100vw'

  if section.settings.section_layout == "full_width"
    assign current_width = '100vw - 100px'
    assign current_width_tb = '100vw - 20px'
    assign current_width_mb = '100vw - 10px'
  endif

  if section.settings.section_layout == 'container'
    assign parent = 'hdt-container'
    assign child = 'hdt-section-spacing hdt-s-gradient hdt-relative hdt-section-spacing-' | append: section.id
  elsif section.settings.section_layout == 'wrapper_container'
    assign parent = 'hdt-section-spacing hdt-s-gradient hdt-relative hdt-section-spacing-' | append: section.id
    assign child = 'hdt-container'
  else
    assign parent = 'hdt-container-full hdt-section-spacing hdt-s-gradient hdt-relative hdt-section-spacing-' | append: section.id
    assign child = ''
  endif
-%}

{%- if section.settings.show_description and collection.description != blank -%}
  {%- capture collection_description -%}
    <div class="hdt-main-collection-description-wrap">
      <div class="{{ parent }}">
        <div class="{{ child }}">
          <readmore-less-wrap class="hdt-contents hdt-collection-description" hdt-reveal="slide-in" timeline>
            <div class="wrapper" wrap-content style="--max-height: {{ section.settings.read_more_height }}px;">
              <readmore-less config='{"useReadMore": {{ section.settings.use_read_more | default: false }}, "readMoreHeight": {{ section.settings.read_more_height }} }'>
                <div class="hdt-rte">
                  {{ collection.description }}
                </div>
              </readmore-less>
            </div>
            <div class="hdt-form-wrapper">
              <input type="checkbox" id="readmore-less-checkbox-{{ section.id }}" class="hdt-hidden">
              <label for="readmore-less-checkbox-{{ section.id }}" data-more="{{ 'general.read_more' | t }}" data-less="{{ 'general.read_less' | t }}"></label>
            </div>
          </readmore-less-wrap>
        </div>
      </div>
    </div>
  {%- endcapture -%}
{%- endif -%}

