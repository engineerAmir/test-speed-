<!doctype html>
{%- liquid
  assign iso_code  = request.locale.iso_code
  assign config_rtl  = settings.right_to_left | default: 'enable-with-list'
  assign is_rtl = false
  assign dir = 'ltr'
  if config_rtl == 'enable-with-list'
    assign iso_code_ck = iso_code | split: '-' | first | append: ';' | prepend: ';'
    assign lis_rtl = ';ae;ar;arc;bqi;ckb;dv;fa;glk;ha;he;kwh;ks;ku;mzn;nqo;pnb;ps;sd;ug;ur;yi;'
    if lis_rtl contains iso_code_ck
      assign is_rtl = true
      assign dir = 'rtl'
    endif
  elsif config_rtl == 'enable'
    assign is_rtl = true
    assign dir = 'rtl'
  endif
-%}

<html class="{% if request.page_type == 'index' %}hdt-homepage {% endif %}no-js hdt-pr-img__effect-{{ settings.effect_secondary_image }} hdt-badge__shape-{{ settings.badge_shape }} dir--{{ dir }}{% if request.design_mode %} shopify-design-mode{% endif %} {% if settings.minimal_products %} hdt-minimal-products{% endif %}{% if settings.hidden_badges %} hdt-hidden-pr-badges{% endif %}{% if settings.hidden_quickview %} hdt-hidden-pr-quickview{% endif %}{% if settings.hidden_wishlist %} hdt-hidden-pr-wishlist{% endif %}{% if settings.hidden_compare %} hdt-hidden-pr-compare{% endif %}{% if settings.uppercase_title %} hdt-pr-uppercase_title{% endif %}" lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
  <head>
    
<script>
  if (window.location.pathname !== window.location.pathname.toLowerCase()) {
    window.location.replace(window.location.pathname.toLowerCase() + window.location.search);
  }
</script>
