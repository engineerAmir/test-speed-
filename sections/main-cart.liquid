{%- liquid
  assign form_id = 'CartPage-Form'
  assign shipping_amount = settings.free_ship_pr.metafields.theme.shipping_money.value | default: settings.free_ship_pr.price | default: -1
  assign gift_wrap_pr = settings.gift_wrap_pr
  if gift_wrap_pr != blank and gift_wrap_pr.available
    assign gift_wrap_pr_quantity = cart | item_count_for_variant: gift_wrap_pr.selected_or_first_available_variant.id
    assign gift_wrap_pr_id = gift_wrap_pr.selected_or_first_available_variant.id
  endif

  # shipping protection
  assign protect_product = settings.protect_product
  assign protect_product_id = protect_product.selected_or_first_available_variant.id | default: protect_product.variants.first.id | default: protect_product.id | default: 'kalles-5'

  assign cart_items = cart.items
  assign has_protect_product = 0
  if protect_product_id != blank and settings.enable_shipping_protection
    assign cart_items = cart.items | reject: 'variant_id', protect_product_id
    assign has_protect_product = cart.items | where: 'variant_id', protect_product_id | size
  endif
  if has_protect_product > 0 
    assign is_protect_active = true
  endif 
  # end shipping protection
-%}
