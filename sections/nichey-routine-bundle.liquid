{% comment %}Generated schema/wrapper: scripts/build-section-schemas.mjs. Edit markup in snippets/nichey-routine.liquid.{% endcomment %}
{% capture content %}{% render 'nichey-routine', product: product, section: section %}{% endcapture %}
{% assign visible_content = content | strip %}{% if visible_content != blank %}
{{ 'nichey-page.css' | asset_url | stylesheet_tag }}
{% render 'nichey-style', section: section %}
<div id="NySection-{{ section.id }}" class="ny-section" data-motion="{{ section.settings.motion }}"><div class="ny-container">{{ content }}</div></div>
{% endif %}
