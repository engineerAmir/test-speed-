</button>

<div class="nq-overlay" id="nq-overlay-{{ section.id }}" hidden>
  <div class="nq-modal" id="nq-modal-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Skin quiz" tabindex="-1" >
    
    <div class="nq-header">
      <button type="button" class="nq-back-btn" id="nq-back-{{ section.id }}" style="visibility: hidden;">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back
      </button>
      <div class="nq-brand">Nichey.</div>
      <button type="button" class="nq-close-btn" id="nq-close-{{ section.id }}" aria-label="Close">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <div class="nq-body">
      <div class="nq-step nq-active" data-step="1">
        <span class="nq-step-subtitle">Step 1 of 4</span>
        <h2 class="nq-step-title">How does your skin usually feel a few hours after cleansing?</h2>
        <div class="nq-options">
          <button type="button" class="nq-option-btn" data-key="type" data-val="dry">Dry</button>
          <button type="button" class="nq-option-btn" data-key="type" data-val="normal">Normal</button>
          <button type="button" class="nq-option-btn" data-key="type" data-val="combo">Combination</button>
          <button type="button" class="nq-option-btn" data-key="type" data-val="oily">Oily</button>
        </div>
      </div>

      <div class="nq-step" data-step="2">
        <span class="nq-step-subtitle">Step 2 of 4</span>
        <h2 class="nq-step-title">What's your biggest skin concern?</h2>
        <div class="nq-options">
          <button type="button" class="nq-option-btn" data-key="concern" data-val="acne">Breakouts, Pimples & Clogged Pores</button>
          <button type="button" class="nq-option-btn" data-key="concern" data-val="darkspots">Dark Spots & Uneven Skin Tone</button>
          <button type="button" class="nq-option-btn" data-key="concern" data-val="redness">Redness, Irritation & Sensitivity</button>
          <button type="button" class="nq-option-btn" data-key="concern" data-val="aging">Fine Lines & Loss of Firmness</button>
          <button type="button" class="nq-option-btn" data-key="concern" data-val="dehydration">Dryness, Dehydration & Tightness</button>
          <button type="button" class="nq-option-btn" data-key="concern" data-val="dullness">Dullness & Lack of Glow</button>
        </div>
      </div>

      <div class="nq-step" data-step="3"><span class="nq-step-subtitle">Step 3 of 4</span><h2 class="nq-step-title">How old are you?</h2><div class="nq-options"><button type="button" class="nq-option-btn" data-key="age" data-val="under25">Under 25</button><button type="button" class="nq-option-btn" data-key="age" data-val="25plus">25 & Above</button></div></div><div class="nq-step" data-step="4"><span class="nq-step-subtitle">Step 4 of 4</span><h2 class="nq-step-title">Are you pregnant?</h2><div class="nq-options"><button type="button" class="nq-option-btn" data-key="pregnancy" data-val="yes">Yes</button><button type="button" class="nq-option-btn" data-key="pregnancy" data-val="no">No</button></div></div><div class="nq-step" data-step="analysis">
        <div class="nq-analysis-container">
          <h2 class="nq-step-title">Analyzing your skin profile...</h2>
          <div class="nq-analysis-loader">
            <div class="nq-analysis-progress" id="nq-progress-{{ section.id }}"></div>
          </div>
          <div class="nq-analysis-msg" id="nq-msg-{{ section.id }}">Evaluating skin characteristics...</div>
        </div>
      </div>

      <div class="nq-step" data-step="results">
        <h2 class="nq-step-title" style="margin-bottom: 24px;">Your Personalized Recommendations</h2>
        
        <div class="nq-results-summary">
          <p>Skin Type: <span id="nq-res-type-{{ section.id }}">-</span></p>
          <p>Primary Concern: <span id="nq-res-concern-{{ section.id }}">-</span></p>
<p>Age: <span id="nq-res-age-{{ section.id }}"></span></p><p>Pregnancy: <span id="nq-res-pregnancy-{{ section.id }}"></span></p></div><p class="nq-empty" id="nq-empty-{{ section.id }}" role="status" hidden></p><div class="nq-routine" id="nq-routine-container-{{ section.id }}"></div>

        

        
        
<p class="nq-cart-message" id="nq-cart-message-{{ section.id }}" role="status" aria-live="polite" hidden></p>
<a class="nq-view-cart" id="nq-view-cart-{{ section.id }}" href="{{ routes.cart_url }}" hidden>View cart</a>
<button type="button" class="nq-restart" id="nq-restart-{{ section.id }}">Retake Consultation</button>
      </div>


      {% if section.settings.enable_signup %}
      <div class="nq-step nq-signup" data-step="signup" id="nq-signup-{{ section.id }}">
        <h2 class="nq-step-title">{{ section.settings.signup_heading | escape }}</h2>
        <p>{{ section.settings.signup_text | escape }}</p>
        {% assign signup_form_id = 'nq-newsletter-' | append: section.id %}
        {% form 'customer', id: signup_form_id, class: 'nq-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,nichey-quiz">
          {% if form.posted_successfully? %}
            <p role="status" tabindex="-1" data-signup-feedback data-signup-success>Thanks for signing up! If you receive a confirmation email, please confirm your subscription.</p><button type="button" class="nq-restart" data-signup-retake>Retake Consultation</button>
          {% else %}
            {% if form.errors %}<div class="nq-signup-errors" role="alert" tabindex="-1" data-signup-feedback>{{ form.errors | default_errors }}</div>{% endif %}
            <label for="nq-signup-name-{{ section.id }}">Name</label>
            <input id="nq-signup-name-{{ section.id }}" type="text" name="contact[first_name]" autocomplete="given-name" required maxlength="100" value="{{ customer.first_name | escape }}">
            <label for="nq-signup-email-{{ section.id }}">Email</label>
            <input id="nq-signup-email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" autocorrect="off" required value="{{ form.email | default: customer.email | escape }}" aria-describedby="nq-signup-consent-{{ section.id }}">
            <label for="nq-signup-phone-{{ section.id }}">Mobile number</label>
            <input id="nq-signup-phone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel" inputmode="tel" required pattern="^\+?[0-9\s\-]{8,15}$" placeholder="01XXXXXXXXX" value="{{ form.phone | default: customer.phone | escape }}">
            <label for="nq-signup-dob-{{ section.id }}">Date of birth</label>
            <input id="nq-signup-dob-{{ section.id }}" type="date" name="nq_birthdate" autocomplete="bday" required max="{{ 'now' | date: '%Y-%m-%d' }}">
            <p id="nq-signup-consent-{{ section.id }}">By subscribing, you agree to receive marketing emails from Nichey. You can unsubscribe at any time.</p>
            <button type="submit" class="nq-cta-btn">{{ section.settings.signup_button | escape }}</button>
          {% endif %}
        {% endform %}
      </div>
      {% endif %}
    </div>
  </div>
</div>

<div hidden data-rules>
{% for block in section.blocks %}
<template data-rule data-type="{{ block.settings.type | escape }}" data-concern="{{ block.settings.concern | escape }}" data-goal="{{ block.settings.goal | escape }}" data-age="{{ block.settings.age | escape }}" data-pregnancy="{{ block.settings.pregnancy | escape }}">
{% for product in block.settings.products %}
{% assign quiz_variant = product.selected_or_first_available_variant %}
<div class="nq-product-card">
{% if product.featured_image %}<img class="nq-product-img" src="{{ product.featured_image | image_url: width: 240 }}" alt="{{ product.title | escape }}" width="80" height="80" loading="lazy">{% endif %}
<div class="nq-product-info"><h4 class="nq-product-title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h4><p class="nq-product-price">{{ product.price | money }}</p>{% unless product.available %}<span>Sold out</span>{% endunless %}</div><div class="nq-atc-form">
{% assign product_form_id = 'product-form-quiz-' | append: section.id | append: '-' | append: block.id | append: '-' | append: product.id %}
{% form 'product', product, id: product_form_id, class: 'nq-product-form', data-gift-card-recipient: false %}
<input type="hidden" name="id" value="{{ quiz_variant.id }}">
<input type="hidden" name="quantity" value="1">
<button type="submit" name="add" class="nq-cart-icon" aria-label="{% if quiz_variant.available %}Add to cart{% else %}Out of stock{% endif %}" {% unless quiz_variant.available %}disabled{% endunless %} {% if product.requires_selling_plan %}disabled{% endif %}>
{% if product.requires_selling_plan %}<span>Choose a plan</span>{% elsif quiz_variant.available %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"></path><path d="M20 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"></path><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path><path d="M12 10h4"></path><path d="M14 8v4"></path></svg>{% else %}<span>Out of stock</span>{% endif %}
</button>{% endform %}</div></div>
{% endfor %}</template>{% endfor %}</div>
<textarea hidden data-overrides>{{ section.settings.combinations_json | escape }}</textarea>
<script>(() => {
  const root = document.currentScript.closest('[data-nichey-quiz]');
  const id = root.dataset.section;
  const ar = false;
  const $ = name => root.querySelector('#nq-' + name + '-' + id);
  const overlay = $('overlay'), modal = $('modal');
  const steps = [...root.querySelectorAll('.nq-step')];
  const keys = ['type','concern','age','pregnancy'];
  let answers = {}, current = 0, generation = 0, previousFocus, oldOverflow;
  let signupPassed=false;
  const signupForm=root.querySelector('.nq-newsletter-form');
  const pendingKey='nichey-quiz-signup:' + location.pathname + ':' + id;
  function readPending() {
    try {
      const saved=JSON.parse(sessionStorage.getItem(pendingKey) || 'null');
      if(!saved || Date.now()-saved.time > 30*60*1000) { sessionStorage.removeItem(pendingKey); return null; }
      if(!keys.every(key => [...root.querySelectorAll('[data-key]')].some(button => button.dataset.key===key && button.dataset.val===saved.answers?.[key]))) return null;
      return saved.answers;
    } catch (_) { return null; }
  }
  signupForm?.addEventListener('submit', event => {
    // Normalize Egyptian mobile numbers to international format (Shopify requires E.164)
    const phoneInput = signupForm.querySelector('[name="contact[phone]"]');
    if (phoneInput) {
      let p = phoneInput.value.replace(/[\s\-()]/g, '');
      if (/^01\d{9}$/.test(p)) p = '+20' + p.slice(1);
      else if (/^20\d{10}$/.test(p)) p = '+' + p;
      phoneInput.value = p;
    }
    // Shopify has no birthdate field, so save it as a customer tag
    const dob = signupForm.querySelector('[name="nq_birthdate"]');
    const tags = signupForm.querySelector('[name="contact[tags]"]');
    if (dob?.value && tags) tags.value = 'newsletter,nichey-quiz,birthday:' + dob.value;

    // Keep only quiz selections temporarily in this tab while Shopify handles the form.
    try { sessionStorage.setItem(pendingKey,JSON.stringify({time:Date.now(),answers})); }
    catch (_) {
      event.preventDefault();
      let message=signupForm.querySelector('[data-storage-error]');
      if(!message) { message=document.createElement('p'); message.dataset.storageError=''; message.setAttribute('role','alert'); signupForm.append(message); }
      message.textContent='Please allow browser storage and try again so we can keep your recommendations.';
    }
  });
  $('routine-container').addEventListener('submit', async event => {
    const form=event.target.closest('.nq-product-form');
    if(!form) return;
    event.preventDefault();
    event.stopImmediatePropagation();
    const button=form.querySelector('button[type="submit"]');
    if(!button || button.disabled) return;
    button.disabled=true; button.setAttribute('aria-busy','true');
    const message=$('cart-message'); message.hidden=true;
    try {
      const response=await fetch(root.dataset.root.replace(/\/?$/, '/')+'cart/add.js',{method:'POST',headers:{Accept:'application/json'},body:new FormData(form)});
      const result=await response.json();
      if(!response.ok || result.status>=400) throw Error(typeof result.description==='string'?result.description:'Could not add this product. Please try again.');
      message.textContent='Product added to your cart.'; message.dataset.error='false'; $('view-cart').hidden=false;
      // Refresh the theme's cart contents without calling its drawer-open methods.
      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles:true }));
      document.dispatchEvent(new CustomEvent('cart:reload', { bubbles:true }));
    } catch(error) { message.textContent=error.message || 'Could not add this product.'; message.dataset.error='true'; }
    finally { message.hidden=false; button.disabled=false; button.removeAttribute('aria-busy'); }
  }, true);
  const rules = [...root.querySelectorAll('[data-rule]')];
  let overrides = {}, configError = false;
  try {
    overrides = JSON.parse(root.querySelector('[data-overrides]')?.value.trim() || '{}');
    if (!overrides || Array.isArray(overrides) || typeof overrides !== 'object') throw Error('Invalid configuration');
  } catch (e) { configError = true; console.error('Skin quiz: invalid combinations JSON', e); }
  function show(name) {
    steps.forEach(step => step.classList.toggle('nq-active', step.dataset.step === name));
    $('back').style.visibility = current > 0 && current < 4 ? 'visible' : 'hidden';
    root.querySelectorAll('.nq-option-btn').forEach(btn => btn.setAttribute('aria-pressed', String(answers[btn.dataset.key] === btn.dataset.val)));
    modal.scrollTop = 0;
    const heading = root.querySelector('.nq-step.nq-active h2');
    heading.tabIndex = -1;
    if (!overlay.hidden) heading.focus();
  }
  function close() {
    overlay.hidden = true;
    overlay.classList.remove('nq-active');
    document.body.style.overflow = oldOverflow || '';
    previousFocus?.focus();
  }
  $('open-quiz').addEventListener('click', () => {
    previousFocus = document.activeElement;
    oldOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    overlay.hidden = false;
    overlay.classList.add('nq-active');
    modal.focus();
  });
  $('close').addEventListener('click', close);
  overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
  overlay.addEventListener('keydown', e => {
    if (e.key === 'Escape') close();
    if (e.key !== 'Tab') return;
    const visible = [...modal.querySelectorAll('button:not([disabled]),a[href],input:not([type=hidden]):not([disabled]),select:not([disabled]),textarea:not([disabled])')].filter(el => el.getClientRects().length && getComputedStyle(el).visibility !== 'hidden');
    const first=visible[0], last=visible[visible.length-1];
    if (e.shiftKey && (document.activeElement === first || !visible.includes(document.activeElement))) { e.preventDefault(); last?.focus(); }
    else if (!e.shiftKey && (document.activeElement === last || !visible.includes(document.activeElement))) { e.preventDefault(); first?.focus(); }
  });
  $('back').addEventListener('click', () => { if(current > 0 && current < 4) { current--; show(String(current+1)); } });
  $('restart').addEventListener('click', () => { generation++; answers={}; current=0; $('routine-container').replaceChildren(); show('1'); });
  root.querySelectorAll('.nq-option-btn').forEach(btn => btn.addEventListener('click', () => {
    if (keys[current] !== btn.dataset.key) return;
    answers[btn.dataset.key] = btn.dataset.val;
    current++;
    if(current < 4) show(String(current+1));
    else if(signupForm && !signupPassed) show('signup');
    else buildResults();
  }));

  // Returns EVERY block that matches the answers ("Any" = matches all answers).
  // Order follows the block order in the theme editor.
  function findRules(key) {
    const values = key.split('|');
    return rules.filter(rule => keys.every((field, index) => {
      const value = (rule.dataset[field] || '').trim();
      if (!value || value === 'unset' || value === 'all') return true;
      return value === values[index];
    }));
  }

  async function loadProduct(handle) {
    if(typeof handle !== 'string' || !/^[a-z0-9][a-z0-9-]*$/.test(handle)) throw Error('Invalid product handle');
    const base = root.dataset.root.replace(/\/?$/, '/');
    const response = await fetch(base+'products/'+encodeURIComponent(handle)+'.js');
    if(!response.ok) throw Error('Product unavailable');
    const product = await response.json();
    const card = document.createElement('div'); card.className='nq-product-card';
    if(product.featured_image) { const img=document.createElement('img'); img.className='nq-product-img'; img.src=product.featured_image; img.alt=product.title; img.width=80; img.height=80; card.append(img); }
    const info=document.createElement('div'); info.className='nq-product-info';
    const title=document.createElement('h4'); title.className='nq-product-title';
    const link=document.createElement('a'); link.href=base+'products/'+encodeURIComponent(handle); link.textContent=product.title; title.append(link);
    const price=document.createElement('p'); price.className='nq-product-price'; price.textContent=new Intl.NumberFormat(root.dataset.locale,{style:'currency',currency:root.dataset.currency || 'EGP'}).format(product.price/100);
    info.append(title,price);
    const variant=product.variants.find(v=>v.available) || product.variants[0];
    const wrapper=document.createElement('div'); wrapper.className='nq-atc-form';
    const form=document.createElement('form'); form.method='post'; form.action=base+'cart/add'; form.className='nq-product-form';
    for(const [name,value] of Object.entries({form_type:'product',utf8:'✓',id:String(variant?.id || ''),quantity:'1'})) {const input=document.createElement('input');input.type='hidden';input.name=name;input.value=value;form.append(input);}
    const add=document.createElement('button'); add.type='submit'; add.name='add'; add.className='nq-cart-icon';
    add.disabled=!variant?.available || product.requires_selling_plan;
    add.setAttribute('aria-label',variant?.available?'Add to cart':'Out of stock');
    if(add.disabled) {const label=document.createElement('span');label.textContent=product.requires_selling_plan?'Choose a plan':'Out of stock';add.append(label);}
    else add.innerHTML="<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z\"></path><path d=\"M20 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z\"></path><path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\"></path><path d=\"M12 10h4\"></path><path d=\"M14 8v4\"></path></svg>";
    form.append(add);wrapper.append(form);
    if(!product.available) {const label=document.createElement('span');label.textContent=ar?'نفد المخزون':'Sold out';info.append(label);}
    card.append(info,wrapper); return card;
  }
  async function buildResults() {
    if(signupForm && !signupPassed) { show('signup'); return; }
    const token=++generation;
    $('cart-message').hidden=true;
    $('view-cart').hidden=true;
    show('analysis');
    $('msg').textContent=ar?'جاري البحث عن المنتجات المحددة لإجاباتك...':'Finding the products selected for your answers...';
    const container=$('routine-container'); container.replaceChildren();
    const empty=$('empty'); empty.hidden=true;
    keys.forEach(key => { const button=[...root.querySelectorAll('[data-key]')].find(b=>b.dataset.key===key && b.dataset.val===answers[key]); $('res-'+key).textContent=button?.textContent.trim() || ''; });
    const key=keys.map(k=>answers[k]).join('|');
    let failed=false;
    try {
      const matched=findRules(key);
      if(matched.length) {
        // Show every matching block; remove duplicate products across blocks.
        const seen=new Set();
        for(const rule of matched) {
          const fragment=rule.content.cloneNode(true);
          fragment.querySelectorAll('.nq-product-card').forEach(card => {
            const href=card.querySelector('.nq-product-title a')?.getAttribute('href');
            if(!href) return;
            if(seen.has(href)) card.remove(); else seen.add(href);
          });
          container.append(fragment);
        }
      } else if(!configError && Object.prototype.hasOwnProperty.call(overrides,key)) {
        const handles=overrides[key];
        if(!Array.isArray(handles)) throw Error('Expected product list');
        const cards=await Promise.all([...new Set(handles)].map(loadProduct));
        if(token!==generation || !root.isConnected)return;
        container.append(...cards);
      }
    } catch(e) { failed=true; console.error('Skin quiz: result unavailable', { combination: key, error: e }); }
    if(token!==generation || !root.isConnected)return;
    if(!container.querySelector('.nq-product-card')) {
      empty.textContent=failed?(ar?'تعذر تحميل الترشيحات. يرجى المحاولة لاحقًا.':'Recommendations could not be loaded. Please try again later.'):(ar?'لم تُحدد منتجات لهذه الإجابات بعد. تواصلي معنا للمساعدة في اختيار المنتجات.':'Products have not been selected for these answers yet. Contact us for help.');
      empty.hidden=false;
    }
    current=5; show('results');
  }
  const unload=e=>{if(e.detail.sectionId===id){generation++;if(!overlay.hidden)close();document.removeEventListener('shopify:section:unload',unload);}};
  document.addEventListener('shopify:section:unload',unload);
  root.querySelector('[data-signup-retake]')?.addEventListener('click', () => $('restart').click());
  show('1');
  const feedback=root.querySelector('[data-signup-feedback]');
  const pending=readPending();
  const returnedToSignup=location.hash === '#nq-newsletter-' + id;
  if(feedback && pending && returnedToSignup) {
    answers=pending;
    current=4;
    $('open-quiz').click();
    if(root.querySelector('[data-signup-success]')) {
      signupPassed=true;
      try { sessionStorage.removeItem(pendingKey); } catch (_) {}
      buildResults();
    } else { show('signup'); feedback.focus(); }
  }

})();
</script>
</div>
{% schema %}
{
  "name": "Nichey Skin Quiz",
  "max_blocks": 50,
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Quiz banner image",
      "info": "Clicking this image opens the quiz."
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Mobile banner image",
      "info": "Optional. If empty, your main banner image is used on mobile."
    },
    {
      "type": "paragraph",
      "content": "Choose answers and products for each block. Any matches every answer. Every block that matches the customer's answers is shown, and products are merged (duplicates removed)."
    },
    {
      "type": "textarea",
      "id": "combinations_json",
      "label": "Advanced combinations JSON",
      "info": "Optional fallback only. Used only when no combination block matches the customer's answers."
    },
    {
      "type": "header",
      "content": "Email signup"
    },
    {
      "type": "checkbox",
      "id": "enable_signup",
      "label": "Require name and email before results",
      "default": true
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Form heading",
      "default": "Your recommendations are ready"
    },
    {
      "type": "text",
      "id": "signup_text",
      "label": "Form description",
      "default": "Enter your name and email to continue to your recommendations."
    },
    {
      "type": "text",
      "id": "signup_button",
      "label": "Button text",
      "default": "Continue"
    }
  ],
  "blocks": [
    {
      "type": "combination",
      "name": "Combination & products",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Combination name"
        },
        {
          "type": "select",
          "id": "type",
          "label": "Skin feel",
          "default": "unset",
          "options": [
            {
              "value": "unset",
              "label": "Any"
            },
            {
              "value": "dry",
              "label": "Dry"
            },
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "combo",
              "label": "Combination"
            },
            {
              "value": "oily",
              "label": "Oily"
            }
          ],
          "info": "Any matches every answer to this question."
        },
        {
          "type": "select",
          "id": "concern",
          "label": "Skin concern",
          "default": "unset",
          "options": [
            {
              "value": "unset",
              "label": "Any"
            },
            {
              "value": "acne",
              "label": "Breakouts, Pimples & Clogged Pores"
            },
            {
              "value": "darkspots",
              "label": "Dark Spots & Uneven Skin Tone"
            },
            {
              "value": "redness",
              "label": "Redness, Irritation & Sensitivity"
            },
            {
              "value": "aging",
              "label": "Fine Lines & Loss of Firmness"
            },
            {
              "value": "dehydration",
              "label": "Dryness, Dehydration & Tightness"
            },
            {
              "value": "dullness",
              "label": "Dullness & Lack of Glow"
            }
          ],
          "info": "Any matches every answer to this question."
        },
        {
          "type": "select",
          "id": "goal",
          "label": "Skin goal (not asked in the quiz anymore)",
          "default": "unset",
          "options": [
            {
              "value": "unset",
              "label": "Any"
            },
            {
              "value": "clear",
              "label": "Clear Skin"
            },
            {
              "value": "bright",
              "label": "Brighter Complexion"
            },
            {
              "value": "barrier",
              "label": "Stronger Barrier"
            },
            {
              "value": "hydrate",
              "label": "Deep Hydration"
            },
            {
              "value": "glow",
              "label": "Healthy Glow"
            }
          ],
          "info": "The quiz no longer asks this question, so this setting is not used for matching anymore."
        },
        {
          "type": "select",
          "id": "age",
          "label": "Age",
          "default": "unset",
