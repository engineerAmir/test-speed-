    #shopify-section-{{ section.id }} .nichey-pagination .page,
    #shopify-section-{{ section.id }} .nichey-pagination .deco,
    #shopify-section-{{ section.id }} .nichey-pagination .dots,
    #shopify-section-{{ section.id }} .nichey-pagination .ellipsis,
    #shopify-section-{{ section.id }} .nichey-pagination .hdt-pagination__item,
    #shopify-section-{{ section.id }} .nichey-pagination .pagination__item {
      min-width: 36px !important;
      height: 36px !important;
      padding: 0 11px !important;
      border-radius: 8px !important;
      font-size: 13px !important;
      line-height: 36px !important;
    }

    #shopify-section-{{ section.id }} .nichey-pagination [aria-current="page"],
    #shopify-section-{{ section.id }} .nichey-pagination .current,
    #shopify-section-{{ section.id }} .nichey-pagination .active,
    #shopify-section-{{ section.id }} .nichey-pagination .is-active,
    #shopify-section-{{ section.id }} .nichey-pagination .hdt-current,
    #shopify-section-{{ section.id }} .nichey-pagination .hdt-pagination__item--current,
    #shopify-section-{{ section.id }} .nichey-pagination .pagination__item--current {
      min-width: 38px !important;
      height: 38px !important;
    }

    #shopify-section-{{ section.id }} .nichey-pagination a[rel="next"],
    #shopify-section-{{ section.id }} .nichey-pagination a[rel="prev"],
    #shopify-section-{{ section.id }} .nichey-pagination .next,
    #shopify-section-{{ section.id }} .nichey-pagination .prev,
    #shopify-section-{{ section.id }} .nichey-pagination .hdt-pagination__item--next,
    #shopify-section-{{ section.id }} .nichey-pagination .hdt-pagination__item--prev,
    #shopify-section-{{ section.id }} .nichey-pagination .pagination__item--next,
    #shopify-section-{{ section.id }} .nichey-pagination .pagination__item--prev {
      min-width: 70px !important;
      padding: 0 14px !important;
    }
  }

  @media (max-width: 389px) {
    #shopify-section-{{ section.id }} .nichey-collection-top {
      gap: 12px 8px !important;
    }

    #shopify-section-{{ section.id }} .nichey-sort-details {
      width: 145px !important;
      max-width: 145px !important;
    }

    #shopify-section-{{ section.id }} .nichey-sort-menu {
      width: 185px !important;
    }
  }

  @media (max-width: 1149px) {
    body.nichey-filter-is-open-{{ section.id }} {
      overflow: hidden !important;
    }

    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} {
      position: relative !important;
      z-index: 2147483647 !important;
    }

    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-collection-top,
    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-mobile-filter-btn,
    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-sort-wrap,
    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-sort-form,
    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-sort-details,
    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-collection-title {
      z-index: 0 !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }

    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-collection-layout {
      position: relative !important;
      z-index: 2147483644 !important;
    }

    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-products-area,
    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-products-grid,
    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .css-card,
    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .css-icon-btn,
    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .css-atc-form {
      z-index: 0 !important;
      pointer-events: none !important;
    }

    body.nichey-filter-is-open-{{ section.id }} #shopify-section-{{ section.id }} .nichey-filter-overlay {
      display: block !important;
      position: fixed !important;
