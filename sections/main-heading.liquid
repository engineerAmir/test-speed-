    #shopify-section-{{ section.id }} .nichey-pagination nav,
    #shopify-section-{{ section.id }} .nichey-pagination ul,
    #shopify-section-{{ section.id }} .nichey-pagination ol,
    #shopify-section-{{ section.id }} .nichey-pagination .hdt-pagination,
    #shopify-section-{{ section.id }} .nichey-pagination .hdt-pagination__list,
