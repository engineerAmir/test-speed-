{% comment %}NICHEY footer — SEO heading fix{% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} .lux-col-brand,
  #shopify-section-{{ section.id }} .lux-col-nav {
    padding-top: 0px !important; 
  }
{% endstyle %}

  <section class="lux-trust-strip" aria-label="{% if localization.language.iso_code == 'ar' %}مميزات الشراء{% else %}Shopping benefits{% endif %}">
  <div class="lux-trust-inner">

    <div class="lux-trust-item lux-trust-featured">
      <div class="lux-trust-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none">
          <path d="M24 5.5l4.7 3.1 5.6-.2 1.6 5.4 4.5 3.3-1.9 5.2 1.9 5.2-4.5 3.3-1.6 5.4-5.6-.2L24 39.2l-4.7-3.2-5.6.2-1.6-5.4-4.5-3.3 1.9-5.2-1.9-5.2 4.5-3.3 1.6-5.4 5.6.2L24 5.5Z" stroke="currentColor" stroke-width="2.25" stroke-linejoin="round"/>
          <path d="M18 24l4 4 8.2-8.8" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M24 13.5v2.2M24 32.3v2.2M14.6 22.8h-2.2M35.6 22.8h-2.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="lux-trust-copy">
        <strong>{% if localization.language.iso_code == 'ar' %}منتجات أصلية{% else %}Original Products{% endif %}</strong>
        <span>{% if localization.language.iso_code == 'ar' %}منتجات كورية أصلية{% else %}Authentic Korean products{% endif %}</span>
      </div>
    </div>

    <div class="lux-trust-item">
      <div class="lux-trust-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none">
          <path d="M10 15.5h17.5v18.5H10V15.5Z" stroke="currentColor" stroke-width="2.35" stroke-linejoin="round"/>
          <path d="M27.5 22h7.2l5.8 6.8V34H27.5V22Z" stroke="currentColor" stroke-width="2.35" stroke-linejoin="round"/>
          <path d="M15.5 36a3.4 3.4 0 1 0 6.8 0" stroke="currentColor" stroke-width="2.35" stroke-linecap="round"/>
          <path d="M32 36a3.4 3.4 0 1 0 6.8 0" stroke="currentColor" stroke-width="2.35" stroke-linecap="round"/>
          <path d="M8 21H3.5M8 27H5" stroke="currentColor" stroke-width="2.35" stroke-linecap="round"/>
          <path d="M34.7 24.8V29h4" stroke="currentColor" stroke-width="2.35" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="lux-trust-copy">
        <strong>{% if localization.language.iso_code == 'ar' %}توصيل سريع{% else %}Fast Delivery{% endif %}</strong>
        <span>{% if localization.language.iso_code == 'ar' %}داخل القاهرة خلال 48 ساعة{% else %}Within 48 hours in Cairo{% endif %}</span>
      </div>
    </div>

    <div class="lux-trust-item">
      <div class="lux-trust-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none">
          <path d="M10 16h18v19H10V16Z" stroke="currentColor" stroke-width="2.35" stroke-linejoin="round"/>
          <path d="M28 23h7l5 6v6H28V23Z" stroke="currentColor" stroke-width="2.35" stroke-linejoin="round"/>
          <path d="M15.5 36a3.3 3.3 0 1 0 6.6 0" stroke="currentColor" stroke-width="2.35" stroke-linecap="round"/>
          <path d="M32.5 36a3.3 3.3 0 1 0 6.6 0" stroke="currentColor" stroke-width="2.35" stroke-linecap="round"/>
          <path d="M14 22h10M14 28h8" stroke="currentColor" stroke-width="2.35" stroke-linecap="round"/>
          <path d="M34 25.5V29h3.5" stroke="currentColor" stroke-width="2.35" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="lux-trust-copy">
        <strong>{% if localization.language.iso_code == 'ar' %}شحن مجاني{% else %}Free Shipping Over 1500 EGP{% endif %}</strong>
        <span>{% if localization.language.iso_code == 'ar' %}شحن مجاني لمده محدوده{% else %}Free shipping for a limited time{% endif %}</span>
      </div>
    </div>

    <div class="lux-trust-item">
      <div class="lux-trust-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none">
          <path d="M8.5 14h31v20h-31V14Z" stroke="currentColor" stroke-width="2.35" stroke-linejoin="round"/>
          <path d="M8.5 20h31" stroke="currentColor" stroke-width="2.35"/>
          <path d="M14.5 29h10" stroke="currentColor" stroke-width="2.35" stroke-linecap="round"/>
          <path d="M31.5 28l2.6 2.6 5.2-5.9" stroke="currentColor" stroke-width="2.55" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="lux-trust-copy">
        <strong>{% if localization.language.iso_code == 'ar' %}دفع آمن{% else %}Secure Payments{% endif %}</strong>
        <span>{% if localization.language.iso_code == 'ar' %}دفع محمي 100%{% else %}100% protected checkout{% endif %}</span>
      </div>
    </div>

  </div>
</section>

<footer class="lux-footer">


  <div class="lux-banner">
    <canvas class="lux-petals-canvas"></canvas>
    <div class="lux-banner-left">
      <p class="lux-banner-title">{{ section.settings.banner_title | default: "Get 5% off your first order" }}</p>
      <p class="lux-banner-subtitle">{{ section.settings.banner_subtitle | default: "Enter your email and we'll send you a promo code." }}</p>

      {%- form 'customer', id: 'LuxNewsletterForm', class: 'lux-newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,footer_5_off_discount">
        <input type="hidden" name="contact[accepts_marketing]" value="true">

        <div class="lux-banner-form">
          <input
            type="email"
            name="contact[email]"
            id="LuxNewsletterEmail"
            placeholder="{{ section.settings.banner_placeholder | default: 'Enter your email' }}"
            autocomplete="email"
            required>

          <button type="submit">
            {{ section.settings.banner_btn | default: "Subscribe" }}
          </button>
        </div>

        <label class="lux-banner-consent lux-banner-consent-hidden" aria-hidden="true">
          <input
            type="checkbox"
            id="lux-consent-check"
            required
            checked
            aria-required="true"
            tabindex="-1">

          <span>
            {{ section.settings.banner_consent | default: "By clicking Subscribe I agree to the processing of my personal data." }}
            {%- if section.settings.banner_policy_url != blank -%}
              <a href="{{ section.settings.banner_policy_url }}">
                {{ section.settings.banner_policy_text | default: "Privacy Policy" }}
              </a>
            {%- endif -%}
          </span>
        </label>

        {%- if form.posted_successfully? -%}
          <p class="lux-success-msg">
            ✓ Thank you! Check your email for your 5% discount code. If you don't see it, please check your Spam or Junk folder.
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="lux-error-msg">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
      {%- endform -%}

    </div>
    <div class="lux-banner-right">
      {%- if section.settings.banner_badge != blank -%}
      <div class="lux-promo-badge">
        <span>{{ section.settings.banner_badge }}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </div>
      {%- endif -%}
      {%- if section.settings.banner_image != blank -%}
      <div class="lux-banner-img">
        {{ section.settings.banner_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: 'Promo' }}
      </div>
      {%- endif -%}
    </div>
  </div>

  <div class="lux-footer-grid">

    <div class="lux-col-brand">
      <a href="{{ routes.root_url }}" class="lux-logo-wrap">
        {%- if section.settings.footer_logo != blank -%}
          {{ section.settings.footer_logo | image_url: width: 160 | image_tag: loading: 'lazy', alt: shop.name, class: 'lux-logo' }}
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0815/5696/3547/files/Asset_4_1.png?v=1775592255" alt="{{ shop.name }}" class="lux-logo">
        {%- endif -%}
      </a>

      {%- if section.settings.footer_phone != blank -%}
      <div class="lux-contact-item">
        <a href="tel:{{ section.settings.footer_phone | remove: ' ' }}" class="lux-phone">{{ section.settings.footer_phone }}</a>
        <span class="lux-label">{% if localization.language.iso_code == 'ar' %}خط دعم العملاء{% else %}{{ section.settings.footer_phone_label | default: "customer support line" }}{% endif %}</span>
      </div>
      {%- endif -%}

      {%- if section.settings.footer_email != blank -%}
      <div class="lux-contact-item">
        <a href="mailto:{{ section.settings.footer_email }}" class="lux-email">{{ section.settings.footer_email }}</a>
        <span class="lux-label">{% if localization.language.iso_code == 'ar' %}الدعم الفني{% else %}{{ section.settings.footer_email_label | default: "technical support" }}{% endif %}</span>
      </div>
      {%- endif -%}

      {%- if section.settings.footer_office_address != blank -%}
      <div class="lux-contact-item lux-address-item">
        <div class="lux-address-title">{% if localization.language.iso_code == 'ar' %}المكتب{% else %}{{ section.settings.footer_office_label | default: "Office" }}{% endif %}</div>
        <div class="lux-address-text">{% if localization.language.iso_code == 'ar' %}١٠أ شارع الشعب متفرع من شارع الهرم - امام مبنى محافظة الجيزة - الهرم جيزة{% else %}{{ section.settings.footer_office_address }}{% endif %}</div>
      </div>
      {%- endif -%}
    </div>

    <div class="lux-col-nav lux-col-catalog">
      <span class="lux-nav-heading">{% if localization.language.iso_code == 'ar' %}الكتالوج{% else %}{{ section.settings.col1_title | default: "Catalog" }}{% endif %}</span>
      <ul>
        {%- for i in (1..10) -%}
          {%- liquid
            assign url_k = 'col1_link_' | append: i | append: '_url'
            assign txt_k = 'col1_link_' | append: i | append: '_text'
          -%}
          {%- if section.settings[txt_k] != blank -%}
          <li><a href="{{ section.settings[url_k] | default: '#' }}">{{ section.settings[txt_k] }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="lux-col-nav lux-col-about">
      <span class="lux-nav-heading">{% if localization.language.iso_code == 'ar' %}من نحن{% else %}{{ section.settings.col2_title | default: "About Us" }}{% endif %}</span>
      <ul>
        {%- for i in (1..10) -%}
          {%- liquid
            assign url_k = 'col2_link_' | append: i | append: '_url'
            assign txt_k = 'col2_link_' | append: i | append: '_text'
          -%}
          {%- if section.settings[txt_k] != blank -%}
          <li><a href="{{ section.settings[url_k] | default: '#' }}">{{ section.settings[txt_k] }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="lux-col-nav lux-col-customers">
      <span class="lux-nav-heading">{% if localization.language.iso_code == 'ar' %}العملاء{% else %}{{ section.settings.col3_title | default: "Customers" }}{% endif %}</span>
      <ul>
        {%- for i in (1..10) -%}
          {%- liquid
            assign url_k = 'col3_link_' | append: i | append: '_url'
            assign txt_k = 'col3_link_' | append: i | append: '_text'
          -%}
          {%- if section.settings[txt_k] != blank -%}
          <li><a href="{{ section.settings[url_k] | default: '#' }}">{{ section.settings[txt_k] }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="lux-col-social-legal">
      <div class="lux-socials">
        {%- if section.settings.social_instagram != blank -%}
        <a href="{{ section.settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_tiktok != blank -%}
        <a href="{{ section.settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_facebook != blank -%}
        <a href="{{ section.settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_youtube != blank -%}
        <a href="{{ section.settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_snapchat != blank -%}
        <a href="{{ section.settings.social_snapchat }}" aria-label="Snapchat" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M12.206.793c.99 0 4.347.276 5.93 3.821.529 1.193.403 3.219.299 4.847l-.003.06c-.012.18-.022.345-.03.51.075.045.203.09.401.09.3-.016.659-.120 1.033-.301.165-.088.344-.104.464-.104.182 0 .359.029.509.09.45.149.734.479.734.838.015.449-.39.839-1.213 1.168-.089.029-.209.075-.344.119-.45.135-1.139.36-1.333.81-.09.224-.061.524.120.868l.015.015c.060.136 1.526 3.475 4.791 4.014.255.044.435.270.420.509 0 .075-.015.149-.045.225-.240.569-1.273.988-3.146 1.271-.059.091-.120.375-.164.570-.029.179-.074.360-.134.553-.076.271-.270.405-.555.405h-.030c-.135 0-.313-.031-.538-.074-.360-.075-.765-.135-1.273-.135-.300 0-.599.015-.913.074-.600.104-1.123.464-1.723.884-.853.599-1.826 1.288-3.294 1.288-.060 0-.119-.015-.180-.015h-.149c-1.468 0-2.427-.675-3.279-1.288-.599-.420-1.107-.779-1.707-.884-.314-.045-.629-.074-.928-.074-.540 0-.958.089-1.272.149-.211.043-.391.074-.540.074-.374 0-.523-.224-.583-.420-.061-.192-.090-.389-.135-.567-.046-.181-.105-.494-.166-.570-1.918-.222-2.950-.642-3.189-1.226-.031-.063-.052-.150-.055-.225-.015-.243.165-.465.420-.509 3.264-.540 4.730-3.879 4.791-4.020l.016-.029c.180-.345.224-.645.119-.869-.195-.434-.884-.658-1.332-.809-.121-.029-.240-.074-.346-.119-1.107-.435-1.257-.930-1.197-1.273.090-.479.674-.793 1.168-.793.146 0 .270.029.383.074.420.194.789.300 1.104.300.234 0 .384-.060.465-.105l-.046-.569c-.098-1.626-.229-3.652.307-4.837C7.392 1.077 10.739.807 11.727.807l.419-.015h.060z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_whatsapp != blank -%}
<a href="https://wa.me/{{ section.settings.social_whatsapp | remove: '+' | remove: ' ' }}" aria-label="WhatsApp" target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.014 0C5.377 0 0 5.377 0 12.014c0 2.121.554 4.187 1.606 6.011L0 24l6.14-1.611a11.983 11.983 0 0 0 5.874 1.499h.005c6.637 0 12.014-5.377 12.014-12.014C24.033 5.377 18.656 0 12.014 0zm0 21.93a9.884 9.884 0 0 1-5.043-1.383l-.362-.215-3.746.983.999-3.653-.236-.375a9.888 9.888 0 0 1-1.513-5.273c0-5.469 4.451-9.92 9.921-9.92 2.65 0 5.14 1.033 7.014 2.908a9.85 9.85 0 0 1 2.906 7.017c0 5.469-4.451 9.911-9.94 9.911z"/></svg>
</a>
{%- endif -%}
      </div>
      <div class="lux-legal">
        {%- if section.settings.legal_link_1_url != blank -%}
          <a href="{{ section.settings.legal_link_1_url }}">{{ section.settings.legal_link_1_text | default: "Terms of Service" }}</a>
        {%- else -%}
          <a href="{{ shop.url }}/policies/terms-of-service">Terms of Service</a>
        {%- endif -%}
        {%- if section.settings.legal_link_2_url != blank -%}
          <a href="{{ section.settings.legal_link_2_url }}">{{ section.settings.legal_link_2_text | default: "Privacy Policy" }}</a>
        {%- else -%}
          <a href="{{ shop.url }}/policies/privacy-policy">Privacy Policy</a>
        {%- endif -%}
      </div>
    </div>

  </div>

  <div class="lux-footer-bottom">
    <p>© {{ 'now' | date: "%Y" }} {{ shop.name }}. {{ section.settings.copyright | default: "All rights reserved." }}</p>
    <div class="lux-footer-payments">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
      {%- endfor -%}
    </div>
  </div>

</footer>

<style>
.lux-banner {
  position: relative;
  background: linear-gradient(135deg, #fdf9f4 0%, #f7f2ea 50%, #f0ebe0 100%);
  border-radius: 12px; 
  padding: 40px 50px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 35px; 
  overflow: hidden;
  max-width: 1600px;
  margin-left: auto;
  margin-right: auto;
  width: 100%;
}
.lux-petals-canvas {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  border-radius: 12px;
}
